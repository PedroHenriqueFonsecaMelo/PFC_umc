INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('27', '1', '0', 'George Orwell', NULL, '1778975920604', '0', 'BOM', NULL, '9780451526342', '100.0', NULL, NULL, '', 'Animal Farm', NULL, NULL, NULL, NULL, NULL, 'Ficção');
