-- 1259 livros
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('11', '1', '0', 'J. R. R. Tolkien', '1778606758497', '1778606802203', '0', 'BOM', '["/uploads/livros/edb247d9-b51f-433f-88d8-b896c6914eeb_6EF176D0-1284-4A31-8F28-EA3479A632AB_1_105_c.jpeg"]', '9780547928227', '30.0', NULL, NULL, 'O Chamado à Aventura
A história acompanha Bilbo Bolseiro, um hobbit pacato que preza pelo conforto de sua toca no Condado. Sua vida vira de cabeça para baixo quando o mago Gandalf, o Cinzento, o recruta para uma expedição. Bilbo se junta a uma companhia de treze anões, liderada por Thorin Escudo de Carvalho, que busca recuperar o Reino de Erebor e seu tesouro das garras do dragão Smaug.

A Jornada e o Um Anel
Ao longo do caminho para a Montanha Solitária, o grupo enfrenta diversos perigos:

Trolls e Elfos: São capturados por trolls de pedra e, mais tarde, recebem auxílio de Elrond em Valfenda.

Goblins e Gollum: Nas entranhas das Montanhas Nevoentas, Bilbo se perde e encontra uma criatura estranha chamada Gollum. Após um jogo de enigmas, Bilbo escapa levando consigo um anel mágico que o torna invisível — sem saber que se trata do Um Anel de Sauron.

Floresta das Trevas: O grupo enfrenta aranhas gigantes e é aprisionado pelos Elfos da Floresta, de onde Bilbo os resgata usando sua astúcia e o anel.

O Confronto com Smaug
Ao chegarem à Montanha Solitária, Bilbo entra na câmara do tesouro e conversa com Smaug. Sua presença acaba despertando a fúria do dragão, que ataca a Cidade do Lago (Esgaroth). Smaug é finalmente derrotado por Bard, o Arqueiro, que acerta seu único ponto fraco.

A Batalha dos Cinco Exércitos
Com a morte do dragão, surge um conflito pelo tesouro entre anões, elfos e humanos. A tensão é interrompida pela chegada de um exército de orcs e lobos, forçando a união dos povos livres na Batalha dos Cinco Exércitos.

Conclusão: "Lá e de Volta Outra Vez"
Apesar da vitória, a batalha traz perdas pesadas, incluindo a de Thorin. Bilbo retorna ao Condado rico em histórias e experiência, mas transformado: ele não é mais o hobbit previsível de antes, sendo agora visto com certa desconfiança pelos seus pares, mas guardando consigo segredos que mudariam o destino da Terra Média.

Temas principais: O crescimento pessoal (amadurecimento), a superação do medo, a ganância versus a generosidade e como até o menor dos seres pode alterar o curso da história.', 'The Hobbit, Or, There and Back Again', '5', '1', NULL, NULL, NULL, NULL);
