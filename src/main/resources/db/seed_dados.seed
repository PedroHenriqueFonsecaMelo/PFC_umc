INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1007', '1', '1', 'Ace Publishing', '2025-11-30 02:24:32.594157', '2025-12-02 02:24:32.594157', '0', 'DESGASTADO', '["https://books.google.com/books/content?id=A1xczQEACAAJ&printsec=frontcover&img=1&zoom=1&source=gbs_api"]', '9781652786153', '327.29', NULL, NULL, 'Personalized sketchbook intended for Sketch, Drawing, Doodling, Painting, Writing, School, Class and Home. Good quality premium Glossy softcover. Best for crayons, colored pencils, and very light fine tip markers. Extra large size (8" x 10"). 110 high-quality White pages. Makes a great gift for artists, kids, teens who like anime/manga character or drawing in general and anyone with creative aptitude. Get it today & Unleash your creativity!', 'It''s an Anime Thing You Probably Wouldn''t Understand', NULL, NULL, '482', 'en', NULL, 'Geral');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1008', '1', '1', 'Anime and Manga Publishing', '2026-02-07 02:24:32.594157', '2026-02-12 02:24:32.594157', '0', 'DESGASTADO', '["https://books.google.com/books/content?id=Ii7-xgEACAAJ&printsec=frontcover&img=1&zoom=1&source=gbs_api"]', '9781077364042', '254.44', NULL, NULL, 'You''re a big Fan of Anime, Manga and Japanese Cartoons? Then this is the perfect notebook journal and composition notebook for your Kawaii Sketches and Drawings of your favorite Anime series on 120 sites with Dot Grid. Awesome premium cover with the Otaku Comic style design for the next Cosplay Event For Anime Fans and Manga Artists. Why don''t you take a look on our other Manga & Anime themed notebooks?', 'Anime Kawaii Journal Notebook', NULL, NULL, '449', 'en', NULL, 'Geral');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1009', '1', '1', 'Anime Publishing', '2025-08-26 02:24:32.594157', '2025-08-28 02:24:32.594157', '0', 'BOM', '["https://books.google.com/books/content?id=TLNWzQEACAAJ&printsec=frontcover&img=1&zoom=1&source=gbs_api"]', '9781082332524', '63.71', NULL, NULL, 'You are a very creative person? Then this Notebook is perfect for you. The perfect art sketch book for art students, teacher, professor or anyone else who loves mangas, comics and animes. Grab this book to capture your new ideas during the next comic convention. This book has the perfect size for writing, journaling and note taking everywhere. The perfect gift idea for birthday, Christmas or any gift giving occasion.', 'Creepy Cute Artbook', NULL, NULL, '409', 'en', NULL, 'Geral');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1010', '1', '1', 'Anime and Manga Publishing', '2025-06-29 02:24:32.594157', '2025-07-04 02:24:32.594157', '0', 'NOVO', '["https://books.google.com/books/content?id=mGsKxwEACAAJ&printsec=frontcover&img=1&zoom=1&source=gbs_api"]', '9781077360402', '309.01', NULL, NULL, 'You''re a big Fan of Anime, Manga and Japanese Cartoons? Then this is the perfect notebook journal and composition notebook for your Kawaii Sketches and Drawings of your favorite Anime series on 120 sites with Dot Grid. Awesome premium cover with the Otaku Comic style design for the next Cosplay Event For Anime Fans and Manga Artists. Why don''t you take a look on our other Manga & Anime themed notebooks?', 'Ramen Life', NULL, NULL, '169', 'en', NULL, 'Geral');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1011', '1', '1', 'Yopi LORI', '2026-02-22 02:24:32.594157', '2026-02-25 02:24:32.594157', '0', 'OTIMO', '[]', '9798524981929', '119.31', NULL, NULL, 'Are you looking for a fun gift for someone close to you?This is a perfect blank, lined notebook for men, women, and children. Great for taking down notes, reminders, and crafting to-do lists. Also a great creativity gift for decoration or for a notebook for school or office!This notebook is an excellent accessory for your desk at home or at the office.It''s the perfect travel size to fit in a laptop bag or backpack.', 'The Promised Neverland Notebook', NULL, NULL, '434', 'en', NULL, 'Geral');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1012', '1', '1', 'Phil Amara, Oliver Chin', '2026-02-04 02:24:32.594157', '2026-02-09 02:24:32.594157', '0', 'RUIM', '["https://books.google.com/books/content?id=Mw7cDwAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9781597021487', '301.65', NULL, NULL, 'Enjoy the first English children’s picture book on how Japanese animation and comics were created! Amazingly illustrated, this storybook features a bilingual Japanese translation. This is the third adventure in our series on cool inventions created in Asia. The cute red panda Dao makes history come alive by transporting the kids Emma and Ethan back in time. Together they learn how fantastic creations came to be and zip back to the future! This dynamic journey explores the evolution of Japanese animation and comic books. Published in newspapers, magazines, books, and graphic novels, comics became TV shows, movies, and games. These entertainment brought Japanese pop culture across the globe and influenced artists everywhere. This quest features 100 of your favorite characters and creators: from Osamu Tezuka’s Astro Boy and Rumiko Takahashi’s Ranma 1/2 to Hayao Miyazaki’s Studio Ghibli and Totoro. Mazinger, Speed Racer, and Doraemon are joined by Sailor Moon, Dragon Ball, and Pokémon. Mob', 'The Discovery of Anime & Manga', NULL, NULL, '435', 'en', NULL, 'Juvenile Fiction');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1013', '1', '1', 'Metaphysics Mama', '2025-08-12 02:24:32.594157', '2025-08-17 02:24:32.594157', '0', 'BOM', '["https://books.google.com/books/content?id=wx3RvAEACAAJ&printsec=frontcover&img=1&zoom=1&source=gbs_api"]', '9781725930933', '103.74', NULL, NULL, 'The Anime Manga Blank Comic Notebook: (Fun! Drawing Paper For Anime Manga)* Draw your own Anime Manga Comics.* Variety of Templates - hours of fun.* For Manga, Manhwa, Manhua, Anime & International Comics.* 100 pages of comic panel drawing paper For Anime Manga Comic Books / Cartoon Animation.* Durable cover to protect your book - [Matte-Finish].* Printed on paper perfect for fine tip pens, colored pencils and markers.* Notebook Measures 8.5" x 11" (21.59 x 27.94 cm) - Large / Big - FormatThis blank manga book for kids and adults is perfect for aspiring artists who love and enjoy making manga, comic books, anime drawings or cartoons. Art-obsessed kids and teenagers can create their own comic strips from start to finish and will love seeing their work already published in a book.The helpful templates included inside the book is the perfect blank canvas to help inspire budding artists who like to write mangas or graphic novels. 120 pages of different layouts with drawing/text boxes in di', 'Blank Manga Book', NULL, NULL, '309', 'en', NULL, 'Geral');
