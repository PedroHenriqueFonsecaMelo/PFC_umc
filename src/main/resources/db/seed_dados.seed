INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1022', '1', '1', 'Ace Publishing', '2026-05-11 02:24:32.594157', '2026-05-13 02:24:32.594157', '0', 'BOM', '["https://books.google.com/books/content?id=iuJhzQEACAAJ&printsec=frontcover&img=1&zoom=1&source=gbs_api"]', '9781652786078', '226.75', NULL, NULL, 'Personalized sketchbook intended for Sketch, Drawing, Doodling, Painting, Writing, School, Class and Home. Good quality premium Glossy softcover. Best for crayons, colored pencils, and very light fine tip markers. Extra large size (8" x 10"). 110 high-quality White pages. Makes a great gift for artists, kids, teens who like anime/manga character or drawing in general and anyone with creative aptitude. Get it today & Unleash your creativity!', 'Just a Boy Who Loves Anime', NULL, NULL, '201', 'en', NULL, 'Geral');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1023', '1', '1', 'Pubis Anime', '2026-04-27 02:24:32.594157', '2026-05-01 02:24:32.594157', '0', 'RUIM', '["https://books.google.com/books/content?id=H59XzQEACAAJ&printsec=frontcover&img=1&zoom=1&source=gbs_api"]', '9781087386843', '109.87', NULL, NULL, 'You are a book nerd or you are a passionate reader? Then this bookjournal is perfect for you. The perfect bulletjournal for teenager, kids, men or women or anyone who loves anime, manga and comic . Grab this book to capture your new ideas during the next comic convention. This book has the perfect size for writing, journaling and note taking everywhere. The perfect gift idea for birthday, Christmas or any gift giving occasion.', 'It''s an Anime Thing You Wouldn''t Understand My Manga Journal', NULL, NULL, '187', 'en', NULL, 'Geral');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1024', '1', '1', 'Roberta Malta Saldanha', '2026-05-23 02:24:32.594157', '2026-05-25 02:24:32.594157', '0', 'OTIMO', '["https://books.google.com/books/content?id=o7T1EAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788577565009', '356.26', NULL, NULL, 'O mundo gastronômico exige cada vez mais que os profissionais pesquisem, busquem estar sempre em contato com o campo e retornem às tradições culinárias locais perdidas no tempo. Ao se ouvir a recorrente expressão “do campo à mesa”, vêm ao pensamento as comidas feitas por nossos antepassados e em como o Brasil é gigante, repleto de ingredientes que não conhecemos, de pratos que nunca saboreamos e outros que não são mais encontrados. Mais uma vez, pude acompanhar a jornalista Roberta Malta Saldanha na aventura de trabalhar as receitas brasileiras neste seu novo livro, que traz muitos ingredientes inusitados e receitas novas de profissionais renomados da gastronomia regional. É muito importante estar sempre se reciclando e pesquisando, para poder trazer ao mundo editorial uma publicação que fale sobre ingredientes e tradições culinárias do Caburaí ao Chuí, por meio de uma conversa entre as regiões brasileiras, que é imensamente enriquecida por suas diversidades. "Culinária brasileira, mui', 'Culinária brasileira, muito prazer', NULL, NULL, '33', 'pt-BR', NULL, 'Cooking');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1025', '1', '1', 'Camila Pinheiro Coura, Bárbara de Sá Haiad', '2025-12-26 02:24:32.594157', '2025-12-27 02:24:32.594157', '0', 'DESGASTADO', '["https://books.google.com/books/content?id=tew4EQAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9786527044109', '295.21', NULL, NULL, '"Sabores da Terra: explorando a culinária brasileira através dos biomas e tradições", redigida por docentes e discentes de diferentes unidades da Universidade Federal do Rio de Janeiro, resulta da parceria de ações de extensão e promove a interdisciplinaridade entre as Ciências Biológicas e Gastronomia, um trabalho inédito para ambos os cursos. A obra contempla a caracterização dos biomas brasileiros, apresenta uma reflexão objetiva em torno das espécies nativas e sua interação com grupos humanos e retrata características de doze espécies, seus aspectos nutricionais e receitas culinárias de pratos principais e sobremesas. Trata-se de uma obra que permite visualizar a culinária brasileira e sua diversidade através dos biomas e suas espécies.', 'Sabores da Terra', NULL, NULL, '109', 'pt-BR', NULL, 'Cooking');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1026', '1', '1', 'Roberta Malta Saldanha', '2025-08-24 02:24:32.594157', '2025-08-26 02:24:32.594157', '0', 'BOM', '[]', '9788578815660', '341.7', NULL, NULL, 'Obra essencial para entender a culinária brasileira, este livro vai ajudar você a descobrir os nossos ingredientes mais típicos e desvendar o preparo das receitas mais tradicionais da nossa cozinha. Além disso, um time estrelado de 170 chefs, cozinheiros, confeiteiros, mixologistas e profissionais de Norte a Sul assinam as mais de 170 receitas, formando um panorama detalhado da culinária brasileira de ontem e hoje. Cada região do Brasil está divididas em seis capítulos – Bebidas; Petiscos e entradas; Pratos principais e acompanhamentos; Doces, sobremesas e outras iguarias; Receitas clássicas e Ingredientes – que trazem glossário de pratos e ingredientes, além de curiosidades pra você conhecer um pouco mais do nosso Brasil.', 'Culinária Brasileira, Muito Prazer', NULL, NULL, '484', 'pt-BR', NULL, 'Geral');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1027', '1', '1', 'Carlos Alberto Dória', '2025-11-22 02:24:32.594157', '2025-11-23 02:24:32.594157', '0', 'OTIMO', '[]', '9788565339278', '342.52', NULL, NULL, '', 'Formação da culinária brasileira', NULL, NULL, '426', 'pt-BR', NULL, 'Cooking, Brazilian');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1028', '1', '1', 'João Luiz Maximo da Silva, Jorge Luis da Hora de Jesus', '2026-02-27 02:24:32.594157', '2026-03-01 02:24:32.594157', '0', 'OTIMO', '["https://books.google.com/books/content?id=b5g8EQAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788539643271', '215.1', NULL, NULL, 'Cozinha brasileira procura entender a formação de nossa culinária, discutindo o conceito de cozinha brasileira e vasculhando como ele foi formulado por vários pensadores que buscavam uma identidade de nosso povo por intermédio da comida. O foco desse livro é entender elementos formadores de nossa cozinha a partir de ingredientes, técnicas e território. E por trás de tudo isso, temos nosso povo, afinal, comida é feita por gente: dos povos originários, que nos legaram ingredientes e técnicas, aos outros povos que chegaram no Brasil: colonizadores, escravizados e imigrantes. Nosso objetivo é compreender os diferentes tipos de influência na formação da cozinha brasileira por meio de discussões políticas e econômicas. A Série Universitária foi desenvolvida pelo Senac São Paulo com o intuito de preparar profissionais para o mercado de trabalho. Os títulos abrangem diversas áreas, abordando desde conhecimentos teóricos e práticos adequados às exigências profissionais até a formação ética e só', 'Cozinha brasileira', NULL, NULL, '136', 'pt-BR', NULL, 'Cooking');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1029', '1', '1', 'Instituto Brasil a Gosto, Ana Luiza Trajano', '2025-12-04 02:24:32.594157', '2025-12-09 02:24:32.594157', '0', 'OTIMO', '["https://books.google.com/books/content?id=_OJFDwAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788506073162', '99.82', NULL, NULL, 'As boas histórias são aquelas que carregam aromas e sabores de panelas, de lugares, de ingredientes e de momentos. São histórias assim que perpassam os cinco capítulos e as 512 receitas de Básico, quinto livro da chef Ana Luiza Trajano e primeiro do Instituto Brasil a Gosto. Um volume que faz um convite à manutenção da autêntica culinária brasileira dentro das casas. Um volume que faz uma intimação à memória afetiva para que as chamas dos fogões sejam acesas no resgate de pratos já esquecidos — e que eles voltem a sair das panelas para o cotidiano.', 'Básico', NULL, NULL, '381', 'pt-BR', NULL, 'Cooking');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1030', '1', '1', 'Thaina Schwan Karls, Camila Pinheiro Coura', '2026-03-20 02:24:32.594157', '2026-03-23 02:24:32.594157', '0', 'DESGASTADO', '[]', '9786527044093', '190.15', NULL, NULL, '', 'Sabores da terra', NULL, NULL, '334', 'pt-BR', NULL, 'Biotic communities');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1031', '1', '1', 'Mônica Rangel', '2025-09-25 02:24:32.594157', '2025-09-30 02:24:32.594157', '0', 'NOVO', '["https://books.google.com/books/content?id=96-2DwAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788539609727', '109.77', NULL, NULL, 'Gastronomia, compreendida como realização cultural, envolve questões que ultrapassam a composição e criação de um prato, embora estejam inteiramente ligadas a ele, como as práticas econômicas relacionadas à sustentabilidade. A dedicação de Mônica Rangel à sua arte levou-a, dessa forma, a batalhar pela gastronomia brasileira com o movimento Brasil à Mesa, que busca dialogar com os órgãos públicos e promover práticas socialmente sustentáveis em todos os elos da cadeia gastronômica, desde o pequeno produtor até a mesa, sem perder de vista a valorização da culinária nacional. Assim, o angu, a gordura de porco, os ensopados, a comida de tacho e de tabuleiro são verdadeiros tesouros da nossa gastronomia e atestam a miscigenação de diferentes povos que contribuíram para a formação da cozinha mineira. Uma cozinha cuja criatividade liga-se à sobrevivência, ao desbravamento, à coragem. Uma cozinha de tropeiros, de andarilhos, e também da Corte.', 'Interpretações do gosto', NULL, NULL, '314', 'pt-BR', NULL, 'Cooking');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1032', '1', '1', 'Carlos Alberto Dória', '2026-05-24 02:24:32.594157', '2026-05-27 02:24:32.594157', '0', 'OTIMO', '["https://books.google.com/books/content?id=vrg6DwAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788567362250', '369.46', NULL, NULL, 'Já conhecido por um estilo polemista e provocativo, o sociólogo Carlos Alberto Dória, autor de vários livros sobre história e cultura culinária, nesse e-Boca Livre a sua visão sobre como a culinária e a gastronomia estão misturadas no cotidiano da vida. A perspectiva do distanciamento do dia a dia permite a reflexão do leitor a partir das coisas mais simples – o consumo de leite condensado, o excesso de açúcar, a descoberta de novas sabores e ingredientes – até os rumos imaginados da "nova gastronomia brasileira" em processo de formação. Dória se debruça sobre assuntos abordados na imprensa diária, sobre os bastidores dos restaurantes mais destacados, os rumos da indústria da alimentação e os seus "escândalos" que vez por outra vêm à tona, bem como sobre hábitos arraigados de nossa cultura ou o "espanto" diante de inovações à mesa. Tudo tem o sentido de orientar o leitor que, entre uma garfada e outra, às vezes come coisas prazerosas, mas em outras indigestas para o corpo e a mente. O ', 'E-boca livre', NULL, NULL, '20', 'pt-BR', NULL, 'Cooking');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1033', '1', '1', 'Roberto Pinto', '2026-02-10 02:24:32.594157', '2026-02-14 02:24:32.594157', '0', 'DESGASTADO', '["https://books.google.com/books/content?id=i5g6DwAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788567362274', '387.75', NULL, NULL, 'Roberto Pinto traça, neste livro, um panorama da gastronomia brasileira nos últimos 40 anos. A pretexto de uma narrativa biográfica sobre mim e também dos chefs Mara Salles e Alex Atala, vai percorrendo as mudanças pelas quais passaram a cozinha brasileira desde a vinda dos franceses Claude Troisgros e Laurent Suaudeau para o Brasil, nos anos 1980. Ele conta de como o ofício de cozinheiro transformou-se ao longo dessas décadas e como os vários produtos regionais passaram a ser valorizados e a fazer parte da mesa dos badalados restaurantes de cozinha brasileira. Culto e determinado, o jornalista investiga a história entrevistando chefs e produtores artesanais. Também aponta as dificuldades de normatização dos bons produtos artesanais, o que os impede de estar legalmente presentes em muitas mesas de restaurantes e lares brasileiros. É uma leitura instigante e inspiradora, que nos remete a uma boa reflexão a respeito da nossa gastronomia.', 'Gastronomia brasileira: na linha do tempo', NULL, NULL, '478', 'pt-BR', NULL, 'Cooking');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1034', '1', '1', 'Breno de Paula Andrade Cruz, Thaina Schwan Karls', '2026-05-23 02:24:32.594157', '2026-05-28 02:24:32.594157', '0', 'BOM', '["https://books.google.com/books/content?id=v1qZEAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9786525137575', '136.45', NULL, NULL, 'A coleção ''Gastronomia: Ensino, Pesquisa e Extensão'' surgiu em 2020 com a publicação do nosso primeiro volume – que foi assinado por nós organizadores deste livro. Quando a parceria é frutífera, o retorno sempre é um resultado previsível – e é por isso que estamos aqui novamente apresentando 12 capítulos que demonstram quão ampla é a Gastronomia como área de conhecimento. Neste volume abrimos mão de organizar os textos a partir das dimensões Ensino, Pesquisa ou Extensão. Mas como essa divisão está intrinsecamente ligada às nossas percepções de mundo em relação à produção acadêmica, temos oito capítulos relacionados à Pesquisa, um ao Ensino e três à Extensão. Os temas são variados e abarcam a pluralidade da Gastronomia a partir desses três pilares da universidade pública. Te convidamos a desfrutar dessa leitura a partir da compreensão da Gastronomia como um campo de conhecimento.', 'Gastronomia', NULL, NULL, '10', 'pt-BR', NULL, 'Cooking');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1035', '1', '1', 'Marcia Zoladz', '2026-02-14 02:24:32.594157', '2026-02-19 02:24:32.594157', '0', 'RUIM', '["https://books.google.com/books/content?id=-DSNDAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9781442252325', '288.06', NULL, NULL, 'From fish soup to caipirinha, the culinary traditions of Rio de Janeiro come alive in this rich and sumptuous tour of its people and the foods they cook, eat, love, and enjoy. In the last four centuries of its history, the inhabitants of Rio de Janeiro created a lifestyle that is unique and has been much admired since the very first travelers published their impressions in the sixteenth century. Indeed, this international hot spot welcomes approximately 1.8 million tourists every year who come to the city to visit, to work, to study, and to eat. It was and it is a place of cultural and artistic creativity, and it has largely kept concealed one of its most interesting cultural traits: its food. Rio de Janeiro: A Food Biography unveils the high quality and variety of Rio’s fresh produce, the special dishes served in parties or at home, and the very traditional ones inherited from the immigrants who made the culture of the city as varied as its food. Starting with a history of the city an', 'Rio de Janeiro', NULL, NULL, '292', 'en', NULL, 'Cooking');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1036', '1', '1', 'Luís da Câmara Cascudo', '2026-02-18 02:24:32.594157', '2026-02-23 02:24:32.594157', '0', 'NOVO', '[]', '9788526007123', '94.36', NULL, NULL, 'Apresenta estudo sociológico da alimentação no Brasil, com base histórica e etnográfica. Aborda as influências portuguesa, indígena e africana na culinária brasileira.', 'História da alimentação no Brasil', NULL, NULL, '309', 'pt-BR', NULL, 'Cookery, Brazilian');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1037', '1', '1', 'Raul Lody', '2025-08-23 02:24:32.594157', '2025-08-26 02:24:32.594157', '0', 'NOVO', '["https://books.google.com/books/content?id=gDjnDwAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788539629688', '173.46', NULL, NULL, 'O Brasil é o país fora do continente africano que reúne a maior afrodescendência do mundo. Esse tão rico patrimônio se manifesta no português que falamos, na cultura material de objetos que usamos, nas tradições religiosas e na fé que expressamos; na música, na dança, no teatro; nos pratos que fazem parte dos nossos hábitos alimentares. Bem temperado com história e gastronomia, este livro possibilita um amplo conhecimento sobre as diferentes maneiras de comer do continente africano, marcadas pelas escolhas de ingredientes que identificam povos e civilizações. São apresentadas receitas doces e salgadas do norte da África – Magrebe –, da África ocidental, da África atlântica-austral e da África oriental. "Áfricas" que são grandes matrizes da nossa cozinha. Com um texto saboroso apoiado por belas imagens, esta publicação do Senac São Paulo faz o leitor vivenciar paladares que refletem séculos de cultura.', 'Kitutu', NULL, NULL, '221', 'pt-BR', NULL, 'Cooking');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1038', '1', '1', 'Instituto Brasil A Gosto, Ana Luiza Trajano', '2026-03-26 02:24:32.594157', '2026-03-28 02:24:32.594157', '0', 'OTIMO', '[]', '9788506002155', '248.86', NULL, NULL, 'Básico, o novo livro de Ana Trajano apresenta a cozinha brasileira viva em várias versões. São 512 receitas, resultantes dos dezenove anos de andanças pelo nosso país e de muitas pesquisas da autora sobre a nossa culinária de raiz. Ele começa com um Tira-gosto, capítulo de petiscos que dá boas-vindas ao leitor da mesma maneira que recebemos nossos amigos em casa. Depois vêm os pratos principais, Mistura, seguidos pelos acompanhamentos que ajudam dar Sustância ao prato. Em seguida, as Sobremesas que revela a Fartura da doçaria brasileira e por fim, os Pães e Quitandas que acompanham nosso tradicional cafezinho. O livro revela toda a diversidade gastronômica brasileira com belíssimas fotos de encher os olhos. A obra convida a todos a manter e a resgatar a autoestima de nossa cozinha e incentivar a presença dessa cozinha cada vez mais nos cursos, pesquisas e bibliografias, torcendo para que ingredientes como azeite de dendê, manteiga de garrafa e boas farinhas de mandioca, entre outros, a', 'Básico - Enciclopédia De Receitas Do Brasil', NULL, NULL, '16', 'en', NULL, 'Geral');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1039', '1', '1', 'Alice Santiago, Glória Feitosa', '2026-03-14 02:24:32.594157', '2026-03-18 02:24:32.594157', '0', 'RUIM', '["https://books.google.com/books/content?id=4Wv8EAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788539646425', '95.81', NULL, NULL, 'Entre os muitos encantos da Bahia, a culinária é um baluarte da cultura desse estado. Celebrada na música, na literatura e nas manifestações religiosas, a comida baiana chega a ser tão famosa quanto as belas paisagens da região. Comida é sinônimo de afeto e de memória, e anda de mãos dadas com a identidade cultural. Ciente do significado e da importância do turismo e da culinária dessa região para o Brasil, o Senac Bahia inaugurou, em 1974, o Centro de Educação Profissional em Hotelaria e Turismo – o Senac Pelourinho – em Salvador. Localizado no coração de um dos mais famosos pontos turísticos do Brasil e do mundo, o Senac Pelourinho abriga desde a sua inauguração o Restaurante-Escola, hoje parte do Museu da Gastronomia Baiana, criado em 2006. Outros espaços também integram o museu, como a cafeteria Café & Chocolate e a Galeria Nelson Daiha. As mais de 70 receitas reunidas neste livro são um registro importante tanto da gastronomia baiana quanto do trabalho de ensino e preservação da m', 'A culinária baiana no restaurante do Senac Pelourinho', NULL, NULL, '470', 'en', NULL, 'Cooking');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1040', '1', '1', 'Francisco Lellis, André Boccato', '2025-11-26 02:24:32.594157', '2025-11-30 02:24:32.594157', '0', 'DESGASTADO', '[]', '9788539604234', '150.07', NULL, NULL, '', 'Os banquetes do imperador', NULL, NULL, '86', 'pt-BR', NULL, 'Cooking, Brazilian');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1041', '1', '1', 'Oliveira', '2025-12-18 02:24:32.594157', '2025-12-20 02:24:32.594157', '0', 'OTIMO', '["https://books.google.com/books/content?id=xBisDwAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788539609574', '268.04', NULL, NULL, 'Em vez de um item fresco e perecível, um ingrediente enlatado. No lugar de um caderno manuscrito, o rótulo da lata com a receita. Em vez da tigela e da espátula, uma batedeira elétrica. No lugar do fogão a lenha, o forno a gás. Dos cadernos de receitas às receitas de latinha reconstitui uma história da alimentação que se mescla com a história da urbanização no Brasil, quando os eletrodomésticos e produtos industrializados são incorporados à cozinha, modificando receitas e reconfigurando hábitos. A narrativa se concentra na clássica doçaria nacional, revelando ao leitor como eram feitos ícones como o quindim, o bolo de fubá e o arroz-doce. Além disso, detalha a evolução que transformou o ato de cozinhar ao longo do tempo revelando, por exemplo, por que lidar com as panelas é tão bem-aceito e reconhecido atualmente, se há algumas décadas as mulheres estudadas se orgulhavam de sequer saber fritar um ovo, e por que os projetos arquitetônicos mais recentes valorizam a cozinha integrada às á', 'Dos cadernos de receitas às receitas de latinha', NULL, NULL, '455', 'pt-BR', NULL, 'Cooking');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1042', '1', '1', 'Manuel Raimundo Querino', '2026-01-23 02:24:32.594157', '2026-01-25 02:24:32.594157', '0', 'BOM', '["https://books.google.com/books/content?id=0SOlBAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788490014523', '119.98', NULL, NULL, '', 'A arte culinária na Bahia', NULL, NULL, '219', 'pt-BR', NULL, 'Cooking');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1043', '1', '1', 'Luís da Câmara Cascudo', '2025-11-14 02:24:32.594157', '2025-11-19 02:24:32.594157', '0', 'DESGASTADO', '["https://books.google.com/books/content?id=XgEtBgAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788526018211', '297.52', NULL, NULL, 'Câmara Cascudo reuniu nesta obra estudos e histórias saborosas da vida do brasileiro: da introdução do sorvete, ao cotidiano de bares e cozinhas de negros e brancos, baianos e mineiros. Uma vez que a cultura brasileira também foi construída pelos alimentos, esta antologia conclui o que o autor pesquisou sobre alimentação no Brasil. A cultura brasileira se desenvolveu sobre muitas bases, e uma delas é inegável: os sabores e cheiros que vêm da cozinha. É esse o ambiente da casa que desperta grande parte da memória afetiva de todos nós. É nesse pequeno espaço que aprendemos os primeiros prazeres, que desenvolvemos as primeiras regras de sociabilidade. É ali que mais nos reconhecemos como brasileiros. Esta é uma reedição da coletânea de artigos, depoimentos e textos históricos dos séculos XVII a XX, reunidos por Luís da Câmara Cascudo na década de 1970. Em Antologia da alimentação no Brasil, conhecemos histórias saborosas da vida cotidiana brasileira: da introdução do sorvete no Brasil ao ', 'Antologia da Alimentação no Brasil', NULL, NULL, '149', 'pt-BR', NULL, 'Social Science');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1044', '1', '1', 'CARLOS ALBERTO DORIA', '2026-02-21 02:24:32.594157', '2026-02-26 02:24:32.594157', '0', 'DESGASTADO', '[]', '9788567362113', '375.25', NULL, NULL, 'Já conhecido por um estilo polemista e provocativo, o sociólogo Carlos Alberto Dória, autor de vários livros sobre história e cultura culinária, nesse e-Boca Livre a sua visão sobre como a culinária e a gastronomia estão misturadas no cotidiano da vida. A perspectiva do distanciamento do dia a dia permite a reflexão do leitor a partir das coisas mais simples – o consumo de leite condensado, o excesso de açúcar, a descoberta de novas sabores e ingredientes – até os rumos imaginados da nova gastronomia brasileira em processo de formação. Dória se debruça sobre assuntos abordados na imprensa diária, sobre os bastidores dos restaurantes mais destacados, os rumos da indústria da alimentação e os seus escândalos que vez por outra vêm à tona, bem como sobre hábitos arraigados de nossa cultura ou o espanto diante de inovações à mesa. Tudo tem o sentido de orientar o leitor que, entre uma garfada e outra, às vezes come coisas prazerosas, mas em outras indigestas para o corpo e a mente. O sentid', 'E-BOCA LIVRE', NULL, NULL, '277', 'pt-BR', NULL, 'Geral');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1045', '1', '1', 'Rita Lobo', '2025-07-26 02:24:32.594157', '2025-07-28 02:24:32.594157', '0', 'DESGASTADO', '["https://books.google.com/books/content?id=QAuQDwAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788539624546', '103.71', NULL, NULL, 'Se o casal decidiu cozinhar, já deu o passo mais importante para manter uma alimentação saudável. Rita Lobo apresenta receitas para jantares rápidos e também ensina a planejar o almoço do dia a dia (pê-efe), a marmita para levar para o trabalho, o brunch para receber os familiares e ideias de happy hour para os amigos. E todos os cardápios vêm com plano de ataque – um guia com instruções detalhadas para que cada refeição seja preparada a quatro mãos, em menos tempo e sem pesar para ninguém. Você vai encontrar dicas para elaborar a lista de compras, orientações para armazenar os alimentos e escolher utensílios e muitos truques para economizar. Cozinhar vai virar programa a dois!', 'Cozinha a quatro mãos', NULL, NULL, '42', 'pt-BR', NULL, 'Cooking');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1046', '1', '1', 'Pedro Rodrigues de Albuquerque Cavalcanti', '2026-02-02 02:24:32.594157', '2026-02-06 02:24:32.594157', '0', 'NOVO', '[]', '9788573596304', '156.52', NULL, NULL, '', 'A pátria nas panelas', NULL, NULL, '377', 'es', NULL, 'Cooking');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1047', '1', '1', 'Regina Helena de Paiva Ramos', '2026-02-27 02:24:32.594157', '2026-03-02 02:24:32.594157', '0', 'OTIMO', '["https://books.google.com/books/content?id=nBsjDwfZsL4C&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788506062258', '61.42', NULL, NULL, 'A verdadeira comida paulista vem das antigas fazendas e das vilas. São sopas nutritivas, carnes típicas como o Pernil ao forno, o Bife de caçarola, a Vaca atolada, combinações perfeitas como o Virado à paulista, muitas aves e peixes. Há também acompanhamentos variados, doces tradicionais e muitas sobremesas, assim como as quitandas típicas da São Paulo antiga. Nesse livro, você encontrará os pratos mais tradicionais dessa arte culinária. Todas as receitas são explicadas passo-a-passo e têm lista detalhada de ingredientes, tempo de preparo e indicação de rendimento, sugestões e observações interessantes, além de fotos coloridas e ilustrações que complementam essa festa de sabores superbrasileiros.', 'A cozinha paulista', NULL, NULL, '305', 'pt-BR', NULL, 'Cooking');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1048', '1', '1', 'Beatriz Afonso Castro', '2025-08-08 02:24:32.594157', '2025-08-13 02:24:32.594157', '0', 'NOVO', '[]', '9788561573157', '332.89', NULL, NULL, '', 'A história da gastronomia brasileira', NULL, NULL, '174', 'en', NULL, 'Cooking');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1049', '1', '1', 'Claude Troisgros', '2026-04-14 02:24:32.594157', '2026-04-17 02:24:32.594157', '0', 'BOM', '["https://books.google.com/books/content?id=mOe4BwAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788525060747', '53.8', NULL, NULL, 'O primeiro livro do chef francês Claude Troisgros da Globo Estilo em parceria com o canal de TV a cabo GNT. Quem já não se viu às voltas com um arroz empapado ou titubeou na hora de limpar o alho-poró? Quem já quis preparar um jantar romântico e na hora H precisou recorrer a um delivery porque a comida ficou simplesmente intragável? Para evitar desastres como esses, ou esclarecer dúvidas simples como a melhor maneira de manipular alimentos, basta abrir e folhear As melhores receitas do Que Marravilha!. O programa homônimo que vai ao ar desde 2010 pelo GNT toda quinta-feira, às 22h, e já está em sua quinta temporada, é a base do livro, que traz receitas preparadas pelo chef. No Que Marravilha!, Claude ensina os participantes a fazer maravilhosos pratos – que eles depois reproduzem em suas casas para avaliação do chef e de convidados. Por vezes, Claude prepara receitas especiais e chama convidados famosos para acompanhá-lo, como o guitarrista dos Titãs Tony Bellotto, as atrizes Camila Pi', 'As melhores receitas do Que Marravilha!', NULL, NULL, '414', 'pt-BR', NULL, 'Cooking');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1050', '1', '1', 'Rodrigo Hilbert', '2025-09-12 02:24:32.594157', '2025-09-15 02:24:32.594157', '0', 'NOVO', '["https://books.google.com/books/content?id=Y6TmCgAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788525060730', '200.0', NULL, NULL, 'Comida para alegrar a alma Rodrigo Hilbert transporta para seu livro a mesma irreverência com que apresenta o programa Tempero de Família, no canal GNT. As 49 deliciosas receitas desse catarinense vêm embaladas pela filosofia de que é possível chegar à chamada comfort food com ingredientes sem sofisticação, fáceis de encontrar em bons supermercados. Sua marca registrada é mesclar simplicidade no preparo das iguarias e descontração na hora de contar casos divertidos relacionados às receitas. O resultado é uma comida para alegrar a alma. As receitas têm mais que sabores, têm ligações emocionais com a infância, o jeito de cozinhar da mãe, as histórias de família que beiravam o fogão. Rodrigo Hilbert transporta para seu livro, com quarenta e nove receitas e várias fotos incríveis para ensinar a fazer um delicioso salame caseiro ou um bolo de aipim que sua avó servia no café da tarde, a mesma irreverência com que apresenta o programa Tempero de Família, no canal GNT, toda quinta, às 20h. Su', 'As deliciosas receitas do Tempero de Família', NULL, NULL, '65', 'pt-BR', NULL, 'Cooking');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1051', '1', '1', 'Bruna Trevisani', '2025-11-18 02:24:32.594157', '2025-11-21 02:24:32.594157', '0', 'NOVO', '["https://books.google.com/books/content?id=dZVWAO8HVUcC&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788506062241', '336.32', NULL, NULL, 'Uma refeição genuinamente amazônica pode ser composta por Salada verde com pupunha, Caldeirada de tambaqui com Arroz de jambu e, para terminar, um delicioso Pudim de açaí. A riqueza desta mesa vem dos rios, dos frutos, dos vegetais, de várias farinhas, além dos temperos e ervas aromáticas típicos — hoje facilmente encontrados nos mercados. Bruna Trevisani tratou de tornar esse delicioso cardápio possível para você repetir em casa e sem dificuldade. Nesse livro, você encontrará os pratos mais tradicionais dessa arte culinária. Todas as receitas são explicadas passo-a-passo e têm lista detalhada de ingredientes, tempo de preparo e indicação de rendimento, sugestões e observações interessantes, além de fotos coloridas e ilustrações que complementam essa festa de sabores superbrasileiros.', 'A cozinha amazônica', NULL, NULL, '119', 'pt-BR', NULL, 'Cooking');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1052', '1', '1', 'Rusty Marcellini, Rodrigo Ferraz', '2025-06-09 02:24:32.594157', '2025-06-12 02:24:32.594157', '0', 'DESGASTADO', '["https://books.google.com/books/content?id=77J5DwAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788506084953', '204.89', NULL, NULL, 'O projeto de formar uma equipe para viajar pelo território brasileiro em busca das nossas riquezas gastronômicas foi concebido pelo empresário Rodrigo Ferraz em 2011. Nos dois anos seguintes, com o nome Expedição Brasil Gastronômico, profissionais de diferentes áreas pesquisaram, registraram e divulgaram a cadeia produtiva gastronômica em 12 estados. Em 2014, a expedição comandada pelo pesquisador Rusty Marcellini passou a se chamar Expedição Fartura Gastronomia e a fazer parte do projeto Fartura, cujo nome é uma referência à diversidade e às riquezas culinárias de nosso país. Seu objetivo é a promoção e o desenvolvimento da gastronomia nacional, reunindo e integrando produtos, produtores, chefs, indústria, mercados e apreciadores da boa mesa. Todo o conteúdo coletado nas viagens serve como base para a realização de eventos — como o Festival de Gastronomia de Tiradentes e o Fartura BH —, e é divulgado através de livros, documentários, redes sociais e programas de rádio. Neste décimo vo', 'Fartura', NULL, NULL, '220', 'pt-BR', NULL, 'Cooking');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1053', '1', '1', 'Regina Helena de Paiva Ramos', '2026-05-11 02:24:32.594157', '2026-05-12 02:24:32.594157', '0', 'DESGASTADO', '["https://books.google.com/books/content?id=Ua3W5sQQj_4C&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788506062265', '270.9', NULL, NULL, 'Ao contrário do que se pensa, Minas Gerais não é apenas a terra do pão de queijo. Tem também seu Cuscuz típico, Regalos de fubá, Galinha com quiabo, a Leitoa pururuca, Canjiquinha com costela, peixes de forno e fogão — sem falar nos doces, bolos, tortas e compotas imbatíveis. Este livro oferece sugestões que foram pesquisadas em livros antigos e cadernos de receitas de tradicionais cozinheiras da região, para que possamos recriar em casa o melhor do sabor mineiro. Nesse livro, você encontrará os pratos mais tradicionais dessa arte culinária. Todas as receitas são explicadas passo-a-passo e têm lista detalhada de ingredientes, tempo de preparo e indicação de rendimento, sugestões e observações interessantes, além de fotos coloridas e ilustrações que complementam essa festa de sabores superbrasileiros.', 'A cozinha mineira', NULL, NULL, '80', 'pt-BR', NULL, 'Cooking');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1054', '1', '1', 'Carol Thomé, Duca Mendes', '2025-07-04 02:24:32.594157', '2025-07-09 02:24:32.594157', '0', 'OTIMO', '["https://books.google.com/books/content?id=glzGAwAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788581741758', '68.33', NULL, NULL, 'Uma das coisas mais gostosas da nossa "vida de casal" é comer juntos. Enquanto a gente almoça, pensa no que vai comer no jantar. Quando eu e o Duca fomos morar juntos e descobri que ele não sabia fazer absolutamente nada na cozinha, pensei: estamos lascados. Do meu pai, eu herdei o prazer de comer. Da minha mãe, a preguiça de fazer comida... O Cozinha para 2 é um retrato do nosso cotidiano: temos vontade de comer coisas boas mas não temos paciência para preparar receitas complicadas. Quando conheci o Duca, eu sabia que tinha encontrado o melhor namorado, amigo e parceiro de garfo. Embora a gente tenha relações totalmente diferentes com a comida, isso nunca nos atrapalhou. Comer para ele é uma necessidade. Para mim é afeto. Ele come para sobreviver. Eu como por prazer. Ele prefere doces. Eu prefiro salgados. Por isso as receitas deste livro vão muito além da comida para nós. Por trás de cada prato que apresentamos aqui há uma história para contar. Em cada mordida há um beijo apaixonado.', 'Cozinha para 2', NULL, NULL, '112', 'pt-BR', NULL, 'Cooking');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1055', '1', '1', 'Dolores Freixa', '2026-03-24 02:24:32.594157', '2026-03-25 02:24:32.594157', '0', 'BOM', '["https://books.google.com/books/content?id=sP_T0AEACAAJ&printsec=frontcover&img=1&zoom=1&source=gbs_api"]', '9786555362978', '134.36', NULL, NULL, 'A gastronomia faz parte do patrimônio de um povo é tão importante culturalmente quanto as festas, as danças, o folclore, os cultos religiosos. As especialistas Dolores Freixa e Guta Chaves atualizaram a nova edição desta obra, ampliando especialmente as questões relativas à globalização. Contam a história dos hábitos alimentares de diferentes grupos sociais, tanto do Ocidente quanto do Oriente, dessa a pré-história até o século XXI. O Brasil ganha destaque nos capítulos em que elas examinam a alimentação de nossos antepassados indígenas, as heranças portuguesa e africana e as influências mais recentes. Abordam ainda aspectos da culinária profissional, como a formação dos grandes chefs e da mais recente geração.', 'Gastronomia no Brasil e no mundo', NULL, NULL, '430', 'pt-BR', NULL, 'Cooking');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1056', '1', '1', 'Liviane Gomes Ataíde Santana', '2025-07-26 02:24:32.594157', '2025-07-30 02:24:32.594157', '0', 'OTIMO', '[]', '9786525277820', '143.32', NULL, NULL, '', 'A gastronomia brasileira oitocentista', NULL, NULL, '165', 'pt-BR', NULL, 'Cooking, Brazilian');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1057', '1', '1', 'Nina Horta', '2026-03-25 02:24:32.594157', '2026-03-29 02:24:32.594157', '0', 'NOVO', '["https://books.google.com/books/content?id=Xnf8DwAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9786557820261', '141.37', NULL, NULL, 'As receitas são a sobremesa, e o prato principal, as saborosas crônicas sobre o universo culinário, regadas com o inconfundível molho de sabedoria e simplicidade de Nina Horta. Publicado pela primeira vez em 1994, este livro reúne crônicas e receitas que Nina Horta escreveu para a Folha de S.Paulo ao longo de mais de uma década. Nina soube, como ninguém, traduzir com sabedoria e simplicidade um mundo nada gastronômico, porém real, de sabores, cheiros, reflexões e humor, com uma pitada de nonsense – ingredientes que se tornaram sua marca registrada. Com uma prosa viva, e divertida, de alguém que enfrenta os mesmos problemas dos mortais comuns ao entrar numa cozinha, Não é sopa é um clássico com um cardápio extremamente variado, para satisfazer aos mais diferentes paladares. Esta nova edição conta com comentários da autora nas margens, com um olhar de quem, anos depois da primeira publicação, sabe tudo o que mudou e – mais importante – o que permanece igual para os amantes da boa comida.', 'Não é sopa (Nova edição)', NULL, NULL, '261', 'pt-BR', NULL, 'Cooking');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1058', '1', '1', 'João Diamante, Simone Mota', '2025-07-28 02:24:32.594157', '2025-08-02 02:24:32.594157', '0', 'DESGASTADO', '[]', '9788592736910', '272.84', NULL, NULL, 'O livro reúne receitas exclusivas do Chef João Diamante com a narrativa biográfica de um dos expoentes da gastronomia brasileira.', 'Receita de diamante:', NULL, NULL, '4', 'pt-BR', NULL, 'Biography & Autobiography');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1059', '1', '1', 'Flávio Ferraz', '2026-02-16 02:24:32.594157', '2026-02-19 02:24:32.594157', '0', 'DESGASTADO', '[]', '9788582200155', '358.07', NULL, NULL, 'Nesses tempos em que os chefs modernos reconstroem ou criam receitas a cada dia, o trabalho de Flávio Ferraz dá um banho de tradição, trazendo 500 receitas - muitas delas seculares, quase todas anônimas- que resumem a memória culinária do estado do Rio de Janeiro de forma inédita e deliciosa. A obra reúne o conhecimento de muitas gerações de cozinheiros, e valoriza restaurantes e botequins que oferecem pratos clássicos, apresentados neste livro fartamente ilustrado.', 'Culinária Do Rio De Janeiro, A', NULL, NULL, '337', 'pt-BR', NULL, 'Geral');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1060', '1', '1', 'Ana Ribeiro', '2025-08-22 02:24:32.594157', '2025-08-23 02:24:32.594157', '0', 'RUIM', '[]', '9788575720233', '384.94', NULL, NULL, '', 'Gastronomia afro-brasileira', NULL, NULL, '361', 'pt-BR', NULL, 'Blacks');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1061', '1', '1', 'Caloca Fernandes, Walter Morgenthaler', '2025-06-16 02:24:32.594157', '2025-06-17 02:24:32.594157', '0', 'DESGASTADO', '[]', '9788539600991', '59.92', NULL, NULL, '', 'A CULINARIA PAULISTA TRADICIONAL', NULL, NULL, '222', 'en', NULL, 'Geral');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1062', '1', '1', 'Janaina Rueda, Rafael Tonon', '2026-03-13 02:24:32.594157', '2026-03-17 02:24:32.594157', '0', 'BOM', '[]', '9788506081136', '66.41', NULL, NULL, '', '50 restaurantes com mais de 50', NULL, NULL, '185', 'pt-BR', NULL, 'Cooking, Brazilian');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1063', '1', '1', 'Kiko Farkas', '2025-06-27 02:24:32.594157', '2025-06-30 02:24:32.594157', '0', 'NOVO', '["https://books.google.com/books/content?id=iPy0DwAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788574167145', '159.89', NULL, NULL, 'Quem disse que cozinha não é para criança? Quando somos bem orientados, não há motivo para não colocar a mão na massa! Este é um livro para o aprendiz de cozinheiro. Traz receitas, instruções e dicas básicas para aqueles quem começam a se interessar pela culinária. Bagunça na cozinha era o livro que faltava na cozinha de sua casa!', 'Bagunça na cozinha', NULL, NULL, '411', 'pt-BR', NULL, 'Juvenile Nonfiction');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1064', '1', '1', 'Raimundo de Oliveira', '2025-06-30 02:24:32.594157', '2025-07-04 02:24:32.594157', '0', 'OTIMO', '[]', '9788598694085', '121.08', NULL, NULL, 'Este livro, de Raimundo de Oliveira, é redondo como um pão-de-queijo, temperado do jeito que deve ser um bom naco de carne de porco, saboroso e estimulante como os melhores produtos que se dedicam às coisas e temperos de uma das culinárias mais marcantes deste País. Na verdade, longe de ser nostálgico, em tons de lamento, mal-humorado em relação a um passado que não volta mais, ''Coisas de Minas - a Culinária dos Velhos Cadernos'' cumpre tarefas antropológicas e de pesquisador em relação à gastronomia regional. Entre biscoitos, bolos e pães, ambrosias, compotas e geléias, as receitas chegam de forma didática com a missão de se tornar atrações nas mesas do dia-a-dia.', 'Coisas de Minas', NULL, NULL, '481', 'pt-BR', NULL, 'Cooking');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1065', '1', '1', 'Ofélia Ramos Anunciato', '2025-11-21 02:24:32.594157', '2025-11-24 02:24:32.594157', '0', 'NOVO', '[]', '9788506026243', '203.29', NULL, NULL, 'Ofélia apresenta a saborosa e variada culinária brasileira desde o doce de leite até a feijoada completa, e pratos típicos de todas as regiões do Brasil.', 'A cozinha brasileira de Ofélia :', NULL, NULL, '91', 'pt-BR', NULL, 'Cookery, Brazilian');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1066', '1', '1', 'Claudia Monteiro de Castro', '2025-09-30 02:24:32.594157', '2025-10-05 02:24:32.594157', '0', 'OTIMO', '[]', '9788575310083', '128.48', NULL, NULL, '', 'Crônicas de amor, sexo e culinária', NULL, NULL, '31', 'pt-BR', NULL, 'Cooking, Brazilian');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1067', '1', '1', 'Tim Wätzold', '2026-05-25 02:24:32.594157', '2026-05-28 02:24:32.594157', '0', 'OTIMO', '[]', '9783885590934', '229.23', NULL, NULL, '', 'Vom kaiserlichen Koch zum nationalen Koch', NULL, NULL, '180', 'de', NULL, 'Cookbooks');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1068', '1', '1', 'Neide Rigo', '2026-05-15 02:24:32.594157', '2026-05-17 02:24:32.594157', '0', 'DESGASTADO', '[]', '9788569600008', '219.97', NULL, NULL, '', 'Mesa farta no semiárido', NULL, NULL, '348', 'pt-BR', NULL, 'Arid regions');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1069', '1', '1', 'FELIPE BRONZE', '2026-04-03 02:24:32.594157', '2026-04-07 02:24:32.594157', '0', 'BOM', '[]', '9788575428719', '121.18', NULL, NULL, 'Felipe procura romper fronteiras com sua culinária, flertando com os sabores e ingredientes nativos do Brasil ao tentar elaborar pratos de uma forma inovadora. A essência da cultura brasileira deve ser totalmente intrínseca ao trabalho desse chef com treinamento europeu, senso de humor americano e alma brasileira. Sua cozinha pretende ser leve, convidativa, descomplicada e visualmente arrebatadora. O autor busca ampliar os limites da estética gastronômica criando pratos originais e refinados.', 'Felipe Bronze', NULL, NULL, '127', 'pt-BR', NULL, 'Cooking, Brazilian');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1070', '1', '1', 'JOVENTINO BARROS SANTANA.', '2025-11-01 02:24:32.594157', '2025-11-02 02:24:32.594157', '0', 'RUIM', '["https://books.google.com/books/content?id=uiuQDwAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788582162323', '388.46', NULL, NULL, '', 'CURA TRIDIMENSIONAL;SAUDE DA ALMA, DO CORPO E DO ESPIRITO', NULL, NULL, '88', 'en', NULL, 'Geral');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1071', '1', '1', 'Miroslav D. Vujicic, Azilah Kasim', '2025-07-29 02:24:32.594157', '2025-08-01 02:24:32.594157', '0', 'NOVO', '["https://books.google.com/books/content?id=UR6gEAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9783031078194', '120.48', NULL, NULL, 'This book is an assemblage of diverse yet homogenous research papers that bring together the issues and challenges of cultural heritage conservation and tourism sustainability. The richness of this book stems from its inclusion of diverse case studies from around the globe while scrutinizing the cases of both deterioration and sustainability of cultural heritage belonging to different eras. This book sheds light on the connections between culture as an essential dimension of local sustainability and cultural dimensions of sustainable tourism, further contributing to the complex discussion between culture and tourism. This book gives an overview of current research and subjects of discussion that focuses on cultural sustainable tourism through several sections, such as planning and management of sustainable tourism, sustainable cultural tourism development in a digital era, social and economic impacts of cultural tourism, and sustainable tourism development in urban areas', 'Cultural Sustainable Tourism', NULL, NULL, '57', 'en', NULL, 'Science');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1072', '1', '1', 'Carolina Rebellato, Margareth Cristina de Almeida Gomes', '2025-09-10 02:24:32.594157', '2025-09-12 02:24:32.594157', '0', 'NOVO', '["https://books.google.com/books/content?id=ZuVZEAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788592908126', '282.6', NULL, NULL, '"The aim of the following collection of texts is to prompt a greater awareness of the rights and needs of older LGBTI+ adults and other underserved communities. It is intended to be an educational tool for health professionals in particular. The expectation is that it will be the starting point for an ongoing digital forum where the conversation can continue and new perspectives, research and best practices can be added. Enjoy the reading." Alexandre Kalache', 'Introduction to the diversity of LGBTI+ ageing', NULL, NULL, '489', 'en', NULL, 'Social Science');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1073', '1', '1', 'Rodrigo Lopes de Barros', '2026-03-05 02:24:32.594157', '2026-03-06 02:24:32.594157', '0', 'RUIM', '["https://books.google.com/books/content?id=4gSVEAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9781800855687', '124.32', NULL, NULL, 'An Open Access edition of this book will be available on the Liverpool University Press website and the OAPEN library. At the turn of the 21st century, the Brazilian punk and hardcore music scene joined forces with political militants to foster a new social movement that demanded the universal right to free public transportation. These groups collaborated in numerous venues and media: music shows, protests, festivals, conferences, radio stations, posters, albums, slogans, and digital and printed publications. Throughout this time, the single demand for free public transportation reconceptualized notions of urban space in Brazil and led masses of people across the country to protest. This book shows how the anti-capitalist, anti-bourgeoisie stance present in the discourse of a number of Brazilian bands that performed from the late 1990s to the beginning of the 21st century in the underground music scenes of Florianópolis and São Paulo encountered a reverberation in the rhetoric emanatin', 'Distortion and Subversion', NULL, NULL, '166', 'en', NULL, 'Transportation');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1074', '1', '1', 'Gilmar Gonçalves Da Costa', '2026-02-17 02:24:32.594157', '2026-02-20 02:24:32.594157', '0', 'OTIMO', '["https://books.google.com/books/content?id=5HKREQAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9798269603414', '174.44', NULL, NULL, 'O presente livro trata da relação da saúde mental e a mente humana. Assim, percebe-se que a saúde mental pode ser causada por vários fatores. Primeiro, há algumas doenças mentais devido aos componentes hereditários; significa que os genes podem aumentar a probabilidade de desenvolver um transtorno mental. No entanto, a maioria das doenças mentais não é puramente genética; elas resultam da interação complexa entre fatores genéticos e ambientais, como experiências de vida e de outros fatores de risco. Ter como uma parente próximo com uma doença mental é o maior fator de risco conhecido, mas não garante o desenvolvimento da condição. Segundo, o fator cultural é um emento crucial na e, ou, da saúde mental. As doenças mentais podem ser diretamente relacionadas a fatores culturais; pois, a cultura influencia a forma como o sofrimento é percebido, expresso e tratado, além de afetar a exposição a determinantes sociais como pobreza, discriminação e violência, que são causas comuns de problemas ', 'Por Uma Abordagem Nova Da Saúde Mental', NULL, NULL, '208', 'pt-BR', NULL, 'Social Science');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1075', '1', '1', 'Pedro M. Arezes, J. Santos Baptista', '2026-03-07 02:24:32.594157', '2026-03-09 02:24:32.594157', '0', 'OTIMO', '["https://books.google.com/books/content?id=cu7RDwAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9783030414863', '163.94', NULL, NULL, 'This book explores a number of important issues in the area of occupational safety and hygiene. Presenting both research and best practices for the evaluation of occupational risk, safety and health in various types of industry, it particularly focuses on occupational safety in automated environments, innovative management systems and occupational safety in a global context. The different chapters examine the perspectives of all those involved, such as managers, workers and OSH professionals. Based on selected contributions presented at the 16th International Symposium on Occupational Safety and Hygiene (SHO 2020), held on 6–7 April, 2020, in Porto, Portugal, the book serves as a timely reference guide and source of inspiration to OSH researchers, practitioners and organizations operating in a global context.', 'Occupational and Environmental Safety and Health II', NULL, NULL, '30', 'en', NULL, 'Technology & Engineering');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1076', '1', '1', 'Rogério Vale, Alinne Duarte', '2026-05-23 02:24:32.594157', '2026-05-25 02:24:32.594157', '0', 'NOVO', '["https://books.google.com/books/content?id=sONOEQAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9786554960960', '369.12', NULL, NULL, 'Em Um olhar para a saúde integral, 27 autores contribuem com sua perspectiva sobre a saúde e a interconexão entre mente, corpo e ambiente, oferecendo uma abordagem holística e contemporânea do bem-estar. A relação entre corpo e mente é discutida em profundidade e revela como a mente influencia a saúde física e emocional. Você vai descobrir de que modo práticas como o yoga e os cuidados com a saúde financeira podem ser ferramentas essenciais para alcançar o equilíbrio integral. Ademais, os autores falam da nutrição de maneira abrangente, destacando a importância de uma alimentação consciente, examinam os impactos ambientais na saúde das crianças, questões relativas à inflamação crescente na sociedade, como o ciclo menstrual ou a interrupção dele afeta a saúde das mulheres e a relevância do autocuidado e da saúde preventiva. Temas como autocompaixão, rejeição, a mente do empreendedor, saúde cardiovascular, detox e suplementação, bem como reflexões sobre a prevenção do câncer e viver com ', 'Um olhar para a saúde integral', NULL, NULL, '333', 'pt-BR', NULL, 'Health & Fitness');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1077', '1', '1', 'Macieira Soares', '2025-06-14 02:24:32.594157', '2025-06-17 02:24:32.594157', '0', 'OTIMO', '["https://books.google.com/books/content?id=DLLS0AEACAAJ&printsec=frontcover&img=1&zoom=1&source=gbs_api"]', '9798332752452', '87.17', NULL, NULL, 'Bem-vindo a uma jornada que mudará sua vida - "Saúde e Bem-Estar: O Caminho para uma Vida Plena". Este livro é o farol que ilumina a estrada rumo a uma vida de vitalidade, equilíbrio e felicidade duradoura. Prepare-se para descobrir os segredos da saúde total, explorando cada aspecto de seu bem-estar físico e emocional. Parte 1: Fundamentos da Saúde Nos primeiros capítulos, mergulhamos nos fundamentos da saúde. Você entenderá a íntima conexão entre saúde e bem-estar e como essa conexão permeia todos os aspectos de sua existência. Descobrirá a importância de uma alimentação balanceada e da atividade física, não apenas para a estética, mas para uma vida cheia de energia e vitalidade. Parte 2: Nutrição Equilibrada No segundo capítulo, abordamos os princípios fundamentais de uma dieta equilibrada. Desvendamos os mistérios dos grupos de alimentos essenciais e revelamos como controlar o tamanho das porções e as calorias de maneira inteligente. Este é o seu guia para fazer escolhas alimentare', 'Saúde e Bem-Estar', NULL, NULL, '278', 'pt-BR', NULL, 'Health & Fitness');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1078', '1', '1', 'Max Editorial', '2025-10-27 02:24:32.594157', '2025-10-29 02:24:32.594157', '0', 'RUIM', '["https://books.google.com/books/content?id=0tmOEQAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9781779744609', '132.37', NULL, NULL, '🌈 Espiritualidade e Luto Pet: Como a Fé Pode Ajudar na Superação 🕊️ é um livro emocionante e inspirador que convida você a enxergar a perda do seu pet sob uma nova luz — a da esperança e do amor que transcende o tempo. 💞 Em meio à dor da despedida, a fé pode se tornar um refúgio poderoso. Esta obra mostra como diferentes crenças e práticas espirituais podem oferecer conforto, significado e força interior para lidar com o vazio deixado por um companheiro fiel. 🙏 Com reflexões profundas, mensagens de consolo e exercícios de conexão espiritual, o livro ensina como transformar o sofrimento em serenidade e a saudade em gratidão, mantendo vivo o elo que jamais se rompe. 🐾 "Espiritualidade e Luto Pet: Como a Fé Pode Ajudar na Superação" é um guia de cura e reconexão, que acolhe o coração ferido e mostra que o amor verdadeiro — aquele entre humanos e animais — nunca termina, apenas muda de forma. ✨', 'Espiritualidade e Luto Pet Como a Fé Pode Ajudar na Superação', NULL, NULL, '236', 'en', NULL, 'Health & Fitness');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1079', '1', '1', 'Max Editorial', '2026-02-18 02:24:32.594157', '2026-02-19 02:24:32.594157', '0', 'DESGASTADO', '["https://books.google.com/books/content?id=GdSOEQAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9781779744302', '351.11', NULL, NULL, '🐾 Como a Espiritualidade do Meu Pet Me Levou a Ajudar Outros Corações é uma jornada emocionante de amor, perda e renascimento. Neste livro inspirador, você vai descobrir como a conexão espiritual com um animal pode transformar a dor em propósito — e como o vínculo com seu pet pode continuar além da vida física. 💫 São Compartilhadas reflexões profundas, experiências reais e lições sobre empatia, compaixão e cura interior. É uma leitura perfeita para quem perdeu um companheiro de quatro patas e busca entender os sinais, os reencontros e o poder do amor incondicional que ultrapassa o tempo e o espaço. ❤️ Este livro é mais do que uma história — é um convite à esperança. Ao percorrer estas páginas, você aprenderá a enxergar a espiritualidade dos animais, compreender o significado da partida e encontrar consolo ao perceber que o amor verdadeiro nunca morre.', 'Como a Espiritualidade do Meu Pet Me Levou a Ajudar Outros Corações', NULL, NULL, '118', 'en', NULL, 'Health & Fitness');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1080', '1', '1', 'Ariê Shlomo Akiva', '2026-05-15 02:24:32.594157', '2026-05-18 02:24:32.594157', '0', 'BOM', '["https://books.google.com/books/content?id=1w6XEAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9786599356636', '109.59', NULL, NULL, 'Sabedoria Judaíca e seus Ensinamentos Inspirados ; Cabala,Deus,Sabedoria,Meditações,Espiritualidade,Akiva,Moshé,Arizal,David,Merkabah,Sefiroth,arvore da vida,poder da Kabbalah', 'Sabedoria E Espiritualidade', NULL, NULL, '231', 'pt-BR', NULL, 'Self-Help');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1081', '1', '1', 'Adriana Ferreira Da Silva, Helena Becker Issi, Luise Kosmaliski Melo, Patrícia Garcia Guilardi E Tiani Godinho Da Silva', '2026-02-03 02:24:32.594157', '2026-02-07 02:24:32.594157', '0', 'OTIMO', '["https://books.google.com/books/content?id=vUHOEAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9786526607534', '90.15', NULL, NULL, 'A morte da criança gera nas pessoas uma dor imensurável, simbolizando um corte com o que seria natural às fases do desenvolvimento do ser humano. Em se tratando do câncer, segundo dados do Instituto Nacional do Câncer (BRASIL, 2009), o câncer infantil é a segunda causa de morte nos indivíduos abaixo dos 19 anos, perdendo apenas para as causa externas. No entanto, desde os anos 60 a medicina fez grandes avanços no tratamento dos cânceres infantis, aumentando assim sua sobrevida. Contudo, aproximadamente 30 % das crianças portadoras de neoplasia não obterão a cura de sua enfermidade e receberão o tratamento intitulado paliativo até a sua terminalidade. Normalmente, o óbito da criança acometida por algum tipo de câncer ocorre no ambiente hospitalar no qual a equipe de enfermagem está na linha de frente desse cuidado. A partir disso, este estudo tem como objetivo conhecer as experiências da equipe de enfermagem frente à criança em cuidados paliativos na Unidade de Oncologia Pediátrica do H', 'O Processo De Morrer E A Espiritualidade Na Assistência Ao Fim Da Vida Do Paciente Pediátrico Oncológico', NULL, NULL, '403', 'pt-BR', NULL, 'Health & Fitness');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1082', '1', '1', 'Renilda Gonçalves E Valeriah Frega', '2025-12-16 02:24:32.594157', '2025-12-20 02:24:32.594157', '0', 'RUIM', '["https://books.google.com/books/content?id=rr-vEAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9786580410088', '62.36', NULL, NULL, 'O objetivo deste livro é provocar em você, leitor, uma reflexão a respeito da sua relação com o dinheiro e com a espiritualidade. Segundo pesquisas referentes ao comportamento financeiro, a forma como lidamos com o dinheiro normalmente é repetida em outras áreas da vida. E essa forma está ligada ao sistema de crenças. Serão abordados nos capítulos temas como autoconhecimento, conscientização e gerenciamento do dinheiro, além de chakras e técnicas para trabalhar o dinheiro e a espiritualidade. A sugestão é que você se abra para essa leitura, aproveitando ao máximo as possibilidades de transformação, proporcionando um novo olhar para as oportunidades de crescimento na sua vida, afinal, os seus resultados estão diretamente conectados com a sua frequência energética. Permita-se, agora, mergulhar nesta experiência!', 'Dinheiro E Espiritualidade', NULL, NULL, '360', 'pt-BR', NULL, 'Literary Collections');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1083', '1', '1', 'Ari Antônio Da Silva', '2026-04-19 02:24:32.594157', '2026-04-22 02:24:32.594157', '0', 'OTIMO', '["https://books.google.com/books/content?id=BrocEQAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788595180123', '232.97', NULL, NULL, 'O livro Ética, Espiritualidade e Cidadania: Ser Cristão na Cultura Pós-Moderna de Ari Antônio da Silva explora, por meio de uma série de ensaios, uma profunda reflexão ética a partir da perspectiva cristã, contextualizada na realidade da América Latina e do mundo contemporâneo. O autor foca na necessidade de uma coerência entre a fé cristã e a prática cotidiana, argumentando que a falta dessa conexão resulta em uma crise de valores na sociedade moderna. A obra enfatiza que a ética cristã deve ser vivida de maneira concreta, influenciando todas as esferas da vida, desde as relações interpessoais até a gestão pública e as empresas. Ari Antônio da Silva também critica o desenvolvimento científico e tecnológico, apontando que ele tem alimentado uma falsa sensação de autossuficiência no ser humano contemporâneo, afastando-o da transcendência e do verdadeiro sentido da vida. Ele aborda a crise de esperança na modernidade, sugerindo que a fé no progresso substituiu a fé cristã, o que levou a ', 'Ética, Espiritualidade E Cidadania', NULL, NULL, '421', 'pt-BR', NULL, 'Education');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1084', '1', '1', 'Emerson Calejon', '2026-04-29 02:24:32.594157', '2026-05-02 02:24:32.594157', '0', 'RUIM', '["https://books.google.com/books/content?id=HmYSEQAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9798329259940', '168.02', NULL, NULL, 'Devemos reconhecer que o nosso entendimento ainda é limitado perante o vasto conhecimento universal. Há mil anos, seria possível compreender conceitos como energia cinética, micro-ondas, transmissões de imagens por ondas eletromagnéticas em aparelhos de televisão e rádio, ou mesmo a eletricidade? As frequências de transmissão de rádio e televisão são semelhantes às utilizadas pelos seres espirituais avançados no plano astral para se comunicarem através da Transcomunicação Instrumental (TCI). A força cinética e a eletricidade estão presentes em nossos corpos e em nosso entorno. Quanto mais avançamos cientificamente, mais oportunidades damos para a intervenção divina e para entender que todas as coisas estão mais próximas do que pensamos. É importante que cada indivíduo abrace o seu próprio progresso e lide com as suas próprias questões para alcançar a compreensão necessária.', 'Ciência, Espiritualidade E Filosofia', NULL, NULL, '235', 'pt-BR', NULL, 'Music');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1085', '1', '1', 'Francis A. Schaeffer', '2026-03-22 02:24:32.594157', '2026-03-23 02:24:32.594157', '0', 'NOVO', '["https://books.google.com/books/content?id=NUCHEAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9786559891498', '309.65', NULL, NULL, 'Uma abordagem sistemática dos fundamentos para sua relação aberta e sincera com Deus, com os outros e consigo mesmo. O que há de exclusivo na contribuição de Francis Schaeffer é a sua compreensão da desesperadora carência que o homem moderno tem da verdade, beleza e sentido da vida. Isto fica particularmente evidenciado no seu ministério do L''Abri, na Suíça, que se concentrava amplamente no seu lar. Milhares de pessoas vinham até o L''Abri: profissionais de todos os tipos e de todas as partes do mundo. Em vez de estudar livros e mais livros em uma torre de marfim isolada da vida e desenvolver teorias alienadas do pensamento e das lutas do ser humano Francis Schaeffer conversou durante muitos anos com homens e mulheres bem em meio às lutas daquelas pessoas. Ele estabeleceu diálogo com existencialistas, positivistas lógicos, hindus, budistas, protestantes e católicos liberais, judeus reformados e ateus, muçulmanos, membros de seitas do ocultismo e pessoas de uma ampla variedade de religiõ', 'Verdadeira Espiritualidade', NULL, NULL, '259', 'pt-BR', NULL, 'Religion');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1086', '1', '1', 'de Araújo,Lima,Moacir Costa', '2026-01-01 02:24:32.594157', '2026-01-04 02:24:32.594157', '0', 'OTIMO', '["https://books.google.com/books/content?id=bR8WDAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788565909396', '321.77', NULL, NULL, 'Quântica: Espiritualidade e Saúde completa a trilogia de estudos sobre a conexão ciência e espiritualidade, dentro do novo paradigma quântico-relativístico. Nesta obra, o autor relaciona saúde e a cura com a espiritualidade, mostrando sua estreita relação com o aspecto fundamental do ser humano: a consciência imaterial. A prática da espiritualidade canaliza energias fundamentais para o bem-estar integral. São examinados vários casos e processos de cura, e as comprovações estatísticas da relevância da espiritualidade para a boa saúde e sua recuperação. No segundo livro da trilogia, Quântica: o Caminho da Felicidade (AGE, 2011), mostra o autor como a nova ciência demonstrou nossa liberdade de escolha e nossa vocação para a felicidade. Questionamentos básicos sobre a física quântica são respondidos de modo simples e ao alcance de pessoas não especialistas. Mostra-se como e por que, diante da nova visão do Universo, podemos transformar nossas vidas, arquitetando nosso destino. O primeiro l', 'Quântica - Espiritualidade e Saúde', NULL, NULL, '370', 'pt-BR', NULL, 'Religion');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1087', '1', '1', 'Anselm Grün, David Steindl-Rast', '2025-09-01 02:24:32.594157', '2025-09-04 02:24:32.594157', '0', 'OTIMO', '["https://books.google.com/books/content?id=aCZFDwAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788532657039', '336.77', NULL, NULL, 'Nestas páginas são discutidas abertamente e com simplicidade as questões centrais da fé! Com grande sabedoria e com rico tesouro de suas experiências, Anselm Grün e David Steindl-Rast falam sobre questões-chaves da vida e da fé, com as quais todo homem e toda mulher se confrontam durante sua vida: De onde vim e para onde eu vou? O que acontece depois da morte? Quem é Deus? Por que está acontecendo todo esse sofrimento em nosso planeta? De onde vem o mal? Como vou ser feliz?', 'O depósito da nossa fé', NULL, NULL, '139', 'pt-BR', NULL, 'Body, Mind & Spirit');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1088', '1', '1', 'Hermes Bôto, Denise Romão', '2026-04-24 02:24:32.594157', '2026-04-25 02:24:32.594157', '0', 'BOM', '["https://books.google.com/books/content?id=TzLxEAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9786553556874', '380.91', NULL, NULL, 'A vida é uma eterna "poesia" em contos e fatos que a vida real proporciona a alguns seres em sua caminhada. Essa conexão dos seres parte do imaginário a ações do cotidiano em experiências únicas. Esta obra ilustra a sintonia de Denise e SILVA em um tempo espaço em que são contagiados pelo ritmo poético e contos de várias problemáticas da VIDA. Aqui estão as impressões de cada um em suas experiências única e Unidos no bem maior do coração. Amar é a forma de transcrever os sentimentos para que alcance o interlocutor assíduo com o poder da sintonia conectada. Encontre o sentido da poesia em sua vida. E a deixe mais leve e suave para se viver. Acreditando no poder do Amor.', 'Espiritualidade em poesia', NULL, NULL, '273', 'pt-BR', NULL, 'Religion');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1089', '1', '1', 'Tiago Alberione', '2025-08-18 02:24:32.594157', '2025-08-20 02:24:32.594157', '0', 'RUIM', '["https://books.google.com/books/content?id=SC2FEQAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788534958585', '322.79', NULL, NULL, 'Os Pensamentos do beato Tiago Alberione aqui reunidos pelo seu íntimo colaborador, Padre João Roatta, são apenas uma pequena parte da enorme riqueza de considerações, experiências e intuições espirituais que o fundador da Família Paulina nos deixou. Seus escritos dão forma à identidade espiritual e apostólica dos seus filhos e filhas, além de fornecer inestimável auxílio para cada cristão interessado em realizar plenamente a sua vocação. Dotado de raro carisma, Padre Alberione nos apresenta com credibilidade e vitalidade um forte testemunho de vida, fruto de inúmeras inciativas apostólicas que derivam da sua profunda intimidade com Deus. O seu pensamento teológico original pertence irrevogavelmente ao tesouro da sabedoria inspirada da Igreja, sem perder nada da sua relevância hoje.', 'Bem-Aventurado Tiago Alberione - Pensamentos', NULL, NULL, '355', 'pt-BR', NULL, 'Religion');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1090', '1', '1', 'Nilton Bonder', '2026-03-13 02:24:32.594157', '2026-03-17 02:24:32.594157', '0', 'BOM', '["https://books.google.com/books/content?id=dbcN2Ws8QoMC&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788581220024', '243.05', NULL, NULL, 'Há momentos em que aquilo que nos cega não é a escuridão, mas o excesso de luz. Estando diante de um mundo luminoso de prazer e respostas prontas, os descalibrados refletores da certeza nos impedem de enxergar as contradições, as ambiguidades e as sutilezas daquilo que nos cerca. A fé não é formada por certezas, mas por dúvidas trabalhadas de maneira sensível e sofisticada. Questões como "Há alguma continuidade após a morte?", "Existe um Criador?" ou "Há alguma ordem oculta que rege o nosso mundo?" não podem ser respondidas pela razão. Nilton Bonder ensina que a espiritualidade é uma forma de inteligência baseada no culto da incerteza. Sábio não é quem sabe mais, e sim o que mais procura aprender, já que não tem certezas imunes ao espectro da dúvida. Bordejando as fronteiras da inteligência, Bonder nos mostra que, se apenas a certeza é visível, é preciso aprender a enxergar muito além dela. Apenas reconhecendo um mundo que também é formado por sombras e incertezas, entraremos em contat', 'Fronteiras da inteligência', NULL, NULL, '78', 'pt-BR', NULL, 'Religion');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1091', '1', '1', 'Jaqueline Costa Santos', '2025-11-30 02:24:32.594157', '2025-12-02 02:24:32.594157', '0', 'DESGASTADO', '["https://books.google.com/books/content?id=MUlyEQAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9798340125453', '103.04', NULL, NULL, 'A série de mini-livros "Mensagens Espirituais dos Orixás", escrita por Jaqueline Costa Santos, oferece uma conexão profunda com a sabedoria ancestral dos Orixás, guiando o leitor em sua jornada espiritual e de autoconhecimento. Cada livro é dedicado a um Orixá específico, trazendo mensagens de força, cura e harmonia para inspirar a evolução pessoal e espiritual. A coleção é uma fonte de paz, iluminação e equilíbrio, ideal para quem busca o despertar espiritual através da ancestralidade. Conecte-se e Inspire-se! Volume 6 - Oxum Oxum é a Orixá das águas doces, do amor, da beleza e da fertilidade. A Linha de Oxum é caracterizada por entidades que trazem conforto emocional, cura amorosa e prosperidade. As entidades dessa linha trabalham para equilibrar as emoções, promover harmonia nos relacionamentos e atrair abundância para os consulentes. Oxum também está associada à maternidade e à proteção dos lares, guiando aqueles que buscam conexão com suas emoções mais profundas e o amor incondici', 'Mensagens Espirituais dos Orixás: Oxum', NULL, NULL, '90', 'pt-BR', NULL, 'Religion');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1092', '1', '1', 'Lilian Campos', '2026-02-28 02:24:32.594157', '2026-03-02 02:24:32.594157', '0', 'BOM', '["https://books.google.com/books/content?id=pxdoEAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9786500346886', '81.59', NULL, NULL, 'Compreenda como os Guardiões atuam em nossas vidas. Por meio de histórias que exemplificam os percalços da existência, Sete Porteiras mostra a atuação dos Guardiões, representantes das Leis Divinas, e tenta desmistificar as crenças que envolvem esses abnegados protetores que batalham ao lado dos encarnados. Em: Os Pequenos Capirotos, o leitor entenderá como as manifestações mediúnicas se apresentam desde a infância e de que maneira os amparadores atuam na preparação do futuro medianeiro. Em: O Último Trem, Sete Porteiras relata a história de um grupo de cientistas que, após inúmeras escolhas prejudiciais à humanidade, são expatriados para um orbe inferior. Em: Entrevista com Quiumba II, o amparador espiritual narra uma breve entrevista cedida por um vampirizador que recusa o planejamento reencarnatório e insiste em permanecer no plano astral da crosta invadindo residências e obsedando os encarnados. Em: A Missão, Sete Porteiras explica o temperamento indomável que, em alguns casos, se ', 'CONTOS DE GUARDIÃO II', NULL, NULL, '218', 'pt-BR', NULL, 'Body, Mind & Spirit');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1093', '1', '1', 'Robson Pinheiro', '2025-06-18 02:24:32.594157', '2025-06-20 02:24:32.594157', '0', 'OTIMO', '["https://books.google.com/books/content?id=-Ka0EQAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788599818763', '145.29', NULL, NULL, 'Espiritualidade, política e a guerra invisível pelo futuro da humanidade. Quem disse que os espíritos superiores se ocupam apenas de consolar corações aflitos? Se o bem não enfrentar o mal onde ele se instala ― entre poderosos, nos bastidores da política, nas guerras e nos grandes esquemas do crime ― quem o fará? Neste novo livro, Ângelo Inácio vai além da compaixão e revela o lado combativo da espiritualidade superior: uma força que age com justiça, estratégia e coragem para proteger os destinos da Terra. Depois do sucesso de O partido: projeto criminoso de poder , A quadrilha aprofunda a atuação dos guardiões do Alto contra inteligências sombrias, magos negros e forças ocultas que tentam sabotar os planos espirituais traçados para a América do Sul. Uma narrativa reveladora sobre os bastidores da política espiritual, onde se decide muito mais do que eleições: define-se o rumo da evolução humana. A verdade vem à tona. A luz está em marcha. E a batalha pelo futuro já começou.', 'A quadrilha', NULL, NULL, '187', 'pt-BR', NULL, 'Religion');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1094', '1', '1', 'Lilian Campos', '2025-08-22 02:24:32.594157', '2025-08-26 02:24:32.594157', '0', 'RUIM', '["https://books.google.com/books/content?id=JztiEQAAQBAJ&printsec=frontcover&img=1&zoom=1&source=gbs_api"]', '9786501392103', '246.34', NULL, NULL, 'Mantendo a arte de ensinar por meio de exemplos. Sete Porteiras apresenta mais uma lista de histórias capaz de mudar a maneira de ver e entender a vida. Em tratamento de choque IV, o amparador prossegue com o objetivo de mostrar a dinâmica dos atendimentos espirituais e apresenta o caso de Luana, uma consulente cheia de ideias distorcidas que encontra em Maria Navalha o tratamento ideal para a cegueira íntima. Em “Entrevista com Quimba IV”, Lebeau presenteia o leitor com mais uma história intrigante e relata as dificuldades de Oscar, um coveiro do astral que, em vida, foi um respeitado psicólogo e, após o desencarne, decide dar uma lição de autoconhecimento nos próprios amparadores espirituais. Em “Vovô é um Exu”, Sete Porteiras conta a história de Fortunato, um vovozinho muito amável que, quando inspirado pelo próprio guardião, transformava-se em um conselheiro excepcional. Em “O Deputado”, o emparador espiritual mostra a história de um homem humilde e cheio de nobres intenções que, a', 'Contos De Guardião', NULL, NULL, '345', 'pt-BR', NULL, 'Body, Mind & Spirit');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1095', '1', '1', 'Santa Teresa De Jesus, Santa Teresa de Jesus', '2026-05-23 02:24:32.594157', '2026-05-24 02:24:32.594157', '0', 'NOVO', '["https://books.google.com/books/content?id=RmfT0AEACAAJ&printsec=frontcover&img=1&zoom=1&source=gbs_api"]', '9788532648730', '68.97', NULL, NULL, 'Esta foi a primeira obra de Santa Teresa publicada, onde ela busca apontar alguns remédios para certas tentações miúdas, sugeridas pelo demônio, das quais talvez não façamos caso, justamente por serem tão pequenas. As obras de Santa Teresa de Jesus têm o objetivo de ajudar suas irmãs religiosas na prática espiritual e na devoção valorizando a alma e o espírito, e deixando o corpo em segundo plano.', 'Caminho de perfeição', NULL, NULL, '255', 'pt-BR', NULL, 'Religion');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1096', '1', '1', 'Elisa Masselli', '2026-04-18 02:24:32.594157', '2026-04-19 02:24:32.594157', '0', 'BOM', '["https://books.google.com/books/content?id=a_JNEAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9786557920039', '244.92', NULL, NULL, 'Esta é uma história repleta de suspense, segredos e descobertas! Walther era jovem, morava nos Estados Unidos, tinha uma profissão definida e levava uma vida tranquila. Contudo, após a morte de sua mãe, segredos lhe foram revelados, o que o levou a tomar uma atitude que mudaria completamente sua vida. Empreendeu uma longa caminhada, repensou conceitos, preconceitos e conheceu a espiritualidade. Não imaginava, mas Deus estava presente em sua vida.', 'Deus estava com ele', NULL, NULL, '274', 'pt-BR', NULL, 'Body, Mind & Spirit');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1097', '1', '1', 'Jaqueline Costa Santos', '2025-06-15 02:24:32.594157', '2025-06-20 02:24:32.594157', '0', 'OTIMO', '["https://books.google.com/books/content?id=voVlEQAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9798319119315', '219.35', NULL, NULL, 'A Aventura Mágica do Arcanjo Miguel e as Crianças Falantes Por Jaqueline Costa Santos Conexões Todos Somos Um Copyright © 2025 Em um universo onde a magia e a pureza da infância se entrelaçam com a espiritualidade, A Aventura Mágica do Arcanjo Miguel e as Crianças Falantes convida crianças e adultos a embarcarem em uma jornada encantadora de luz, coragem e sabedoria. Guiadas pelo amoroso e protetor Arcanjo Miguel, as Crianças Falantes — seres especiais que compreendem os sentimentos, escutam a natureza e falam com os animais — enfrentam desafios e descobertas que os ajudam a despertar seu verdadeiro poder interior. Com uma narrativa lúdica, acolhedora e cheia de ensinamentos sutis, este livro promove valores como a empatia, a verdade, a proteção da Terra e a conexão com o sagrado que habita em cada um de nós. Escrito por Jaqueline Costa Santos, fundadora da Conexões Todos Somos Um, esta obra é um presente para famílias, educadores e buscadores de uma nova consciência, que desejam semea', 'A Aventura Mágica do Arcanjo Miguel e as Crianças Falantes', NULL, NULL, '408', 'pt-BR', NULL, 'Juvenile Fiction');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1098', '1', '1', 'Elaine Gonçalves', '2025-10-23 02:24:32.594157', '2025-10-28 02:24:32.594157', '0', 'RUIM', '["https://books.google.com/books/content?id=Hko_DwAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9781526002839', '288.48', NULL, NULL, 'O Despertar da Mediunidade é sobre a minha história de vida em relação à espiritualidade, a pedido dos meus mentores, relatei aqui algumas passagens que percorri ao longo de minha jornada neste plano, onde em busca de conhecimentos e equilíbrio, enfrentei obstáculos e continuei dia após dia no intuito de melhorar e evoluir meu Espírito através de minhas próprias escolhas em relação pessoal e interpessoal. Descobrindo uma nova maneira de viver junto com os Espíritos desencarnados, onde tudo ganhou mais vida e sentido para aquilo que sempre busquei “Conhecimentos e Evolução”. Este livro é para as pessoas que como eu estão em busca de novos conceitos de vida, e sozinhas tem que se manterem firmes em seus ideais, desejos e crenças, que sua vontade em, poder e ser, sejam maiores que os tropeços e obstáculos que fizeram e fazem parte de sua jornada, para as pessoas que acreditam na existência de uma forma simples e fácil de viver a vida como ela é.', 'O Despertar da Mediuniudade', NULL, NULL, '424', 'pt-BR', NULL, 'Religion');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1099', '1', '1', 'Sebastian Sann, Sr.', '2025-09-05 02:24:32.594157', '2025-09-08 02:24:32.594157', '0', 'BOM', '["https://books.google.com/books/content?id=PbnE0QEACAAJ&printsec=frontcover&img=1&zoom=1&source=gbs_api"]', '9798902250098', '202.53', NULL, NULL, 'Conheça a Única Verdade é um livro que orienta o leitor a sair do condicionamento mental, emocional e social que governa a sua vida sem que ele perceba. Ele expõe com clareza como operam os padrões herdados, como realmente funciona a vibração pessoal e por que repetimos histórias que acreditamos ter superado. Ao longo dos seus capítulos, o livro revela como a consciência cria a realidade, como o medo sustenta a programação coletiva e como recuperar o centro interior para viver com autenticidade e propósito. Esta obra combina espiritualidade, psicologia profunda e um olhar direto sobre a Matrix moderna para que o leitor possa compreender por que vive preso em certos ciclos e, acima de tudo, como voltar à sua verdade essencial. Não oferece fórmulas rápidas nem promessas vazias; oferece uma exploração honesta que convida a olhar para dentro e questionar tudo. Com uma abordagem prática e transformadora, o autor apresenta princípios que permitem elevar a vibração, quebrar crenças limitantes', 'Conheça a Única Verdade', NULL, NULL, '44', 'pt-BR', NULL, 'Religion');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1100', '1', '1', 'Jorge Cunha Cruvinel Filho', '2026-02-26 02:24:32.594157', '2026-03-01 02:24:32.594157', '0', 'BOM', '["https://books.google.com/books/content?id=6E_TEAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9786556253671', '314.85', NULL, NULL, 'Este livro é uma investigação interior levada a cabo pelo psiquiatra Jorge Cunha Cruvinel Filho. Após anos dedicando-se ao autoconhecimento, o autor expressa suas vivências nesse campo de maneira livre e poética. Busca compreender a consciência humana à luz da sabedoria sagrada Advaita Vedanta, explorando os movimentos mentais a partir de seus fundamentos (gunas): as energias de sattva (energia luminosa), rajas (energia de vida) e tamas (energia de morte). As transformações interiores ao longo do caminho espiritual são o foco do livro. De fato, o despertar (moksha) é uma ocorrência interior que desabrocha em um instante revelador, contudo, as vivências interiores ao longo dos anos de busca por compreensão são muito pouco exploradas pela literatura espiritual. Esta obra visa contribuir para preencher essa lacuna, sem nunca desconsiderar a peculiaridade do processo vivenciado por cada um. Eis a canção espiritual de um buscador sincero.', 'E Terás Que Me Dizer 2.ed.', NULL, NULL, '292', 'pt-BR', NULL, 'Religion');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1101', '1', '1', 'Adrian Villasenor Galarza', '2025-12-19 02:24:32.594157', '2025-12-20 02:24:32.594157', '0', 'BOM', '["https://books.google.com/books/content?id=Mr3NywEACAAJ&printsec=frontcover&img=1&zoom=1&source=gbs_api"]', '9781702168298', '71.69', NULL, NULL, 'A espiritualidade da era planetária, este momento histórico de luz luminosa e escuridão profunda em que as atividades de nossa espécie são sentidas pelo ecossistema global, convida-nos com urgência a recuperar o sentido do sagrado na vida cotidiana. Para fazer isso, torna-se necessário conectar e ativar o núcleo do coração. É desse lugar que velhas crenças, hábitos e costumes dão lugar a uma relação interdependente e harmoniosa entre a humanidade, o sagrado e a terra, entre o espiritual e o material. O coração gera o verdadeiro humano planetário através da integração do Céu e da Terra, e esse nascimento permite a possibilidade de um futuro viável para todos.', 'Coração do céu, coração da terra', NULL, NULL, '484', 'pt-BR', NULL, 'Geral');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1102', '1', '1', 'Leandro Alves Soares', '2025-08-10 02:24:32.594157', '2025-08-15 02:24:32.594157', '0', 'OTIMO', '["https://books.google.com/books/content?id=VQkqEAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9781097733248', '306.94', NULL, NULL, 'Essa é uma boa indicação para quem quer ler livro cristão sobre São Francisco de Assis, sua obra e a regra dos irmãos Franciscanos. Paz e bem e as regras de orações fazem parte da missão de um franciscanos, membros da OFS - Ordem Franciscana Secular e este livro serve como um guia para os irmãos franciscanos e para as espiritualidades destes.', 'Espiritualidade Diária - Para Regrar a Oração', NULL, NULL, '427', 'pt-BR', NULL, 'Drama');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1103', '1', '1', 'Henri Nouwen', '2025-06-15 02:24:32.594157', '2025-06-18 02:24:32.594157', '0', 'OTIMO', '["https://books.google.com/books/content?id=71uJEQAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788532673831', '154.63', NULL, NULL, 'Henri Nouwen nos conduz por uma profunda meditação sobre a Eucaristia, partindo da história dos discípulos a caminho de Emaús. Ao relatar essa jornada, ele mostra como a celebração eucarística reflete nossa própria experiência: da dor à escuta, do reconhecimento à missão. Nouwen nos convida a viver uma vida eucarística – não apenas a participar do rito, mas a fazer dele um caminho de transformação.', 'Fica conosco, Senhor', NULL, NULL, '101', 'pt-BR', NULL, 'Religion');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1104', '1', '1', 'Antonio Ramos do Prado, Adelino Francisco de Oliveira', '2025-12-09 02:24:32.594157', '2025-12-12 02:24:32.594157', '0', 'OTIMO', '[]', '9788515040278', '250.24', NULL, NULL, 'Este livro apresenta de maneira panorâmica elementos para a composição de um itinerário de espiritualidade para o jovem contemporâneo.', 'Um caminho espiritual para jovens', NULL, NULL, '437', 'pt-BR', NULL, 'Religion');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1105', '1', '1', 'Gregory Toussaint', '2025-09-05 02:24:32.594157', '2025-09-06 02:24:32.594157', '0', 'NOVO', '[]', '9781639491094', '352.72', NULL, NULL, '"Construir uma Nação Santa" é uma série devocional que se concentra em 12 sectores ou portões essenciais que são áreas cruciais que precisam de ser bem estabelecidas para uma sociedade harmoniosa e próspera. Estes incluem espiritualidade, família, negócios, alimentação, saúde, patriotismo, desenvolvimento, educação, artes, justiça, segurança, e governo. A espiritualidade promove valores morais e práticas espirituais sólidas enquanto a unidade familiar se ergue como o bloco de construção de uma grande nação. O crescimento empresarial e económico são importantes, assim como o acesso a alimentos saudáveis e nutritivos. O sector da saúde é responsável pelo bem-estar físico e mental da comunidade, enquanto que a porta do patriotismo promove a unidade nacional e o envolvimento cívico. Desenvolvimento e infra-estruturas, educação e aprendizagem ao longo da vida, artes e cultura, e justiça e segurança são portões que contribuem para o sucesso global de uma Nação Santa. Finalmente, um governo f', 'Construindo Uma Nação Santa', NULL, NULL, '360', 'en', NULL, 'Geral');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1106', '1', '1', 'Anabela Rocha', '2026-01-16 02:24:32.594157', '2026-01-18 02:24:32.594157', '0', 'DESGASTADO', '["https://books.google.com/books/content?id=oxSpEAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9789893745571', '298.25', NULL, NULL, 'Ao longo de um encontro em amizade de um dia e uma noite, uma intensa história de amor é revelada num progressivo despertar de uma mulher na sua verdade e sexualidade. Sem fingir. Sem pudor. Com amor. Em Esmoriz, na casa da praia da família de Isabella, que, por motivos profissionais, teve de seguir viagem para o Algarve, Íris, Mariana e Sofia entram em profundas reflexões vestidas tanto de dureza como de beleza, sobre temáticas que assombram o quotidiano da vida de muitas pessoas. Vamos falar de relacionamentos? Sim, mas também de mentira. Aparência. Desapego. Injustiça. Solidão. Amizade. Amor. Contradição. Neste encontro, tudo é colocado em causa, desde a religião à ciência, desmistificando preconceitos na incerteza do certo e do errado. Entra-se em esferas da razão existencial à procura de respostas. Qual é o nosso caminho? Quais os princípios que regem a vida? Coexiste vida invisível superior? O que é a espiritualidade? Existe pecado? E a alma? Este encontro termina com a sensação ', 'ROSA SANGUE - SEXUALIDADE & ESPIRITUALIDADE', NULL, NULL, '272', 'pt-BR', NULL, 'Geral');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1107', '1', '1', 'Allan Kardec', '2026-04-22 02:24:32.594157', '2026-04-26 02:24:32.594157', '0', 'NOVO', '["https://books.google.com/books/content?id=-N0zDwAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788584850495', '269.3', NULL, NULL, 'Periódico mensal, a Revista Espírita: Jornal de Estudos Psicológicos circulou pela primeira vez em Paris no dia 1º de janeiro de 1858 e foi publicada sob a responsabilidade direta de Allan Kardec até a sua desencarnação em 31 de março de 1869. Kardec transformou-a numa espécie de tribuna livre, na qual sondava a reação dos homens e a impressão dos Espíritos acerca de determinados assuntos, ainda hipotéticos ou mal compreendidos, enquanto lhes aguardava a confirmação, utilizando o critério da concordância e da universalidade do ensino dos Espíritos. Inúmeros capítulos dos livros básicos da Codificação, na íntegra ou com pequenas modificações, vieram à luz por meio da Revista Espírita. Pelas suas páginas admiráveis, desfilam os assuntos mais diversos, desde a fenomenologia mediúnica nos seus variados matizes, até as dissertações da mais pura moral evangélica, a vida no Mundo Espiritual, a sorte futura reservada aos que praticam e aos que não praticam o bem, a justiça da reencarnação, a b', 'Revista espírita: ano oitavo: 1865', NULL, NULL, '219', 'pt-BR', NULL, 'Religion');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1108', '1', '1', 'Ricardo Max', '2025-11-18 02:24:32.594157', '2025-11-23 02:24:32.594157', '0', 'OTIMO', '["https://books.google.com/books/content?id=6-8ytAEACAAJ&printsec=frontcover&img=1&zoom=1&source=gbs_api"]', '9781521737774', '85.08', NULL, NULL, 'Este livro fala sobre fé, espiritualidade e sobre o poder das autoafirmações e dos gatilhos mentais que podem ser acessados e que podem ajudar aqueles solteirões e solteironas que estão com os caminhos fechados para o amor. As palavras exercem poder sobre o cérebro humano e também é uma potência espiritual que faz materializar nossos pensamentos. Podemos restaurar casamentos, abrir portas fechadas para o amor e curar sentimentos e dores da alma. Este livro é para quem tem fé, acredita que tudo é possível, mesmo em meio a todas as contradições, trazer seu amor de volta, são para aqueles que não desistem.', 'Gatilhos Mentais Do Amor', NULL, NULL, '200', 'pt-BR', NULL, 'Religion');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1109', '1', '1', 'Jopeu', '2025-11-07 02:24:32.594157', '2025-11-12 02:24:32.594157', '0', 'OTIMO', '["https://books.google.com/books/content?id=zcKDEAAAQBAJ&printsec=frontcover&img=1&zoom=1&source=gbs_api"]', '9788554044206', '258.78', NULL, NULL, 'A humanidade tem dois caminhos. Ou consegue crescer, ou se autodestrói. Após escrever o livro, ao revisar, percebi que seria a espiritualidade que o sistema comunista precisa. Neste escrito estão as bases reais filosóficas sem religião, e com bases na ciência, que poderia causar o crescimento consciente para nossa humanidade.', 'Espiritualidade Real Para A Humanidade', NULL, NULL, '405', 'pt-BR', NULL, 'Religion');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1110', '1', '1', 'José Luis Méndez ', '2026-02-15 02:24:32.594157', '2026-02-16 02:24:32.594157', '0', 'DESGASTADO', '["https://books.google.com/books/content?id=WVZFAwAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9786074624670', '357.06', NULL, NULL, 'A setenta años de su fundación, El Colegio de México publica esta serie de dieciséis volúmenes, titulada Los grandes problemas de México, en la que se analizan los mayores retos de la realidad mexicana contemporánea, con el fin de definir los desafíos que enfrentamos en el siglo XXI y proponer algunas posibles respuestas y estrategias para resolver nuestros problemas como nación. Serie: Los grandes problemas de México. Vol. XIII Políticas públicas, está dividido en cuatro partes, que abordan desde diversos ángulos la naturaleza y capacidad del Estado mexicano para formular e implementar las políticas públicas. La primera trata aspectos del marco institucional de las políticas públicas, como las relaciones entre el Ejecutivo y el Legislativo, la evolución del tamaño y naturaleza del Estado, la planeación y la evaluación. La segunda se enfoca en las políticas de modernización y el estado general de la administración pública federal centralizada. La tercera incluye capítulos sobre algunas', 'Los grandes problemas de México. Políticas públicas. T-XIII', NULL, NULL, '174', 'en', NULL, 'Social Science');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1111', '1', '1', 'Leonardo  Secchi, Cesar N. Cruz-Rubio', '2026-05-01 02:24:32.594157', '2026-05-03 02:24:32.594157', '0', 'RUIM', '["https://books.google.com/books/content?id=EjRnEQAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9781035310197', '244.05', NULL, NULL, 'Bringing together an array of recognized scholars and practitioners from the region and beyond, this Handbook provides a comprehensive overview of public policy research in Latin America. It showcases diverse perspectives on the policymaking process, from historical, descriptive and prescriptive approaches to critical and feminist analyses.', 'Handbook of Public Policy in Latin America', NULL, NULL, '61', 'en', NULL, 'Political Science');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1112', '1', '1', 'José Antonio Lucero', '2026-01-26 02:24:32.594157', '2026-01-29 02:24:32.594157', '0', 'NOVO', '["https://books.google.com/books/content?id=NzTs-S2XcuUC&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9780822973454', '260.3', NULL, NULL, 'Over the last two decades, indigenous populations in Latin America have achieved a remarkable level of visibility and political effectiveness, particularly in Ecuador and Bolivia. In Struggles of Voice, Jose Antonio Lucero examines these two outstanding examples in order to understand their different patterns of indigenous mobilization and to reformulate the theoretical model by which we link political representation to social change. Building on extensive fieldwork, Lucero considers Ecuador''s united indigenous movement and compares it to the more fragmented situation in Bolivia. He analyzes the mechanisms at work in political and social structures to explain the different outcomes in each case. Lucero assesses the intricacies of the many indigenous organizations and the influence of various NGOs to uncover how the conflicts within social movements, the shifting nature of indigenous identities, and the politics of transnationalism all contribute to the success or failure of political m', 'Struggles of Voice', NULL, NULL, '218', 'en', NULL, 'Political Science');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1113', '1', '1', 'Fernando Blanco', '2026-04-21 02:24:32.594157', '2026-04-26 02:24:32.594157', '0', 'OTIMO', '["https://books.google.com/books/content?id=ABXZDwAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9789563960907', '201.58', NULL, NULL, 'Tres editores y una docena de autoras y autores se entregan en este libro a pensar el amor y sus cruces callejeros, académicos e históricos. Amores Iguales, parafraseando a David Leavitt que tejen su memoria de persecuciones entremezclada con la higiene, el credo religioso, el control estatal hasta el propio encierro en un armario que hoy es escenario de consagración política y normalización.', 'Políticas del amor', NULL, NULL, '263', 'es', NULL, 'Literary Collections');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1114', '1', '1', 'Adrian Albala, Alejandro Natal', '2025-06-09 02:24:32.594157', '2025-06-10 02:24:32.594157', '0', 'BOM', '["https://books.google.com/books/content?id=XWLMEAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9783031339141', '110.71', NULL, NULL, 'This book presents a comparative analysis of the struggles of Latin American indigenous peoples for effective representation in national political systems in the region. Through a detailed exploration of the political dynamics of indigenous groups and examples of mechanisms of political representation, the studies in this book reveal how power relations, cleavages and indigenous civil society organizations are essential to our understanding of indigenous political participation. These studies closely inspect how collective action builds up at local level in grassroots organizations, and how it then articulates or not with larger mechanisms of regional and national political representation, providing a more comprehensive and comparative assessment of why and when representation works and fails for indigenous people. This contributed volume is organized around one general and comparative chapter on indigenous political representation in Latin America followed by eight case studies, divid', 'Indigenous Political Representation in Latin America', NULL, NULL, '196', 'en', NULL, 'Social Science');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1115', '1', '1', 'D. Altschuler, J. Corrales', '2025-07-27 02:24:32.594157', '2025-07-30 02:24:32.594157', '0', 'BOM', '["https://books.google.com/books/content?id=HCawAgAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9781137271846', '371.65', NULL, NULL, 'To what extent does participation in one particular domain of public life lead to wider participation in other areas? Through the use of an unprecedented survey supported by case studies this book explores how participatory governance in community-managed schools can alter the civic and political behaviour of participants.', 'The Promise of Participation', NULL, NULL, '21', 'en', NULL, 'Social Science');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1116', '1', '1', 'Irene DELGADO SOTILLOS, Lourdes LÓPEZ NIETO', '2025-07-13 02:24:32.594157', '2025-07-14 02:24:32.594157', '0', 'RUIM', '["https://books.google.com/books/content?id=YPk36rNyRC8C&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788436262209', '295.69', NULL, NULL, 'Este libro reúne textos que pueden ser fundamentales para conocer y analizar la democracia representativa así como los actores fundamentales que intervienen en la misma además de las reglas y los procesos del juego democrático. Para ello se han seleccionado textos considerados seminales de los diferentes enfoques que forman el desarrollo de la Ciencia Política durante el siglo XX.', 'Actores y comportamiento político', NULL, NULL, '9', 'es', NULL, 'Political Science');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1117', '1', '1', 'Jailson Rodrigo Pacheco', '2026-05-15 02:24:32.594157', '2026-05-17 02:24:32.594157', '0', 'BOM', '["https://books.google.com/books/content?id=0lzLEQAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9786558213727', '284.88', NULL, NULL, 'Adquirindo este produto, você receberá o livro e também terá acesso às videoaulas, através de QR codes presentes no próprio livro. Ambos relacionados ao tema para facilitar a compreensão do assunto e futuro desenvolvimento de pesquisa. Este material contém todos os conteúdos necessários para o seu estudo, não sendo necessário nenhum material extra para a compreensão do conteúdo especificado. Confira abaixo a ementa desta disciplina, os temas que serão abordados e demais informações: Autor Jailson Rodrigo Pacheco Conteúdos abordados: Conceitos básicos. História da sociedade e seus impactos no meio ambiente. Conferências internacionais e nacionais sobre o meio ambiente. Princípios, objeto e características da legislação ambiental brasileira. Políticas públicas ambientais. Meio ambiente e ecologia. Importância da consciência ambiental e da preocupação com o meio ambiente. Reciclagem e sustentabilidade. Gestão de resíduos sólidos. Recursos naturais e produção de energia sustentável. Papel ', 'Meio Ambiente, Desenvolvimento e Sustentabilidade', NULL, NULL, '327', 'pt-BR', NULL, 'Education');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1118', '1', '1', 'Eliezio Nascimento Barboza, Francisco das Chagas Bezerra Neto', '2026-03-13 02:24:32.594157', '2026-03-15 02:24:32.594157', '0', 'BOM', '["https://books.google.com/books/content?id=pmtbEAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9786599630675', '202.6', NULL, NULL, 'O livro, “Meio Ambiente e Sustentabilidade: Uma Abordagem Interdisciplinar”, realiza uma análise crítica dos fatos que cercam a esfera ambiental, sobretudo no que tange à utilização de recursos naturais e os impactos negativos ao meio ambiente devido ao crescimento das cidades. Nesta senda, salienta-se que esta obra possui uma perspectiva prática e bibliográfica, que visa trazer reflexões presentes no cotidiano do brasileiro no que se refere à esfera ambiental, apresentando-se epistemologicamente para a concretização de uma sociedade preocupada com as causas ambientais e que, de fato, contribua nos assuntos pertinentes à sustentabilidade, no âmbito prático, teórico, crítico e analítico. Em atendimento aos objetivos propostos, a construção metodológica deste livro é caracterizada por estudo de casos e uma fundamentada revisão bibliográfica. As pesquisas possuem caráter exploratório e descritivo quanto aos fins, bem como uma abordagem cuja natureza é qualitativa quanto aos meios. Organiz', 'Meio Ambiente e Sustentabilidade: Uma Abordagem Interdisciplinar', NULL, NULL, '420', 'pt-BR', NULL, 'Nature');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1119', '1', '1', 'Yáscara Maia Araújo de Brito, Higor Costa de Brito', '2026-01-12 02:24:32.594157', '2026-01-14 02:24:32.594157', '0', 'NOVO', '["https://books.google.com/books/content?id=kcOuEAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9786553810907', '321.48', NULL, NULL, 'Para tentar mitigar ou eliminar os impactos negativos causados, sobretudo em se tratando de meio ambiente, entre o final do século XX e início do século XXI, surgiram os conceitos de gestão ambiental e desenvolvimento sustentável. Tais conceituações não buscam a conservação ambiental em detrimento do desenvolvimento da economia e do aumento dos problemas sociais, mas defende que haja um equilíbrio entre os três pilares. Para tanto, são retratados nesta coletânea mais de 30 capítulos voltados para o diagnóstico das condições ambientais na atualidade, que demonstram o quanto as ações antrópicas estão modificando o meio, com poucas ações que visam à preservação deste. Em contrapartida, são apresentadas tecnologias que, se aplicadas em larga escala, tendem a reduzir drasticamente os impactos na exploração de recursos ambientais como também nos níveis de poluição causados. Tais tecnologias, quando aliadas à uma gestão ambiental eficiente por parte dos tomadores de decisão, tendem a alcançar', 'Meio ambiente e sustentabilidade: pesquisas, reflexões e diálogos emergentes', NULL, NULL, '9', 'pt-BR', NULL, 'Nature');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1120', '1', '1', 'Sônia Regina da Cal Seixas, João Luiz de Moraes Hoefel', '2025-11-15 02:24:32.594157', '2025-11-17 02:24:32.594157', '0', 'BOM', '["https://books.google.com/books/content?id=ToI0EAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9781000416381', '332.49', NULL, NULL, 'United Nations 2030 Agenda for Sustainable Development 17 Goals blends the three dimensions of sustainable development: economic, social and environmental. They function as commitments to be met by governments, civil society and the private sector for a 2030 collaborative project. The five keywords to achieve it are: People, Planet, Prosperity, Peace, and Partnerships. Another reading is to link these precepts with the Universal Declaration of Human Rights because to obtain real development we need full realization of human rights. This book analyses Sustainable Development considering Sustainable Development Goals, their importance concerning human rights and its significance for a Sustainable Society.', 'Environmental Sustainability', NULL, NULL, '121', 'en', NULL, 'Business & Economics');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1121', '1', '1', 'Walter Leal Filho', '2026-01-06 02:24:32.594157', '2026-01-07 02:24:32.594157', '0', 'DESGASTADO', '["https://books.google.com/books/content?id=E3o4DwAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9783319630076', '123.05', NULL, NULL, 'This multidisciplinary handbook explores concrete case studies which illustrate how sustainability science and research can contribute to the realization of the goals of the 2030 Agenda for Sustainable Development. It contains contributions from sustainability researchers from across the world.', 'Handbook of Sustainability Science and Research', NULL, NULL, '298', 'en', NULL, 'Science');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1122', '1', '1', 'André Henrique Rosa | Leonardo F. Fraceto | Viviane Moschini-Carlos', '2025-10-11 02:24:32.594157', '2025-10-13 02:24:32.594157', '0', 'RUIM', '["https://books.google.com/books/content?id=Zj4DiVHXtIQC&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788540701977', '187.28', NULL, NULL, 'Este é um livro especial e são quatro as características que o fazem assim. Abrangente: nenhum assunto importante dentre as questões ambientais que preocupam a humanidade foi esquecido. Rigor científico: autores com reconhecida experiência na área, como professores e pesquisadores Comprometido com sustentabilidade: trata da busca de soluções para os problemas ambientais que também sejam economicamente eficientes e socialmente justas. Didático: qualidade nem sempre encontrada em textos com a densidade científica deste livro', 'Meio Ambiente e Sustentabilidade', NULL, NULL, '388', 'pt-BR', NULL, 'Technology & Engineering');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1123', '1', '1', 'Higor Costa de Brito, Manoel Mariano Neto da Silva', '2025-08-18 02:24:32.594157', '2025-08-22 02:24:32.594157', '0', 'BOM', '["https://books.google.com/books/content?id=mf4_EAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9786588332481', '381.76', NULL, NULL, 'Devido às modificações no comportamento humano, em especial na maneira de produzir e consumir bens, nota-se uma série de modificações ambientais, das quais se destacam a intensificação da poluição ambiental, o esgotamento dos recursos naturais e consequente degradação dos ecossistemas, a ampliação dos conflitos e desigualdade social, além do aumento progressivo das temperaturas do planeta. Ao tratar do Brasil, esta crise sanitária, deflagrada globalmente, é impulsionada pela crise política. Desta maneira, as políticas ambientais e sociais são gradualmente corroídas, culminando em graves retrocessos. Dentre os fatores mais relevantes, pode-se citar a invasão de terras indígenas, a expansão das atividades de mineração desenvolvidas de ilegalmente, violações às leis ambientais e aos direitos humanos, perdas da qualidade de vida e o aumento do desmatamento. Tais questões, por sua vez, exigem da sociedade, em especial daqueles que desenvolvem a ciência, críticas e soluções para o enfrentame', 'Meio ambiente e sustentabilidade: pesquisa, reflexões e diálogos emergentes', NULL, NULL, '328', 'pt-BR', NULL, 'Nature');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1124', '1', '1', 'Michael Ashby, Kara Johnson', '2025-11-11 02:24:32.594157', '2025-11-16 02:24:32.594157', '0', 'RUIM', '["https://books.google.com/books/content?id=hCspDwAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788535268270', '79.03', NULL, NULL, 'Este livro explora o papel dos materiais e da fabricação no design de produtos, dando ênfase particular ao modo como a materialidade de um objeto (do que ele é feito e como é feito) pode ser manipulada para criar estética e funcionalidade de um produto. Seus autores se preocuparam igualmente com questões relacionadas à viabilidade de produção e à sustentabilidade de um sistema. Os métodos apresentados aqui são apoiados por cerca de 100 perfis de materiais e processos de fabricação que dão ênfase aos atributos mais relevantes para o design de produtos.', 'Materiais e design', NULL, NULL, '446', 'en', NULL, 'Technology & Engineering');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1125', '1', '1', 'Cleber Bianchessi', '2026-04-14 02:24:32.594157', '2026-04-17 02:24:32.594157', '0', 'BOM', '["https://books.google.com/books/content?id=oqalEQAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9786553686748', '359.04', NULL, NULL, 'Esta coletânea promove a articulação fundamental entre a base teórica e a evidência empírica no domínio abrangente da Sustentabilidade, Meio Ambiente e Ecologia. Congrega um conjunto robusto de investigações interdisciplinares, cujo escopo transcende a compartimentação para focar na interconexão sistêmica das temáticas ambientais. Em uma vertente aplicada, o volume apresenta pesquisas ecológicas e pedagógicas, que vão desde estudos de biomassa em ecossistemas específicos até práticas educacionais inovadoras para a educação infantil. Adicionalmente, são exploradas análises setoriais, incluindo a aplicação de princípios de sustentabilidade na inovação de produtos e uma crítica à noopolítica do consumo e do ecopoder nas unidades de conservação. Este volume constitui, portanto, uma referência essencial para a comunidade acadêmica e formuladores de políticas, visando aprofundar a compreensão dos constructos teóricos e a capacidade de aplicação prática para o avanço da governança e da ação e', 'SUSTENTABILIDADE, MEIO AMBIENTE E ECOLOGIA: Teoria e Prática – Vol. 3', NULL, NULL, '376', 'pt-BR', NULL, 'Antiques & Collectibles');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1126', '1', '1', 'R. Setchi, R.J. Howlett', '2026-03-19 02:24:32.594157', '2026-03-22 02:24:32.594157', '0', 'OTIMO', '["https://books.google.com/books/content?id=6wRiCAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9780956151650', '137.56', NULL, NULL, '', 'Sustainable Design and Manufacturing 2014 Part 1', NULL, NULL, '64', 'en', NULL, 'Geral');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1127', '1', '1', 'Luciana Stocco Betiol, Thiago Hector Kanashiro Uehara', '2025-11-01 02:24:32.594157', '2025-11-03 02:24:32.594157', '0', 'DESGASTADO', '["https://books.google.com/books/content?id=w2pfDAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788587426314', '157.48', NULL, NULL, '“It''s a fight against time." That is how the book begins, presenting a historical background of how the topic of sustainable production and consumption was included in the global agenda and reached Brazil. It is clear in the work who and what the potential actors and instruments that interact for that purpose are. In a fun way, thematic infographics show the impact from consumption and production, inspired by Life Cycle Assessment (LCA). In Chapters 2 and 3, readers will find inspiring examples of institutional procurement collected through exclusive interviews, news articles, corporate reports and scientific articles describing successful experiences in the public and private sectors, highlighting which institutions broke the resistance and became protagonists in the use of transformation potential through sustainable consumption and production. In Chapter 4, under a guidance perspective, two tools are recommended for continuously improving management of public and business procuremen', 'Sustainable procurement', NULL, NULL, '474', 'en', NULL, 'Political Science');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1128', '1', '1', 'Ana Carolina Baggio Fabricio', '2025-07-24 02:24:32.594157', '2025-07-25 02:24:32.594157', '0', 'NOVO', '["https://books.google.com/books/content?id=UqhWEQAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788544301111', '275.1', NULL, NULL, 'O turismo é uma atividade dinâmica e vem se tornando foco de discussões sobre sua influência nos ambientes, na vida das pessoas afetadas e também como prática que assume uma perspectiva econômica voltada à promoção da sustentabilidade. Nesse sentido, este livro atinge todos os lados dessa problemática, mostrando como foi a evolução do tratamento dado ao meio ambiente desde o século XX até hoje, passando pela legislação atual e a política de meio ambiente, que determina restrições de uso e busca promover a sustentabilidade dos ecossistemas. A autora discute também a educação ambiental como possibilidade de modificação da perspectiva exploratória sobre o ambiente, a qual já foi muito mais preocupante e vem se modificando gradualmente. A obra trata, ainda, de como se pode organizar o turismo em áreas naturais com vistas à sustentabilidade, propondo sistemas de gestão ambiental como soluções possíveis para a resolução do dilema entre exploração e uso sustentável e analisando as perspectiva', 'Turismo, meio ambiente e sustentabilidade', NULL, NULL, '395', 'pt-BR', NULL, 'Business & Economics');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1129', '1', '1', 'Zélia M. Bora, Animesh Roy', '2025-08-20 02:24:32.594157', '2025-08-22 02:24:32.594157', '0', 'BOM', '["https://books.google.com/books/content?id=3kzUEAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9781793654052', '330.92', NULL, NULL, 'An Ibero-American Perspective on Narratives of Pandemics is a critique of the realities of the pandemic in the Ibero-American world and its intertwined relationship with the environment. Through a critical gaze into the history of the region as it has evolved through periods of socio-environmental and cultural conflicts, the book chronicles multiple experiences of how people managed to negotiate multiple crises on a daily basis by often clinging to their age old cultural and healing practices, as well as the humanistic representation of such experiences in various fictional and nonfictional writings. The contributors expose the biopolitics around COVID-19 and its effects particularly on marginalised populations and the environment in an effort to consider the complexity of the pandemic in its multiple dimensions. They evaluate it through climatic, socioeconomic, political, scientific, and cultural lenses that they argue shaped the realities of the pandemic. They also take a close look ', 'An Ibero-American Perspective on Narratives of Pandemics', NULL, NULL, '431', 'en', NULL, 'Nature');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1130', '1', '1', 'EDITORA CRV', '2026-03-12 02:24:32.594157', '2026-03-17 02:24:32.594157', '0', 'NOVO', '[]', '9788544409428', '264.98', NULL, NULL, 'Em ensaios sobre espaço, meio ambiente, susten ilidade e educação, Eduardo Pimentel Menezes e estudiosos do grupo de pesquisa Tecnologias de comunicação e informação no mundo contemporâneo elaboram diálogos através das suas reflexões produzidas pelas suas pesquisas nos últimos anos das relações espaciais e ambientais.', 'ENSAIOS SOBRE O MEIO AMBIENTE, SUSTENTABILIDADE E', NULL, NULL, '105', 'pt-BR', NULL, 'Geral');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1131', '1', '1', 'Patricio Peralta-Zamora', '2025-11-21 02:24:32.594157', '2025-11-22 02:24:32.594157', '0', 'RUIM', '["https://books.google.com/books/content?id=P5W-EAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9786525041810', '396.93', NULL, NULL, 'Nos últimos 50 anos não se falou de outra coisa. A exacerbada exploração dos recursos naturais e as contínuas agressões associadas às diversas atividades humanas comprometem a saúde do planeta e da população. Sem dúvida, o crescimento da população, a intensificação do consumo, o descompromissado gerenciamento dos resíduos produzidos nas grandes cidades e no meio industrial e a aparente apatia da população favorecem o descaminho do planeta, o que faz com que a ocorrência de catástrofes ambientais seja apenas uma questão de tempo. Objetivando interromper a caminhada em direção à autodestruição, especialistas criaram o conceito de sustentabilidade, segundo o qual existe uma imperiosa necessidade de se compatibilizar aspectos econômicos, sociais e ambientais, de maneira a viabilizar um desenvolvimento que preserve o meio ambiente e garanta o bem-estar da população. O livro Sustentabilidade, igualdade social e outros devaneios traz argumentos que mostram que a sustentabilidade não passa de ', 'Sustentabilidade Ambiental, Igualdade Social e Outros Devaneios', NULL, NULL, '340', 'pt-BR', NULL, 'Science');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1132', '1', '1', 'Charles C. Mueller', '2026-03-09 02:24:32.594157', '2026-03-10 02:24:32.594157', '0', 'BOM', '[]', '9788523008505', '282.08', NULL, NULL, 'Parte I- A economia e a questão ambiental: crescimento, desenvolvimento e meio ambiente; Elementos básicos da questão ambiental; Gênese da disciplina economia do meio ambiente; As principais correntes de pensamento da disciplina do meio ambiente; Parte II- Bases conceituais da avaliação das principais escolas da economia do meio ambiente: uma abordagem sistêmica das relações entre a economia e o meio ambiente; O processo produtivo e o meio ambiente; Sustentabilidade, capital natural e capital produzido; Parte III- A economia ambiental neoclássica: origens, natureza e ramificação da economia neoclássica; Alicerce conceitual da teoria neoclássica da poluição; A poluição de fluxo; A poluição de estoque; Políticas sugeridas pela teoria neoclássica da poluição; Uma avaliação crítica da teoria neoclássica da poluição; Dois ramos da teoria neoclássica dos recursos naturais ; A abordagem neoclássica da teoria dos recursos narurais não-renováveis;Avaliação do otimismo neoclássico em face da pos', 'Os economistas e as relações entre o sistema econômico e o meio ambiente', NULL, NULL, '377', 'pt-BR', NULL, 'Environmental policy');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1133', '1', '1', 'Arnaldo Niskier', '2025-11-01 02:24:32.594157', '2025-11-05 02:24:32.594157', '0', 'RUIM', '["https://books.google.com/books/content?id=rgdEDwAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788582051696', '259.02', NULL, NULL, 'A nossa civilização está às voltas com o desafio de conciliar a sustentabilidade ambiental com o crescimento populacional acelerado, e o desenvolvimento econômico que demanda cada vez mais dos recursos naturais disponíveis. Com cidades cada vez mais populosas, a industrialização ainda mais intensa e o consumo sempre crescente, torna-se urgente reformular hábitos e valores, para garantir a qualidade de vida das futuras gerações. Em Educação e Sustentabilidade, Arnaldo Niskier faz uma reflexão sobre a importante contribuição da educação na formação de uma consciência ambiental nos jovens, e o seu papel transformador na sociedade.', 'Sustentabilidade e Educação', NULL, NULL, '109', 'pt-BR', NULL, 'Business & Economics');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1134', '1', '1', 'Ronei Vilmar Baron', '2025-12-23 02:24:32.594157', '2025-12-26 02:24:32.594157', '0', 'NOVO', '["https://books.google.com/books/content?id=Qd82EAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9786525200880', '260.35', NULL, NULL, 'O auge do capitalismo, antevisto por Marx e Engels e propulsionado pelos avanços tecnológicos das últimas décadas, acarretou, principalmente no final do século XX e início do século XXI, um novo fenômeno denominado de transnacional, por meio do qual impõe-se aos Estados-Nações a necessidade de repensar sua soberania em relação aos demais, uma vez que as características dos direitos de terceira geração, também chamados de novos direitos, não delimitam indivíduos nem possuem fronteiras. Essas características acarretaram demandas transnacionais que influenciam na vida de todos os cidadãos do Planeta e para serem reguladas exigem a relativização da soberania do Estado Constitucional Moderno em benefício de uma regulação transnacional. Esta readaptação perpassa pela sustentabilidade como o novo paradigma indutor do direito, juntamente com a liberdade. Apenas um novo paradigma guiado pela questão vital ambiental poderá enfrentar essas novas demandas transnacionais e garantir às presentes e f', 'A Transnacionalização dos Crimes Ambientais para Efetividade da Sustentabilidade do Meio Ambiente', NULL, NULL, '312', 'pt-BR', NULL, 'Law');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1135', '1', '1', 'Moreira de Acopiara', '2026-03-02 02:24:32.594157', '2026-03-06 02:24:32.594157', '0', 'NOVO', '["https://books.google.com/books/content?id=WqHREAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9786550970918', '179.12', NULL, NULL, 'O poeta Moreira de Acopiara traz a sustentabilidade e a preservação do meio ambiente para o contexto do cordel, unindo a abordagem poética da tradição oral e a cultura popular para tornar as questões mais envolventes e auxiliar a despertar a consciência e o engajamento em relação às causas ambientais.', 'Cordel da sustentabilidade', NULL, NULL, '239', 'pt-BR', NULL, 'Juvenile Fiction');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1136', '1', '1', 'Joaquim Carlos (Organizador) Gadelha, Regina Maria A. Fonseca (Organizador), Racy', '2025-06-06 02:24:32.594157', '2025-06-11 02:24:32.594157', '0', 'BOM', '[]', '9788547315320', '216.91', NULL, NULL, 'Sustentabilidade Global e Realidade Brasileira tem como objetivo a análise teórica e política dos problemas do meio ambiente, no âmbito brasileiro e internacional. O livro tem como marco fundamental a publicação da Encíclica Laudato Si’, em que o papa Francisco assumiu um importante posicionamento no campo das relações internacionais, ao propor e defender uma nova forma de condução das questões relativas à sustentabilidade planetária e ao desenvolvimento da humanidade, a um só tempo resgatando categorias afastadas dos debates acerca da ordem internacional e conferindo à Igreja Católica um novo e benéfico protagonismo na lida com as negociações ambientais internacionais. Na primeira parte do livro – Globalização, Política, Sustentabilidade e Meio Ambiente –, o texto traz para o leitor um apanhado das tratativas internacionais sobre os problemas ambientais a partir da Agenda 21 até a Encíclica, e analisa seu papel na discussão teórica e nas negociações dos interesses relativos ao meio am', 'Sustentabilidade global e realidade brasileira', NULL, NULL, '328', 'pt-BR', NULL, 'Nature');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1137', '1', '1', 'GK Hall, Thomson Gale', '2026-04-24 02:24:32.594157', '2026-04-27 02:24:32.594157', '0', 'RUIM', '["https://books.google.com/books/content?id=UR7hAAAAMAAJ&printsec=frontcover&img=1&zoom=1&source=gbs_api"]', '9780783896526', '173.8', NULL, NULL, '', 'Bibliographic Guide to Government Publications 2001', NULL, NULL, '262', 'en', NULL, 'Political Science');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1138', '1', '1', 'Matheus Silva de Gregori', '2025-10-18 02:24:32.594157', '2025-10-22 02:24:32.594157', '0', 'NOVO', '["https://books.google.com/books/content?id=yARsEAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9786525021638', '284.19', NULL, NULL, 'A política ambiental brasileira, na qualidade de lei e política pública, disponibiliza ao Estado um arcabouço de instrumentos para balizar as atividades e práticas dos indivíduos e da coletividade, norteando-os aos imperativos da sustentabilidade. Além das vias repressivas, há normas de caráter promocional, que pretendem incentivar, por meio de sanções positivas, práticas benéficas ao meio ambiente e à sustentabilidade: são instrumentos econômicos de política ambiental. Esta obra aborda um instrumento em específico que tem sido alvo tanto de críticas como de aprovações, os chamados "Pagamentos por Serviços Ambientais", desde o seguinte problema: é possível afirmar que os sistemas de Pagamento por Serviços Ambientais são apenas mecanismos de mercado para facilitar o cumprimento das leis ambientais ou, caso estruturados como programas derivados de políticas públicas, também representam um instrumento estatal de efetiva promoção da sustentabilidade socioambiental? Para enfrentar a problem', 'Sistema de Pagamento por Serviços Ambientais como Instrumento de Promoção da Sustentabilidade Socioambiental no Brasil', NULL, NULL, '378', 'pt-BR', NULL, 'Law');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1139', '1', '1', 'Luiz Antônio Abdalla de Moura', '2026-04-26 02:24:32.594157', '2026-04-28 02:24:32.594157', '0', 'RUIM', '["https://books.google.com/books/content?id=AEutEAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9786556752556', '301.23', NULL, NULL, 'Este livro, preparado visando subsidiar o curso de "Sistemas de Gestão Ambiental" do Programa de Educação Continuada da Escola Politécnica da USP, teve a sua primeira edição lançada em 1988. Ele discute importantes temas da atualidade, visando auxiliar profissionais e empresas a melhorarem o seu desempenho ambiental, com aplicações de técnicas de sustentabilidade. Inicialmente é apresentada a evolução da questão ambiental desde os anos 1950 até o presente, com os principais fatos motivadores de mudanças de postura, os principais acidentes com grandes repercussões ambientais, os impactos ambientais mais relevantes, como o aquecimento global, os acordos internacionais e outros fatos históricos. Conhecendo-se o passado recente e a evolução havida é possível vislumbrar um pouco melhor o futuro. São discutidas algumas razões que justificam os esforços de uma organização para melhorar o seu desempenho ambiental. Também são apresentadas as Normas da família ISO 14000, muito importantes para a', 'Qualidade e Gestão Ambiental', NULL, NULL, '43', 'pt-BR', NULL, 'Technology & Engineering');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1140', '1', '1', 'Hugo Antunes Rodrigues', '2025-11-10 02:24:32.594157', '2025-11-13 02:24:32.594157', '0', 'RUIM', '["https://books.google.com/books/content?id=k3NdEAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9786525228785', '133.45', NULL, NULL, 'Uma obra que trata, com descortino, de tema que há de preocupar a civilização caso pretendamos, como promete por nós o art. 225 da CF, assegurar um ambiente ecologicamente equilibrado para as gerações futuras. O autor, Hugo, ao perseguir o grau acadêmico de mestre no Curso de Mestrado em Direito, sob minha avaliação, como seu orientador, atendeu à expectativa de pesquisar o caráter fundamental do direito ao saneamento básico com a reserva do possível, esta que parece embaçar toda política pública voltada à realização dos direitos econômicos, sociais, culturais e ambientais. Ao fazê-lo, Hugo elegeu como marcos teóricos aqueles que gravitam em torno do sentido e alcance do postulado da dignidade da pessoa humana, tendo olhos fitos no princípio da sustentabilidade e, nessa exata medida, no modo como a ONU vem de emprestar significado ao obj. n. 6 do Desenvolvimento Sustentável da Agenda 2030, ODS que enche a humanidade de esperança quanto à universalidade do direito a "água potável e sane', 'Princípio do Mínimo Existencial e Sustentabilidade das Políticas Públicas do Meio Ambiente com ênfase no saneamento básico', NULL, NULL, '166', 'pt-BR', NULL, 'Law');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1141', '1', '1', 'Banco Nacional de Desenvolvimento Econômico e Social (Brazil), Centro de Gestão e Estudos Estratégicos (Brazil)', '2026-04-12 02:24:32.594157', '2026-04-16 02:24:32.594157', '0', 'DESGASTADO', '["https://books.google.com/books/content?id=c-dJjmkRnlcC&printsec=frontcover&img=1&zoom=1&source=gbs_api"]', '9788587545275', '301.03', NULL, NULL, '', 'Sugarcane-based Bioethanol', NULL, NULL, '78', 'en', NULL, 'Alcohol as fuel');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1142', '1', '1', 'José Daltro Filho, Maria José Nascimento Soares', '2026-02-23 02:24:32.594157', '2026-02-27 02:24:32.594157', '0', 'RUIM', '[]', '9788561638221', '247.85', NULL, NULL, '', 'Meio ambiente, sustentabilidade e saneamento', NULL, NULL, '320', 'pt-BR', NULL, 'Sanitation');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1143', '1', '1', 'Adriana Camargo Pereira, Gibson Zucca da Silva', '2026-03-11 02:24:32.594157', '2026-03-13 02:24:32.594157', '0', 'OTIMO', '[]', '9788502151420', '329.69', NULL, NULL, 'Este livro aborda diversos temas referentes às mudanças climáticas, passando por assuntos como os fundamentos de sustentabilidade, a nova economia, empresas responsáveis socialmente, o surgimento de empregos verdes, dentre outros.', 'Sustentabilidade, responsabilidade social e meio ambiente', NULL, NULL, '65', 'pt-BR', NULL, 'Environmental management');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1144', '1', '1', 'Mey Silva, Simone da Silva', '2025-06-28 02:24:32.594157', '2025-07-03 02:24:32.594157', '0', 'DESGASTADO', '["https://books.google.com/books/content?id=n6y6EAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9786553552982', '139.12', NULL, NULL, 'Este gibi foi desenvolvido no contexto interdisciplinar da Educação Ambiental na linha de pesquisa em Energia e Meio Ambiente do Curso de Mestrado Profissional do Programa de Pós-Graduação em Engenharia, Gestão de Processos, Sistemas e Ambiental do Instituto de Tecnologia e Educação Galileo da Amazônia – ITEGAM com crianças de 6 a 7 anos de idade matriculadas no 1o ano do Ensino Fundamental da Educação Básica de uma escola pública urbana da rede municipal de ensino localizada na Zona Sul da cidade de Manaus. O gibi intitulado "OS PROTETORES DO MEIO AMBIENTE – LIXO OU RESÍDUO SÓLIDO?" teve por objetivo desenvolver a leitura de mundo, a leitura da história em quadrinhos e sensibilizar os estudantes do 1o ano do Ensino Fundamental para um tema em evidência na sociedade: os 3Rs (três erres) e a preservação do meio ambiente. Esse tema foi escolhido com base no fato de que as crianças podem interagir sensivelmente, engajando-se em discussões sobre o meio ambiente, sustentabilidade e responsa', 'Os protetores do meio ambiente', NULL, NULL, '277', 'pt-BR', NULL, 'Nature');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1145', '1', '1', 'Ricardo Ribeiro Alves', '2025-06-20 02:24:32.594157', '2025-06-22 02:24:32.594157', '0', 'DESGASTADO', '["https://books.google.com/books/content?id=Ur9rEAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9786559250448', '101.55', NULL, NULL, 'A solução para a problemática ambiental passa pela responsabilidade das empresas em buscar fontes de matérias-primas renováveis, fabricar produtos utilizando energias limpas e cujos resíduos possam ser assimilados pelo meio ambiente. A responsabilidade ambiental também passa pela educação e consciência das pessoas. Se as empresas poluem o meio ambiente com seus produtos tão necessários à vida moderna é porque existe o consumidor que os adquire e não questiona a sua procedência. Um mediador entre as empresas e as pessoas na questão do consumo social e ambientalmente responsável é o governo. Por meio de leis e regulamentações, o Estado é capaz de interferir a favor de produtos mais “verdes”. Algumas pessoas, embora ainda sejam consumidoras individuais, não fazem parte de empresas ou do governo. Elas atuam em organizações do terceiro setor, prestando diversos serviços em uma infinidade de áreas possíveis, entre as quais aquelas relacionadas com o meio ambiente. O livro é indicado a profis', 'Consumo responsável e sustentabilidade', NULL, NULL, '244', 'pt-BR', NULL, 'Business & Economics');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1146', '1', '1', 'Clécio Danilo dias da Silva, Lúcia Maria de Almeida', '2026-05-03 02:24:32.594157', '2026-05-08 02:24:32.594157', '0', 'RUIM', '["https://books.google.com/books/content?id=2C07EAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9786588580370', '83.93', NULL, NULL, 'Trabalhar Educação Ambiental na perspectiva da Sustentabilidade é de grande importância na contemporaneidade, visto que ambas, de forma integrada, proporcionam a sensibilização, a construção de valores e mudança de atitudes, possibilidades estas que, precisam estar alicerçadas na formação dos sujeitos, quer seja através da educação formal ou informal. Assim, a Educação Ambiental deve proporcionar aos sujeitos os conhecimentos necessários para tomada de consciência de forma individual e coletiva, com vistas a resolver as questões ambientais de maneira crítica e reflexiva, considerando o contexto econômico e socio cultural dos envolvidos. Neste sentido, conhecer e discutir sobre ações educativas, pesquisas e metodologias que abordam a Educação Ambiental para a Sustentabilidade é de fundamental importância para a formação de cidadãos aptos a atuarem socioambientalmente no seu cotidiano. Diante deste contexto, o e-book “Integrando saberes em Educação Ambiental e Sustentabilidade”, organiza', 'Integrando saberes em educação ambiental e sustentabilidade', NULL, NULL, '362', 'pt-BR', NULL, 'Nature');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1147', '1', '1', 'Robert Enggass, Jonathan Brown', '2026-04-26 02:24:32.594157', '2026-04-27 02:24:32.594157', '0', 'OTIMO', '["https://books.google.com/books/content?id=JBYnVv2lKY4C&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9780810110656', '99.69', NULL, NULL, 'The Baroque period was crucial for the development of art theory and the advancement of the artistic academy. This collection of primary sources brings this important period to life with significant documents and texts. It conveniently assembles major texts, which are otherwise available only in scattered publications. The lives of leading artists--Caravaggio, El Greco, among others---are discussed by their contemporaries, while Bellori, Galileo, Pascoli, and others write on art theory and practice. The documents provide fascinating glimpses of the period''s artistic self-image.', 'Italian and Spanish Art, 1600-1750', NULL, NULL, '368', 'en', NULL, 'Art');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1148', '1', '1', 'Oscar E. Vázquez', '2025-07-23 02:24:32.594157', '2025-07-24 02:24:32.594157', '0', 'DESGASTADO', '["https://books.google.com/books/content?id=wAfoDwAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9781351187534', '214.3', NULL, NULL, 'This edited volume’s chief aim is to bring together, in an English-language source, the principal histories and narratives of some of the most significant academies and national schools of art in South America, Mexico, and the Caribbean, from the late 18th to the early 20th centuries. The book highlights not only issues shared by Latin American academies of art but also those that differentiate them from their European counterparts. Authors examine issues including statutes, the influence of workshops and guilds, the importance of patronage, discourses of race and ethnicity in visual pedagogy, and European models versus the quest for national schools. It also offers first-time English translations of many foundational documents from several significant academies and schools. This book will be of interest to scholars in art history, Latin American and Hispanic studies, and modern visual cultures.', 'Academies and Schools of Art in Latin America', NULL, NULL, '325', 'en', NULL, 'Art');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1149', '1', '1', 'Enrique Ávila López', '2026-04-07 02:24:32.594157', '2026-04-09 02:24:32.594157', '0', 'DESGASTADO', '["https://books.google.com/books/content?id=9hXHEAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9781610696012', '56.82', NULL, NULL, 'Fulfilling the need for English-source material on contemporary Spain, this book supplies readers with an in-depth, interdisciplinary guide to the country of Spain and its intricate, diverse culture. Far from a usual reference book, Modern Spain takes the reader through the country''s history, economy, and politics as well as topics that address Spain''s popular culture, such as food, sports, and sexuality. Because of the interdisciplinary nature of its content, this book differs from the average typical English manuals that very rarely cover in depth the whole array of interesting issues that define Spain in the 21st century. The vast amount of information makes this book the perfect companion for any reader wishing to learn more about Spain. Packed with current facts and statistics, this book offers an unbiased view of a modern country, making it an ideal source for undergraduate students and scholars.', 'Modern Spain', NULL, NULL, '29', 'en', NULL, 'Social Science');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1150', '1', '1', 'Abigail McEwen', '2026-04-17 02:24:32.594157', '2026-04-19 02:24:32.594157', '0', 'RUIM', '["https://books.google.com/books/content?id=WKFTDQAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9780300221329', '332.76', NULL, NULL, 'Modernism in Havana reached its climax during the turbulent years of the 1950s as a generation of artists took up abstraction as a means to advance artistic and political goals in the name of Cuba Libre. During a decade of insurrection and, ultimately, revolution, abstract art signaled the country’s cultural worldliness and its purchase within the international avant-garde. This pioneering book offers the first in-depth examination of Cuban art during that time, following the intersecting trajectories of the artist groups Los Once and Los Diez against a dramatic backdrop of modernization and armed rebellion. Abigail McEwen explores the activities of a constellation of artists and writers invested in the ideological promises of abstraction, and reflects on art’s capacity to effect radical social change. Featuring previously unpublished artworks, new archival research, and extensive primary sources, this remarkable volume excavates a rich cultural history with links to the development of', 'Revolutionary Horizons', NULL, NULL, '13', 'en', NULL, 'Art');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1151', '1', '1', 'Edwin B. Williams', '2026-01-12 02:24:32.594157', '2026-01-16 02:24:32.594157', '0', 'DESGASTADO', '["https://books.google.com/books/content?id=Yr2TXT6HNk4C&printsec=frontcover&img=1&zoom=1&source=gbs_api"]', '9780671435738', '241.07', NULL, NULL, '', 'Diccionario Espanol', NULL, NULL, '124', 'en', NULL, 'Foreign Language Study');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1152', '1', '1', 'Diego Rivera', '2025-11-17 02:24:32.594157', '2025-11-19 02:24:32.594157', '0', 'DESGASTADO', '["https://books.google.com/books/content?id=RwI3AQAAIAAJ&printsec=frontcover&img=1&zoom=1&source=gbs_api"]', '9788493612337', '358.31', NULL, NULL, 'The catalog Diego Rivera, famous words, 1886-1957 is the result of exposure of the same name in the Diego Rivera Studio Museum, dedicated to providing a visual tour of Rivera''s reflections on art. It presents a combination of a selection of textsand quotes from Rivera and images made by Rivera himself orby the artists who in one way or another had a place in his memory. Words illustrated, illustrations speaking, these pageswe face moments in the history of art in the vision of a great creator. Diego Rivera, in addition to the exceptionalqualities that distinguished him as a painter, was possessed of a strong liberal education that served as support their vastintellectual reflections. While in the scaffolding, running a mural, facing reclined on canvas or a pad, sketching a drawing, Riverawas brought into deep meditations on art and the complexintricacies of its evolution throughout history, and also reflection on the duties of the creator, either to society or to the future of the disc', 'Diego Rivera', NULL, NULL, '424', 'en', NULL, 'Art');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1153', '1', '1', 'Ed Bowker Staff, Staff Bowker, Ed', '2025-11-09 02:24:32.594157', '2025-11-14 02:24:32.594157', '0', 'OTIMO', '["https://books.google.com/books/content?id=SAY9I1wyyscC&printsec=frontcover&img=1&zoom=1&source=gbs_api"]', '9780835246422', '126.43', NULL, NULL, '', 'Books In Print 2004-2005', NULL, NULL, '360', 'en', NULL, 'Reference');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1154', '1', '1', 'Kuss, Malena', '2025-11-10 02:24:32.594157', '2025-11-15 02:24:32.594157', '0', 'DESGASTADO', '["https://books.google.com/books/content?id=uspTNzJ_NoYC&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9780292784987', '395.55', NULL, NULL, 'The music of the peoples of South and Central America, Mexico, and the Caribbean is treated with unprecedented breadth in this multi-volume work. Taking a sociocultural and human-centered approach, Music in Latin America and the Caribbean gathers the best scholarship from writers all over the world to cover in depth the musical legacies of indigenous peoples, creoles, African descendants, Iberian colonizers, and other immigrant groups that met and mixed in the New World. From these texts, music emerges as the powerful tool that negotiates identities, enacts resistance, performs beliefs, and challenges received aesthetics. More than two decades in the making, this work privileges the perspectives of cultural insiders and emphasizes the role that music plays in human life. Volume 2, Performing the Caribbean Experience, focuses on the reconfiguration of this complex soundscape after the Conquest and on the strategies by which groups from distant worlds reconstructed traditions, assigning ', 'Music in Latin America and the Caribbean: An Encyclopedic History REANNOUNCE/F05: Volume 2: Performing the Caribbean Experience', NULL, NULL, '187', 'en', NULL, 'Music');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1155', '1', '1', 'Malena Kuss', '2025-12-21 02:24:32.594157', '2025-12-22 02:24:32.594157', '0', 'BOM', '["https://books.google.com/books/content?id=SYuKB29_7qUC&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9780292788404', '54.55', NULL, NULL, 'The music of the peoples of South and Central America, Mexico, and the Caribbean has never received a comprehensive treatment in English until this multi-volume work. Taking a sociocultural and human-centered approach, Music in Latin America and the Caribbean gathers the best scholarship from writers all over the world to cover in depth the musical legacies of indigenous peoples, creoles, African descendants, Iberian colonizers, and other immigrant groups that met and mixed in the New World. Within a history marked by cultural encounters and dislocations, music emerges as the powerful tool that negotiates identities, enacts resistance, performs belief, and challenges received aesthetics. This work, more than two decades in the making, was conceived as part of "The Universe of Music: A History" project, initiated by and developed in cooperation with the International Music Council, with the goals of empowering Latin Americans and Caribbeans to shape their own musical history and emphasi', 'Music in Latin America and the Caribbean: An Encyclopedic History', NULL, NULL, '243', 'en', NULL, 'Music');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1156', '1', '1', 'George J. Buelow', '2025-06-11 02:24:32.594157', '2025-06-13 02:24:32.594157', '0', 'NOVO', '["https://books.google.com/books/content?id=aw1TTtpp4FwC&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9780253343659', '110.99', NULL, NULL, '"A History of Baroque Music is a detailed treatment of the music of the Baroque era, with particular focus on the seventeenth century. The author''s approach is a history of musical style with an emphasis on musical scores. The book is divided initially by time period into early and later Baroque (1600-1700 and 1700-1750 respectively), and secondarily by country and composer. An introductory chapter discusses stylistic continuity with the late Renaissance and examines the etymology of the term "Baroque." The concluding chapter on the composer Telemann addresses the stylistic shift that led to the end of the Baroque and the transition into the Classical period."--Jacket.', 'A History of Baroque Music', NULL, NULL, '317', 'en', NULL, 'Music');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1157', '1', '1', 'Helmut Opitz', '2026-03-08 02:24:32.594157', '2026-03-13 02:24:32.594157', '0', 'RUIM', '["https://books.google.com/books/content?id=eZY7AQAAIAAJ&printsec=frontcover&img=1&zoom=1&source=gbs_api"]', '9783598117077', '351.65', NULL, NULL, 'With over 35,000 addresses, the International Music Directory provides over 35,000 addresses and short profiles on representatives of all areas of the music industry and is the most comprehensive reference work for the music business worldwide.', 'International Music Directory 2006/2007', NULL, NULL, '335', 'en', NULL, 'Music');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1158', '1', '1', 'Roy Bennett, Maria Teresa Resende Costa', '2026-03-20 02:24:32.594157', '2026-03-24 02:24:32.594157', '0', 'BOM', '[]', '9788571103658', '390.08', NULL, NULL, 'Este livro apresenta os caminhos da música do Ocidente a partir do século IX, quando surgiram as primeiras ''composições''; o desenvolvimento da escrita e das idéias musicais e também os instrumentos e práticas adotadas nos diversos períodos dessa evolução. Quadros sinópticos de cada período mostram os vários tipos de música, seus locais de origem, sua gênese cronológica e os principais compositores da época.', 'Uma breve história da música', NULL, NULL, '200', 'pt-BR', NULL, 'Geral');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1159', '1', '1', 'Bettina Bartz, Helmut Opitz', '2026-02-07 02:24:32.594157', '2026-02-09 02:24:32.594157', '0', 'DESGASTADO', '["https://books.google.com/books/content?id=hOzic6lwtZ4C&printsec=frontcover&img=1&zoom=1&source=gbs_api"]', '9783598205330', '252.49', NULL, NULL, '', 'Museums of the World', NULL, NULL, '279', 'en', NULL, 'Reference');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1160', '1', '1', 'Mário de Andrade', '2025-08-16 02:24:32.594157', '2025-08-20 02:24:32.594157', '0', 'NOVO', '["https://books.google.com/books/content?id=k2_xCQAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788520924570', '216.7', NULL, NULL, 'EXCLUSIVO EM EBOOK!O título Pequena história da música é modesto para a dimensão analítica alcançada por Mário de Andrade nestas páginas dedicadas ao estudo da música – a arte cujos elementos formais são constitutivos do homem, "os movimentos do coração, o ato de respirar já são elementos rítmicos, o passo já organiza um ritmo, as mãos percutindo já podem determinar todos os elementos do ritmo. E a voz produz o som". Entendendo, portanto, o homem como um ser com ritmo e som, Mário de Andrade partirá da música elementar, período primitivo em que a música ainda não apresentava uma organização, para analisar a história musical e chegar à música erudita e popular brasileira.Assim, terão destaque nesta obra a música cristã e a profana, o Classicismo e o Romantismo, o antigo e o moderno, o passado e a contemporaneidade. Além do precioso estudo sobre a música, o leitor aqui se depara, sem nenhuma dificuldade, com a sensibilidade e perspicácia de Mário pesquisador e se deleita, ao mesmo tempo,', 'Pequena história da música', NULL, NULL, '448', 'pt-BR', NULL, 'Music');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1161', '1', '1', 'José Ramos Tinhorão', '2026-04-11 02:24:32.594157', '2026-04-13 02:24:32.594157', '0', 'DESGASTADO', '["https://books.google.com/books/content?id=8qbjll0LmbwC&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788573260946', '344.75', NULL, NULL, 'Um panorama da MPB, do século XVI até a atualidade, que narra a evolução da música popular urbana no Brasil. Tinhorão não só descreve os elementos da cultura popular como também as forças sociais que engendram essa cultura. "Nestas páginas lê-se um autor preocupado em encontrar as motivações sociais das transformações sofridas pela música desde o século XVI." (Fábio Santos, República)', 'História social da música popular brasileira', NULL, NULL, '439', 'pt-BR', NULL, 'Music');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1162', '1', '1', 'Donald J. Grout, Claude V. Palisca', '2025-06-17 02:24:32.594157', '2025-06-18 02:24:32.594157', '0', 'RUIM', '[]', '9789726623823', '215.31', NULL, NULL, 'Seguindo uma perspectiva cronológica, os autores relatam a evolução sofrida pela música desde a Grécia antiga até os nossos dias, inserindo-a sempre num contexto mais abrangente da cultura ocidental. Com inúmeras ilustrações e repleta de referências musicais, algumas delas resultantes de investigações recentes, esta obra é um instrumento indispensável tanto aos estudiosos como ao público interessado pelo tema trazendo, além dos pormenores mais técnicos, exemplos acadêmicos e elementos de estudo, uma narrativa histórica e biografias dos criadores musicais do Ocidente em todas as épocas.', 'História da música ocidental', NULL, NULL, '386', 'pt-BR', NULL, 'Geral');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1163', '1', '1', 'Malte Hagener, Michael Töteberg', '2026-02-13 02:24:32.594157', '2026-02-18 02:24:32.594157', '0', 'NOVO', '["https://books.google.com/books/content?id=4r28DQAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9783476036865', '71.15', NULL, NULL, 'Kommentierte Bibliografie. Sie gibt Wissenschaftlern, Studierenden und Journalisten zuverlässig Auskunft über rund 6000 internationale Veröffentlichungen zum Thema Film und Medien. Die vorgestellten Rubriken reichen von Nachschlagewerk über Filmgeschichte bis hin zu Fernsehen, Video, Multimedia.', 'Film – An International Bibliography', NULL, NULL, '72', 'en', NULL, 'Performing Arts');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1164', '1', '1', 'Natalia Pinazza, Louis Bayman', '2026-05-19 02:24:32.594157', '2026-05-23 02:24:32.594157', '0', 'DESGASTADO', '["https://books.google.com/books/content?id=rwLsEAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9781783201150', '195.45', NULL, NULL, 'São Paulo is the largest city in South America and the powerhouse of Brazil’s economy. A multi-racial metropolis with a diverse population of Asian, Arabic and European immigrants as well as migrants from other parts of Brazil, it is a global city with international reach. Films set in São Paulo often replace the postcard images of beautiful tropical beaches and laid-back lifestyles with working environments and the search for better opportunities. Bikinis and flip flops give way to urban subcultures, sport, entertainment and artistic movements. The ability to transcend national boundaries, and its resistance to stereotypical images of an ''exotic'' Brazil, make São Paulo a fascinating location in which to explore Brazil’s changing economic and cultural landscapes.', 'World Film Locations: São Paulo', NULL, NULL, '385', 'en', NULL, 'Art');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1165', '1', '1', 'Dorota Ostrowska, Francesco Pitassio', '2025-08-03 02:24:32.594157', '2025-08-08 02:24:32.594157', '0', 'OTIMO', '["https://books.google.com/books/content?id=pbmKDwAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9781786722393', '202.88', NULL, NULL, 'The continued interest in the social and cultural life of the former Warsaw pact countries – looking at but also beyond their socialist pasts – encompasses a desire to know more about their national cinemas. Yet, despite the increasing consumption of films from these countries – via DVD, VOD platforms and other alternative channels – there is a lack of comprehensive information on this key aspect of visual culture. This important book rectifies the glaring gap and provides both a history and a contemporary account of East Central European cinema in the pre-WW2, socialist, and post-socialist periods. Demonstrating how at different historical moments popular cinema fulfilled various roles, for example in the capacity of nation-building, and adapted to the changing markets of a morphing political landscape, chapters bring together experts in the field for the definitive analysis of mainstream cinema in the region. Celebrating the unique contribution of films from Hungary, the Czech Republ', 'Popular Cinemas in East Central Europe', NULL, NULL, '48', 'en', NULL, 'Performing Arts');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1166', '1', '1', 'Stephanie Dennison', '2025-10-17 02:24:32.594157', '2025-10-20 02:24:32.594157', '0', 'NOVO', '["https://books.google.com/books/content?id=agW5DwAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9781317311829', '263.01', NULL, NULL, 'Remapping Brazilian Film Culture makes a significant contribution not only to debates about Brazilian national cinema, but more generally about the development of world cinema in the twenty-first century. This book charts the key features of Brazilian film culture of the first two decades of the twenty-first century, including: the latest cultural debates within Brazil on film funding and distribution practices; the impact of diversity politics on the Brazilian film industry; the reception and circulation of Brazilian films on the international film festival circuit; and the impact on cultural production of the sharp change in political direction at national level experienced post-2016. The principle of "remapping" here is based on a need to move on from potentially limiting concepts such as "the national", which can serve to unduly ghettoise a cinema, film industry and audience. The book argues that Brazilian film culture should be read as being part of a globally articulated film cul', 'Remapping Brazilian Film Culture in the Twenty-First Century', NULL, NULL, '467', 'en', NULL, 'Performing Arts');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1167', '1', '1', 'Gale Group', '2025-12-30 02:24:32.594157', '2026-01-04 02:24:32.594157', '0', 'BOM', '["https://books.google.com/books/content?id=NZ0aAQAAMAAJ&printsec=frontcover&img=1&zoom=1&source=gbs_api"]', '9780787652661', '287.95', NULL, NULL, '', 'Awards, Honors and Prizes', NULL, NULL, '159', 'en', NULL, 'Reference');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1168', '1', '1', 'Peter Cowie', '2025-09-06 02:24:32.594157', '2025-09-07 02:24:32.594157', '0', 'OTIMO', '["https://books.google.com/books/content?id=XKYVV0NC_QIC&printsec=frontcover&img=1&zoom=1&source=gbs_api"]', '9780233985039', '87.02', NULL, NULL, 'This annual guide on global film-making offers a unique survey of trends, achievements and personalities during the past year. As usual the guide selects five Directors of the Year for appraisal: Danny Boyle, Takeshi Kitano, Soren Kragh-Jacobsen, David Mamet and Spike Lees. This edition has updated sections on film festivals, music and archives.', 'International Film Guide, 1990', NULL, NULL, '371', 'en', NULL, 'Performing Arts');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1169', '1', '1', 'Myrna Silveira Brandão', '2025-09-24 02:24:32.594157', '2025-09-27 02:24:32.594157', '0', 'BOM', '[]', '9788573035155', '329.23', NULL, NULL, 'O livro apresenta um roteiro que objetiva dar uma indicação de quais temas podem ser trabalhados e analisados com a utilização de vários filmes. Por exemplo, se a idéia é trabalhar o clima organizacional na empresa, uma das opções seria utilizar o filme ''O Informante'', em que a questão da ética é passada de forma inteligente e instigante. A criatividade, por sua vez, pode ser trabalhada com o filme ''Orfeu'', em que o diretor realizou uma excelente adaptação da tragédia grega antiga. Desta forma, diversos outros filmes são apresentados revelando, de maneira clara e objetiva, o poder do cinema no processo de evolução e desenvolvimento humano.', 'Leve seu gerente ao cinema', NULL, NULL, '416', 'pt-BR', NULL, 'Geral');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1170', '1', '1', 'Ollivier Pourriol', '2025-08-17 02:24:32.594157', '2025-08-18 02:24:32.594157', '0', 'RUIM', '["https://books.google.com/books/content?id=hW_TDwAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788537808665', '211.15', NULL, NULL, 'Para o filósofo Ollivier Pourriol, o cinema é a arte que expressa os desejos. Na tela grande vemos refletidos nossos anseios retratados e vivenciados pelos personagens. "Durante o tempo de um filme, partilhamos uma modificação global da consciência de um personagem e vemos o mundo através de seus olhos, ou melhor, através de seu olhar: entramos no mundo de seu desejo", explica Pourriol em "Filosofando no cinema". O autor segue a linha de sucesso de seu "Cinefilô", publicado pela Zahar em 2009, e utiliza a sétima arte para desenvolver questões da filosofia. O desejo é o objeto de suas buscas em cenas de filmes como "De olhos bem fechados", "Beleza americana" e "Toy Story". Cada um dos longas é utilizado para refletir e exemplificar um aspecto específico: desejo de reconhecimento, de diferença, desejo pelo outro, a morte do desejo, aqueles que nos enlouquecem, o tempo de cada um deles. Para esclarecer esses temas, o autor recorre ao pensamento de Sartre, Platão, Spinoza, Deleuze, Hegel, ', 'Filosofando no cinema', NULL, NULL, '328', 'pt-BR', NULL, 'Philosophy');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1171', '1', '1', 'J. Landeira-Fernandez | Elie Cheniaux', '2026-01-22 02:24:32.594157', '2026-01-25 02:24:32.594157', '0', 'RUIM', '["https://books.google.com/books/content?id=Hob30slh-eQC&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788536323398', '332.04', NULL, NULL, 'Neste livro surpreendente, os autores se propuseram a uma tarefa pioneira: usar personagens de filmes clássicos e modernos para auxiliar o leitor a compreender os mecanismos dos transtornos mentais, criando uma obra de interesse não apenas aos estudantes de saúde mental, mas a todos aqueles apaixonados por cinema.', 'Cinema e loucura: Conhecendo os transtornos mentais através dos filmes', NULL, NULL, '60', 'pt-BR', NULL, 'Medical');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1172', '1', '1', 'Danit Falbel Pondé', '2025-12-22 02:24:32.594157', '2025-12-27 02:24:32.594157', '0', 'DESGASTADO', '["https://books.google.com/books/content?id=7mWICgAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788544101971', '115.45', NULL, NULL, 'O que o cinema tem a ver com a psicanálise? A resposta é: tudo! Para começar, os dois surgiram na mesma época. Apenas cinco anos depois de os irmãos Lumière apresentarem suas primeiras projeções, em 1895, Freud lançou A interpretação dos sonhos, o livro fundador da psicanálise. Em Cinema no divã, grandes filmes são analisados pela perspectiva da psicanálise. Destacando um filme ou uma série de TV, cada ensaio mostra como o seu enredo e os seus personagens conseguem representar tão bem as questões e os conflitos humanos. De maneira descomplicada e com uma linguagem acessível até para quem é leigo no assunto, Danit Pondé aborda diversos temas da psicanálise como neurose, melancolia e psicopatia tendo como referência grandes sucessos do cinema como Amadeus, Fim de caso, Bonequinha de luxo, entre outros. Um livro capaz de ampliar a visão do leitor para muito além das telas de cinema que, como espectador, vai passar a ver e rever seus filmes preferidos com outros olhos. Sobre a autora: Dani', 'Cinema no divã', NULL, NULL, '215', 'pt-BR', NULL, 'Performing Arts');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1173', '1', '1', 'Pablo González Blasco', '2026-04-11 02:24:32.594157', '2026-04-16 02:24:32.594157', '0', 'RUIM', '["https://books.google.com/books/content?id=2l09EAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9786589002000', '110.39', NULL, NULL, 'Conversando com os Filmes, é o resultado de um processo reflexivo que utiliza o cinema como pista de decolagem. Um fascinante mergulho pelas histórias do cinema contextualizado ao raciocínio de maneira clara e acessível.Para o autor, Pablo González Blasco, que há mais de duas décadas utiliza o cinema como recurso educacional, na medicina, seu campo profissional, e na vida, a interação com os filmes é uma verdadeira aventura. O que se diz na tela e o que se intui, estabelece um diálogo com a consciência, onde a memória das vivências, a cultura que nos cerca, são o pano de fundo para inúmeras considerações. O que impacta não é apenas o que o filme descreve, mas sim algo a mais que transita no meio, entre os fotogramas e o pensamento do espectador, e dispara a reflexão. Conversando com os Filmes, não é uma coletânea de críticas. Fala-se, sim, dos filmes, porém, os comentários recolhidos são o resultado de uma análise, entre o que o cinema traz, e o que o espectador pensa e evoca. Uma expe', 'Conversando com os filmes', NULL, NULL, '453', 'pt-BR', NULL, 'Education');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1174', '1', '1', 'Pedro Martins Freire', '2025-12-31 02:24:32.594157', '2026-01-03 02:24:32.594157', '0', 'BOM', '["https://books.google.com/books/content?id=hq0SEQAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788578233761', '64.78', NULL, NULL, 'O objetivo deste livro não é apenas destacar os filmes proibidos, mas como esse processo de repressão aconteceu em suas mais diversas vertentes. Incontáveis filmes foram censurados, com banimentos, cortes e mutilações por conselhos de censores, entidades religiosas, civis, policiais e órgãos governamentais em escala mundial. E, sim, esse processo sem tribunal aconteceu – e ainda hoje acontece –, também, no interior dos próprios estúdios, embora em escala bem menor. Para expressar e ampliar nossa consciência quanto à história dos filmes alvejados e perseguidos, durante quase 130 anos de existência do Cinema, por repressões e intolerâncias em vários tipos, em todos os continentes, torna-se imperioso o conhecimento da perseverança em busca da imagem em movimento. Afinal, essa busca teve seu processo iniciado em nossa Pré-História e foi incansavelmente formulada ao longo da História, até o final do século XIX, quando, finalmente, com a vitória conquistada, conseguimos transformá-la em Arte', 'O livro dos filmes proibidos e censurados da História do Cinema', NULL, NULL, '67', 'pt-BR', NULL, 'Performing Arts');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1175', '1', '1', 'Everardo Rocha, Lígia Lana', '2026-04-24 02:24:32.594157', '2026-04-27 02:24:32.594157', '0', 'BOM', '["https://books.google.com/books/content?id=h3KMDwAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788574789873', '216.04', NULL, NULL, 'Ao eleger o cinema como objeto de reflexão e método de aprendizado, este livro utiliza as potencialidades do poder imaginativo dos filmes para a compreensão de repertórios, comportamentos e valores relacionados às práticas de consumo. O consumo é fenômeno absolutamente central na cultura moderno-contemporânea, tão importante que o tempo presente é comumente definido como “sociedade de consumo”. Como uma das mais poderosas narrativas disponíveis em nossa vida social, e sendo uma arte e uma indústria, o cinema é capaz de produzir um imenso repertório de representações, elaborar modos de ser e pensar, construir sensibilidades e afetar práticas cotidianas. Dez filmes e dez análises – cada uma sobre um filme – sob a ótica do consumo e do marketing são a tônica de O consumo vai ao cinema. Voltado para todos os que amam cinema e/ou gostariam de “rever” um ou vários desses filmes, mas principalmente para professores e alunos, este livro fornece material didático de peso e subsídios para discus', 'O consumo vai ao cinema', NULL, NULL, '266', 'pt-BR', NULL, 'Social Science');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1176', '1', '1', 'Luiz  Carlos Lucena', '2026-04-07 02:24:32.594157', '2026-04-09 02:24:32.594157', '0', 'NOVO', '["https://books.google.com/books/content?id=men0DwAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788590229438', '133.88', NULL, NULL, 'Falando de Cinema reúne textos publicados nos últimos 10 anos pelo jornalista e cineasta Luiz Carlos Lucena. Não é uma crítica de filmes ou de cinema. O livro traz a visão do autor como cineasta sobre os movimentos, ciclos de cinema. Analisa e comenta filmes clássicos e contemporâneos , as mudanças que ocorreram na produção e linguagem dos filmes, principalmente filmes brasileiros.', 'Falando De Cinema', NULL, NULL, '261', 'pt-BR', NULL, 'Religion');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1177', '1', '1', 'Marcelo França Mendes', '2025-08-09 02:24:32.594157', '2025-08-10 02:24:32.594157', '0', 'BOM', '["https://books.google.com/books/content?id=m8pgEAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9786556910574', '374.5', NULL, NULL, 'Eu que amava tanto o cinema narra o surgimento do Cineclube Estação Botafogo e sua expansão através do olhar e das memórias de um de seus sócios-fundadores, Marcelo França Mendes. A história do Grupo Estação tem início no Rio de Janeiro, na efervescente década de 1980. Eram os tempos da euforia das Diretas Já, do primeiro Rock in Rio, da abertura do Circo Voador e de tantos outros acontecimentos que transformaram a cultura na cidade. Darks conviviam com hippies, a terceira onda do feminismo crescia e os movimentos negro e LGBTQIA+ (na época chamado simplesmente de "movimento gay") buscavam formas de se expressar e ganhar espaço. Nesse ambiente em ebulição, onde se respirava cultura e diversidade, cinco amigos que se reuniam a cada sábado no Cineclube Macunaíma decidiram levar adiante sua paixão pela sétima arte. Sem dinheiro, munidos apenas de vontade e curiosidade, esses jovens viveram a aventura de abrir o seu próprio cineclube. Surgido em 1985, o Coper Botafogo, que no mesmo ano vir', 'Eu que amava tanto o cinema', NULL, NULL, '176', 'pt-BR', NULL, 'Performing Arts');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1178', '1', '1', 'Ailton da Costa Silva Júnior', '2025-06-14 02:24:32.594157', '2025-06-18 02:24:32.594157', '0', 'DESGASTADO', '["https://books.google.com/books/content?id=Q3JeEAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9786525409979', '318.05', NULL, NULL, 'Esta obra é resultado de uma pesquisa realizada no âmbito do programa de pós-graduação em Sociologia da Universidade Federal de Alagoas (UFAL), e refletiu sobre a produção do filme Vidas secas, realizado no interior de Alagoas em 1963. Sendo considerado um dos filmes mais importantes do movimento cinematográfico de nominado Cinema Novo, este longa-metragem do cineasta Nelson Pereira dos Santos desenvolveu uma releitura da obra imortal do escritor Graciliano Ramos, passando a ocupar lugar de destaque entre diferentes produções internacionais. Chegou ainda a concorrer no Festival de Cinema de Cannes nas principais categorias. Venceu o prêmio de Cinema e Arte (pelo Júri Internacional de Proprietários de Cinema e Arte), o prêmio de Melhor Filme para a Juventude (do Júri de Estudantes Secundários e Universitários), o prêmio Ocic (Organização Católica Internacional de Cinema), entre outros. Neste trabalho, fomos em busca das memórias de moradores provenientes dos municípios alagoanos de Mina', 'Cinema, imaginário e subjetividade', NULL, NULL, '146', 'pt-BR', NULL, 'Performing Arts');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1179', '1', '1', 'Paulo Roberto Cannizzaro', '2025-11-03 02:24:32.594157', '2025-11-08 02:24:32.594157', '0', 'NOVO', '["https://books.google.com/books/content?id=qxl9DwAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788554546755', '172.95', NULL, NULL, 'Seja com grandes efeitos visuais, colorido ou preto branco, pouco importa, numa mágica trilha sonora ou em uma história envolvente, é possível viajar para outros mundos inesperados, até para outros tempos, quando você entra numa sala de cinema e senta na poltrona com todas as expectativas. E o mundo do cinema tem essa capacidade de poder te encantar completamente, dos olhos ao coração. Muitas vezes até mesmo depois quando você atravessa a porta de saída do cinema, fica com a impressão que continua levando o filme na sua retina, pelo tanto que a película é capaz de tocá-lo e de te perseguir na memória e na emoção. É como se o filme não se desgrudasse mais de você. E a arte cinematográfica consegue esta magia. O que vemos aqui neste livro é uma viagem pelos tempos do cinema, nessa longa viagem de mais de 120 anos de trajetos de tantas manifestações dessa arte surpreendente. Num momento histórico o cinema foi reconhecido como uma arte de síntese em busca de sua própria linguagem. Em outro', 'E alguns filmes que o vento não levou', NULL, NULL, '98', 'pt-BR', NULL, 'Performing Arts');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1180', '1', '1', 'Francisco José Da Costa (org )', '2025-09-22 02:24:32.594157', '2025-09-26 02:24:32.594157', '0', 'RUIM', '["https://books.google.com/books/content?id=g7JtzQEACAAJ&printsec=frontcover&img=1&zoom=1&source=gbs_api"]', '9798624498778', '269.19', NULL, NULL, 'O cinema tem uma relação indissociável com a vida das pessoas, na medida em que reflete e está integrado à vida, não apenas de atores e atrizes ou dos agentes produtores do cinema, mas também no dia-a-dia das pessoas comuns que tem no cinema uma das melhores alternativas de lazer e de vivência da experiência ficcional. Basta ver os números da indústria da exibição cinematográfica para se ter segurança de o quanto o cinema atrai as pessoas. Em outras palavras, nós vivemos com o cinema, que reflete e retrata nossa vida e ora nos faz pensar sobre o universo que nos envolve, ora nos alerta para o que devemos fazer, ou deixar de fazer, e ora simplesmente nos ocupa o tempo, de uma forma prazerosa e emocionante. E se é assim, não é difícil compreender o uso potencial do cinema na transmissão de mensagens, pontos de vista e de ideologias, e sua capacidade de ilustrar e construir a realidade humana e social enquanto propulsor de uma reflexão sobre o real. Ao longo do livro encaminhamos um esfor', 'Cinema e Negócios em Sala de Aula', NULL, NULL, '151', 'pt-BR', NULL, 'Geral');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1181', '1', '1', 'Marcelo Ikeda', '2026-04-27 02:24:32.594157', '2026-04-30 02:24:32.594157', '0', 'OTIMO', '[]', '9786557590102', '376.11', NULL, NULL, '', 'O cinema independente brasileiro contemporâneo em 50 filmes', NULL, NULL, '46', 'pt-BR', NULL, 'Independent films');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1182', '1', '1', 'Emer Merari Rodrigues', '2026-03-28 02:24:32.594157', '2026-03-31 02:24:32.594157', '0', 'DESGASTADO', '[]', '9798664396768', '169.61', NULL, NULL, 'O livro enfoca as obras adaptadas para o Cinema e levanta questionamentos quanto ao poder das adaptações para a eficácia na releitura literária, aponta-se e exemplifica-se: abordagens, relevâncias, e construções para chegar aos diversos objetivos de interesse da leitura. Propõe uma outra visão dos clássicos da Literatura nacional adaptados, com um novo termo embasado no neologismo da soma dessas duas artes. O trabalho divide-se em três partes que, respectivamente, tratam das particularidades dos filmes adaptados, das construções e relações da Literatura nacional e do hibridismo ou fusão dessas artes. Há reflexão e análise das obras cinematográficas que exemplificam e que conseguem inferir literalidade com o máximo de riqueza linguística aos leitores, visando à conectividade, integração e interação entre o Cinema e a Literatura. De de forma coesa e sensata mostra as raízes dos bloqueios quanto as formas evolução do leitor. Segundo Hans Robert Jauss: "não se lê o mesmo livro da mesma man', 'Cinema e Literatura', NULL, NULL, '375', 'pt-BR', NULL, 'Geral');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1183', '1', '1', 'Tim Bergfelder, Sue Harris', '2025-08-02 02:24:32.594157', '2025-08-07 02:24:32.594157', '0', 'NOVO', '["https://books.google.com/books/content?id=DXtob_q3Cv0C&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9789053569801', '173.95', NULL, NULL, 'Summary: "Film Architecture and the Transnational Imagination presents for the first time a comparative study of European film set design in the late 1920s and 1930s; based on a wealth of designers ʼ drawings, film stills and archival documents, the book offers a new insight into the development and significance of trans-national artistic collaboration during this period. European cinema from the late 1920s to the late 1930s is famous for its attention to detail in terms of set design and visual effect. Focusing on developments in Britain, France, and Germany, Film Architecture and the Transnational Imagination: Set Design in 1930s European Cinema provides a comprehensive analysis of the practices, styles, and function of cinematic production design during this period, and its influence on subsequent filmmaking patterns."--Publisher description.', 'Film Architecture and the Transnational Imagination', NULL, NULL, '345', 'en', NULL, 'Performing Arts');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1184', '1', '1', 'Ryan Lambie', '2025-08-25 02:24:32.594157', '2025-08-30 02:24:32.594157', '0', 'NOVO', '[]', '9788555030970', '247.35', NULL, NULL, 'Que importância têm os filmes de Ficção Científica para a história do cinema? Como se deu a evolução dos filmes de FC nos últimos anos? E como eles se tornaram uma das maiores e mais bem-sucedidas formas de entretenimento? Para responder a essas perguntas, Ryan Lambie faz uma seleção de filmes fundamentais, por meio de uma linha do tempo, para apresentar as obras mais influentes do gênero, mostrando a trajetória e o desenvolvimento da FC no cinema. De Georges Méliès até os grandes sucessos de bilheteria no século XXI, o autor nos conta como esses filmes essenciais refletiram o espírito da época em que foram lançados e influenciaram outros cineastas nos anos que se seguiram. A edição conta ainda com textos de Alfredo Suppia, Roberto Causo e Claudia Fusco, especialistas em FC e anexo com mais de 30 listas dos filmes separados por subgênero, eixos temáticos e década a década.', 'O Guia Geek de Cinema', NULL, NULL, '414', 'pt-BR', NULL, 'Fiction');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1185', '1', '1', 'Trigo Luiz Gonzaga Godoi', '2025-11-16 02:24:32.594157', '2025-11-17 02:24:32.594157', '0', 'NOVO', '["https://books.google.com/books/content?id=XBisDwAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788539605163', '373.76', NULL, NULL, 'Inédito em seu gênero, esse livro reúne pela primeira vez em um só volume, de forma organizada, as mais diversas informações sobre a história das viagens e de tudo o que se relaciona com turismo no país, apresentando-se numa ordenação cronológica e dividido em temas para facilitar a consulta.', 'Viagem na memória', NULL, NULL, '439', 'pt-BR', NULL, 'Business & Economics');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1186', '1', '1', 'Luiz Gonzaga Godoi Trigo', '2026-04-05 02:24:32.594157', '2026-04-08 02:24:32.594157', '0', 'RUIM', '[]', '9788573591170', '144.23', NULL, NULL, '''Viagem na memória. Guia histórico das viagens e do turismo no Brasil'' é um instrumento de navegação para os que querem explorar a história do turismo e da hotelaria no país e ter ao alcance um mapa da infra-estrutura desses setores. Inédito em seu gênero, reunindo pela primeira vez em um só volume, de modo organizado, as mais diversas informações sobre como se constituiu no país a infra-estrutura do turismo e muito mais do infinito temário com ele relacionado. Este livro apresenta-se numa ordenação cronológica e em segmentos por assunto para facilitar a consulta. Uma obra indispensável para profissionais, professores e estudantes das áreas de turismo, lazer, entretenimento e hotelaria, assim como para os que simplesmente desejam conhecer roteiros e viajar pelo Brasil.', 'Viagem na memória', NULL, NULL, '302', 'pt-BR', NULL, 'Brazil');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1187', '1', '1', 'Marlene Matias', '2025-11-27 02:24:32.594157', '2025-12-02 02:24:32.594157', '0', 'OTIMO', '["https://books.google.com/books/content?id=OzQtCgAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788520439548', '188.86', NULL, NULL, 'A organização de eventos é uma atividade que vem apresentando crescimento constante em todo o mundo, tornando-se uma importante fonte econômica e geradora de benefícios sociais. Assim, surge a necessidade de profissionalização e de estudos especializados na área. Esta obra apresenta a evolução dos eventos e sua contextualização no Turismo atual. Mostra também o surgimento do Turismo de Eventos, assim como vários conceitos e estratégias para o desenvolvimento da atividade, envolvendo aspectos teóricos e práticos para seu planejamento e sua organização. A sexta edição deste livro foi ampliada e atualizada, traz dados recentes sobre o panorama internacional e a situação do Brasil no segmento, sendo de grande interesse para os profissionais do setor, professores e estudantes dos cursos de turismo e hotelaria. Editora Manole', 'Organização de eventos: procedimentos e técnicas', NULL, NULL, '87', 'pt-BR', NULL, 'Geral');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1188', '1', '1', 'Fodor''s, Fodor''s Travel Publications, Inc. Staff', '2026-03-15 02:24:32.594157', '2026-03-17 02:24:32.594157', '0', 'DESGASTADO', '["https://books.google.com/books/content?id=9s7uidj3G98C&printsec=frontcover&img=1&zoom=1&source=gbs_api"]', '9781400012824', '87.02', NULL, NULL, 'Provides information on accommodations, restaurants, nightlife, shopping, sightseeing, and beaches.', 'Brazil', NULL, NULL, '425', 'en', NULL, 'Travel');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1189', '1', '1', 'Vicky Katsoni, Carlos Costa', '2026-02-15 02:24:32.594157', '2026-02-18 02:24:32.594157', '0', 'BOM', '["https://books.google.com/books/content?id=xSRaEQAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9783031870194', '136.39', NULL, NULL, 'This book is the second volume of the proceedings of the 11th International Conference of the International Association of Cultural and Digital Tourism (IACuDiT). Focusing on “Innovation and Creativity in Tourism, Business and Social Sciences,” the conference was held from September 3 to 5, 2024, in Naxos, Greece. The book showcases the latest research on tourism business, technology, and the social sciences and presents a critical academic discourse on ICT adoption in the social sciences, regional development; sustainability and tourism experience; smart and sustainable practices; innovations in museum interpretation and collections management; emerging and disruptive technologies; gaming, gamification and augmented reality, and other topical aspects in business and the social sciences. The book discusses these digital transformation processes from various standpoints, including its effect on the social sciences combined with specific forms of tourism. The impact of digitalization enc', 'Innovation and Creativity in Tourism, Business and Social Sciences', NULL, NULL, '159', 'en', NULL, 'Business & Economics');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1190', '1', '1', 'Ben Box, Mick Day', '2025-06-18 02:24:32.594157', '2025-06-19 02:24:32.594157', '0', 'OTIMO', '["https://books.google.com/books/content?id=t1IUAQAAIAAJ&printsec=frontcover&img=1&zoom=1&source=gbs_api"]', '9781900949507', '75.1', NULL, NULL, 'A comprehensive guide providing practical and background information to get the visitor around the vast country of Brazil. This second updated edition is in a travel-proof paperback format with extra extending flaps, and it includes: highlights of Brazil illustrated with colour photography; comprehensive information from where to stay, eat and drink to how to stay healthy; useful Portuguese words and phrases; and colour maps to help plan a trip.', 'Brazil Handbook', NULL, NULL, '442', 'en', NULL, 'Brazil');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1191', '1', '1', 'Robert D.Hisrich, Michael P. Peters', '2026-02-24 02:24:32.594157', '2026-03-01 02:24:32.594157', '0', 'BOM', '["https://books.google.com/books/content?id=r-q_AwAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788580553338', '180.57', NULL, NULL, 'Nesta nova edição, Empreendedorismo desvenda o processo de formular, planejar e implementar um novo negócio. Estudos de caso acompanham os conceitos apresentados em cada capítulo e fornecem exemplos aprofundados de muitos tipos de empresas empreendedoras.', 'Empreendedorismo - 9.ed.', NULL, NULL, '212', 'pt-BR', NULL, 'Business & Economics');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1192', '1', '1', 'Paulo de Assunção', '2025-12-23 02:24:32.594157', '2025-12-28 02:24:32.594157', '0', 'RUIM', '[]', '9788520431740', '116.66', NULL, NULL, 'Este livro foi elaborado a partir da seleção de registros do olhar de alguns viajantes, legados em textos, croquis, pinturas e desenhos, que contribuíram para elaborar as representações sobre as terras e a gente do Brasil. Tais relatos permitiram olhar o Brasil de fora e discutir os aspectos que atraíram a atenção desses viajantes para as terras brasileiras, possibilitando uma compreensão de como ocorreu o desenvolvimento do turismo no país. Ao analisar os registros dos viajantes, o autor destaca temas relacionados com as condições das viagens e com os deslocamentos - motivações das viagens; atrativos naturais e culturais; caminhos e transportes; hospedagem e hospitalidade; e o olhar dos viajantes.', 'História do turismo no Brasil entre os séculos XVI e XX', NULL, NULL, '155', 'pt-BR', NULL, 'Brazil');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1193', '1', '1', 'United Nations', '2025-10-23 02:24:32.594157', '2025-10-26 02:24:32.594157', '0', 'OTIMO', '["https://books.google.com/books/content?id=yzZ5cLp7R0YC&printsec=frontcover&img=1&zoom=1&source=gbs_api"]', '9789219003347', '281.7', NULL, NULL, '', 'Treaty Series 2352', NULL, NULL, '450', 'en', NULL, 'LAW');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1194', '1', '1', 'Ben Box', '2025-07-06 02:24:32.594157', '2025-07-08 02:24:32.594157', '0', 'OTIMO', '["https://books.google.com/books/content?id=3EKIIQj5eOoC&printsec=frontcover&img=1&zoom=1&source=gbs_api"]', '9781903471708', '136.47', NULL, NULL, 'Footprint''s South American Handbook, the longest-running guidebook in the English language, celebrates its 80th anniversary this year. As the Minneapolis Star Tribune declared, it is "amazingly detailed, updated every year, and has good city maps. It has set the standard since 1924." The same could be said for Footprint''s 80 other travel guides as well. Covering more than 120 of the world''s most exciting destinations, Footprint guides offer everything discerning travelers need to get the most out of their trip.', 'South American Handbook 2004', NULL, NULL, '133', 'en', NULL, 'Travel');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1195', '1', '1', 'Marlene Matias', '2025-10-23 02:24:32.594157', '2025-10-24 02:24:32.594157', '0', 'OTIMO', '["https://books.google.com/books/content?id=yRR9EAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9786558409687', '81.2', NULL, NULL, 'A obra Turismo: 50 anos dos cursos de graduação no Brasil, de Marlene Matias, aborda o processo de implantação do curso de graduação em Turismo no país, apresentando sua origem, evolução e as tendências de ensino desse curso nos 50 anos de sua existência. Estruturado em quatro capítulos, o livro aborda também os cursos de graduação de áreas afins ao Turismo como o da área de Serviços, além dos da área de Ciências Sociais, Negócios e Direito, discutindo suas relações com a graduação em Turismo e com o desenvolvimento da atividade turística.', 'Turismo', NULL, NULL, '190', 'pt-BR', NULL, 'Business & Economics');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1196', '1', '1', 'Max Amaral', '2025-08-25 02:24:32.594157', '2025-08-28 02:24:32.594157', '0', 'DESGASTADO', '["https://books.google.com/books/content?id=-gFyEQAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9786528022328', '306.61', NULL, NULL, 'Se você sonha em viajar para o exterior, seja para morar, trabalhar, estudar ou apenas "turistar", este livro é o guia definitivo para transformar seu plano em realidade. Escrito por Max Amaral, um dos maiores especialistas em viagens e imigração do Brasil, esta obra reúne a experiência de centenas de brasileiros que partiram em busca de novas oportunidades ao redor do mundo. Com anos de vivência internacional e mais de cinco mil pessoas auxiliadas em sua jornada, Max compartilha orientações valiosas sobre vistos, planejamento financeiro, moradia, trabalho, adaptação cultural e todos os detalhes essenciais para quem deseja sair do Brasil com segurança e sem imprevistos. Independente do seu destino, este livro será seu melhor aliado para uma viagem tranquila e uma nova vida cheia de possibilidades.', 'O manual da imigração de Sucesso', NULL, NULL, '164', 'pt-BR', NULL, 'Travel');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1197', '1', '1', 'Fernando Cristóvão', '2026-03-10 02:24:32.594157', '2026-03-13 02:24:32.594157', '0', 'OTIMO', '[]', '9789896801175', '126.42', NULL, NULL, '', 'Viagens no interior do Brasil', NULL, NULL, '482', 'pt-BR', NULL, 'Geral');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1198', '1', '1', 'Cássio Pires', '2025-06-28 02:24:32.594157', '2025-06-30 02:24:32.594157', '0', 'NOVO', '["https://books.google.com/books/content?id=fnI3EAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9786556990620', '133.9', NULL, NULL, 'Diário de Bordo: Cinco viagens pelo Brasil, Uruguay, Argentina e Chile é uma compilação de viagens realizadas entre 2009 e 2013 e publicadas no blog Piréx – Diário de Bordo e em outros sites na internet. As histórias contadas nos textos de cada um dos capítulos contém detalhes que podem ajudar os viajantes – rotas, distâncias, lugares mais interessantes, valores –, mas é pela lente da câmera que a mágica realmente acontece. Cada momento congelado em uma fotografia desenha a visão do motociclista/fotógrafo e convida à interpretação do leitor.', 'Diário de Bordo: Cinco viagens pelo Brasil, Uruguay, Argentina e Chile', NULL, NULL, '183', 'pt-BR', NULL, 'Travel');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1199', '1', '1', 'Visconde de Alfredo d''Escragnolle Taunay Taunay', '2025-12-07 02:24:32.594157', '2025-12-12 02:24:32.594157', '0', 'BOM', '["https://books.google.com/books/content?id=BfWUEQAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9782528026205', '248.68', NULL, NULL, 'Descubra os encantos e mistérios de um Brasil desconhecido através dos olhos de um viajante do século XIX! Em "Scenas de viagem", o Visconde de Taunay nos transporta para uma jornada fascinante pelas paisagens exuberantes e culturas vibrantes do Brasil imperial. Com uma narrativa rica e detalhada, Taunay captura a essência de um país em transformação, revelando suas belezas naturais e os desafios de um território em expansão. Os temas únicos desta obra incluem a exploração de terras inóspitas, o encontro com povos indígenas e a convivência com a diversidade cultural do Brasil. A originalidade do livro reside na habilidade de Taunay em mesclar observações pessoais com descrições vívidas, criando uma experiência de leitura imersiva. Os pontos fortes de "Scenas de viagem" incluem o estilo literário elegante e envolvente de Taunay, que já foi amplamente reconhecido por críticos e leitores. A obra é um testemunho histórico valioso, oferecendo uma perspectiva única sobre o Brasil do século X', 'Scenas de viagem', NULL, NULL, '223', 'pt-BR', NULL, 'Travel');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1200', '1', '1', 'Leonardo Spencer, Rachel Spencer', '2025-10-17 02:24:32.594157', '2025-10-21 02:24:32.594157', '0', 'OTIMO', '["https://books.google.com/books/content?id=DNAnEAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788591783281', '230.6', NULL, NULL, 'Depois de muito planejamento, um casal inexperiente pega estrada rumo a um projeto ambicioso: viajar o mundo de carro. Uma jornada de descobrimento e inspiração. O primeiro ano da volta ao mundo de carro do casal está retratado neste livro, “Viajo logo Existo – um ano na estrada”. Nele você encontra os melhores momentos deste primeiro ano de viagem. São dezenas de fotografias e relatos sobre os lugares.', 'Viajo logo Existo - Um ano na América', NULL, NULL, '355', 'pt-BR', NULL, 'Travel');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1201', '1', '1', 'Mark J. Curran', '2025-06-08 02:24:32.594157', '2025-06-09 02:24:32.594157', '0', 'BOM', '["https://books.google.com/books/content?id=tT1ZAAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9781466965867', '358.83', NULL, NULL, '"Peripecias de um Pesquisador ''Gringo'' no Brasil nos Anos 1960, ou, A Cata do Cordel" e um relato divertido e informativo da primeira estada de pesquisa do Curran no Brasil. Neste livro o autor conta duas estorias: a pesquisa sobre o cordel e talvez mais importante, as viagens e a peripecias daquele primeiro ano no Brasil.Os dois relatos sao inseparaveis e se complementam. Os capitulos incluem: Recife e o Nordeste, Viagens ao Interior do Nordeste, Pesquisa na Capital Colonial do Brasil - Salvador da Bahia, Pesquisa e Turismo no Rio de Janeiro, Viagens ao Interior desde o Rio de Janeiro includindo Ouro Preto, Congonhas do Campo e uma viagem memoravel em um "gaiola," ou seja, vapor de roda, no Rio Sao Francisco em Minas Gerais e Bahia, e finalmente, pesquisa na Bacia Amazonica, incluindo Belem do Para e Manaus. O relato nao esta em linguagem academica mas em um estilo coloquial de conversa. Curran escreve como se estivesse fazendo um bate-papo com o leitor relatando estorias de suas viag', 'PERIPÉCIAS DE UM PESQUISADOR “GRINGO” NO BRASIL NOS ANOS 1960', NULL, NULL, '65', 'en', NULL, 'Foreign Language Study');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1202', '1', '1', 'Shar Lemond', '2025-10-22 02:24:32.594157', '2025-10-24 02:24:32.594157', '0', 'BOM', '["https://books.google.com/books/content?id=phuyDwAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9781071508893', '149.77', NULL, NULL, 'Uma escritora de viagens que sonha em começar sua própria revista está prestes a ser demitida. Um furo jornalístico sobre o Rio de Janeiro salvaria o trabalho de Rachel. Os avanços de um guia de turismo sensual chamado Otávio interferem em sua busca, até que uma história exclusiva muda tudo. Rachel, uma escritora de viagens cheia de curvas, confia no guia de turismo, Otávio, para ajudá-la a encontrar um furo no Rio. Chantal, uma supermodelo maldosa contratada para o trabalho, sabota o trabalho de Rachel em todas as oportunidades. Contudo, quando Rachel é forçada a estrelar em cada história exclusiva que encontra, ela logo descobre que seu maior obstáculo é si mesma. Será Rachel capaz de usar o poder de uma cultura diferente para superar as suas inseguranças e assim descobrir o maior segredo de viagem de todos?', 'Segredos de Viagem: Livro Um - Rio de Janeiro', NULL, NULL, '17', 'pt-BR', NULL, 'Fiction');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1203', '1', '1', 'Leonardo Spencer, Rachel Spencer', '2025-11-30 02:24:32.594157', '2025-12-01 02:24:32.594157', '0', 'OTIMO', '["https://books.google.com/books/content?id=-QorEAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788591783267', '182.7', NULL, NULL, 'No quarto ano de viagem, o casal chega a Índia com seu carro do Brasil e encara os maiores desafios da viagem toda. Neste um ano pela Ásia e Oceania, eles dirigiram dois meses pela caótica Índia, pegaram um terremoto no Nepal, cruzaram a isolada Mianmar, curtiram as praias da Tailândia e se encantaram com os templos do Camboja. De avião o casal alçou voos mais longos, visitando a China, a isolada Coreia do Norte, e as beleza da Oceania. Com todo o aprendizado dos outros três livros, o Viajo logo Existo um ano na Ásia e Oceania vem para mostrar que qualquer sonho é possível. O que você vai encontrar neste livro: Uma viagem de carro cruzando a Ásia Da Índia até a Malásia Experiências incríveis De avião foram até a China e a Coreia do Norte Histórias inspiradoras Prefácio do Zeca Camargo', 'Viajo logo Existo Um ano na Ásia e Oceania', NULL, NULL, '83', 'pt-BR', NULL, 'Travel');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1204', '1', '1', 'Yves d''Evreux', '2025-11-01 02:24:32.594157', '2025-11-02 02:24:32.594157', '0', 'DESGASTADO', '["https://books.google.com/books/content?id=afSUEQAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9782528026519', '251.17', NULL, NULL, 'Descubra os segredos do Brasil colonial através dos olhos de um explorador do século XVII! Embarque em uma jornada fascinante com o Padre Ivo D''Evreux, enquanto ele narra suas experiências e descobertas durante sua expedição ao norte do Brasil entre 1613 e 1614. Este relato histórico oferece uma visão única e autêntica de um mundo ainda desconhecido, repleto de culturas indígenas, paisagens exuberantes e desafios inesperados. Temas únicos como a interação entre os colonizadores e as tribos locais, a riqueza da fauna e flora brasileiras, e os desafios da evangelização em terras tão distantes são explorados com profundidade e sensibilidade. A originalidade da obra reside na perspectiva pessoal e detalhada do autor, que combina observações etnográficas com reflexões espirituais. Pontos fortes incluem o estilo narrativo envolvente e vívido de D''Evreux, que transporta o leitor diretamente para o coração do Brasil colonial. Reconhecido por historiadores e entusiastas da literatura de viagem,', 'Viagem ao norte do Brazil feita nos annos 1613 a 1614, pelo Padre Ivo D''Evreux', NULL, NULL, '211', 'pt-BR', NULL, 'Travel');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1205', '1', '1', 'Catarina Tomás, Gabriela Trevisan', '2026-02-10 02:24:32.594157', '2026-02-12 02:24:32.594157', '0', 'RUIM', '["https://books.google.com/books/content?id=RsdUEAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9789898974457', '342.69', NULL, NULL, 'Esta obra pretende ocupar um espaço ainda em aberto na área da Sociologia da Infância reunindo os contributos de 55 autores/as, nacional e internacionalmente reconhecidos/as, oriundos de geografias diversificadas, numa análise crítica sobre questões, temáticas e desafios que se colocam hoje na investigação em torno da infância e da(s) criança(s). O objetivo é reunir, num único volume, um conjunto significativo de reflexões científicas sobre conceitos centrais da investigação contemporânea na área, em português e em inglês, para desta forma possibilitar uma maior partilha e divulgação do conhecimento que se vai construindo a nível mundial. This book intends to fill a gap still open in the scientific area of Sociology of Childhood. It brings togheher the contributions of 55 authors, nationally and internationally recognized, from diverse geographies, in a renewed critical analysis on issues, themes and challenges currently placed in research on childhood and on the child(ren). The main g', 'Conceitos-chave em Sociologia da Infância. Perspetivas Globais = Key concepts on Sociology of Childhood. Global Perspectives', NULL, NULL, '362', 'en', NULL, 'Social Science');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1206', '1', '1', 'José María Hernández Díaz', '2026-05-28 02:24:32.594157', '2026-05-31 02:24:32.594157', '0', 'RUIM', '["https://books.google.com/books/content?id=INSMDwAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788490129821', '254.12', NULL, NULL, 'Si la prensa de intereses generales es una"invención"útil de la Ilustración en el siglo XVIII, la prensa pedagógica de los profesores nace y comienza a ser parte activa del amplio colectivo de docentes que se configura como profesión, de diferentes niveles, en el nacimiento y posterior desarrollo del sistema educativo en el siglo XIX, pero que continúa mostrando vitalidad durante todo el siglo XX, y lo que va del siglo XXI. Bien es cierto que van cambiando algunos contenidos de las revistas de los profesores, y sobre todo los formatos, del papel al digital, aunque no siempre sea deseable una anulación plena de un tipo de soporte sobre el otro. La prensa pedagógica de los profesores resulta imprescindible para comprender y mejorar la profesión, en el ayer y en el presente. Esta modalidad de prensa, con su rica diversidad (sindical, movimientos de renovación pedagógica, de la administración educativa, la prensa al servicio del profesor como elemento informativo y didáctico, las revistas ', 'La prensa pedagógica de los profesores', NULL, NULL, '245', 'pt', NULL, 'Education');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1207', '1', '1', 'National Association of Emergency Medical Technicians (U.S.). Pre-Hospital Trauma Life Support Committee', '2025-09-05 02:24:32.594157', '2025-09-09 02:24:32.594157', '0', 'NOVO', '["https://books.google.com/books/content?id=yThoP5pHo34C&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788535221459', '182.36', NULL, NULL, 'As the required textbook for NAEMT''s worldwide prehospital trauma life support courses, Prehospital Trauma Life Support (PHTLS) is the definitive resource for learning basic and advanced prehospital trauma skills and concepts. Now revised and expanded to cover all aspects of prehospital trauma with new chapters on burns, wilderness trauma, tactical considerations, weapons of mass destruction, triage and disaster management, and environmental trauma the 6th edition is the ultimate trauma text for any prehospital care provider! The 6th edition is also ideal for use as the trauma component of an EMT or paramedic course or as a general reference tool on trauma assessment and management.', 'PHTLS', NULL, NULL, '343', 'en', NULL, 'Health & Fitness');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1208', '1', '1', 'Ilka Camarotti', '2025-08-13 02:24:32.594157', '2025-08-16 02:24:32.594157', '0', 'DESGASTADO', '["https://books.google.com/books/content?id=VOG5yuAI7tEC&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788574193687', '159.26', NULL, NULL, '', 'Governo local e desigualdades de gênero', NULL, NULL, '245', 'pt', NULL, 'Administració local');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1209', '1', '1', 'Liana Garcia Castro', '2026-05-24 02:24:32.594157', '2026-05-26 02:24:32.594157', '0', 'NOVO', '["https://books.google.com/books/content?id=EiP3DwAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9786556500232', '234.67', NULL, NULL, 'O que dizem as crianças sobre os espaços da creche? Como elas os apresentam? O que mostram e o que deixam de mostrar? Para onde estão direcionados seus olhares? O que é relevante para elas sobre os espaços em que vivem sua infância? Este livro traz relatos de uma pesquisa feita com crianças de uma instituição de educação infantil que foram convidadas a brincar de fotografar os espaços por elas ali ocupados. Com uma abordagem inovadora, a obra apresenta o que elas falam sobre esses lugares e o que fazem neles, em práticas e interações. Através de um jogo de olhares – ora o olhar da autora, ora o olhar das crianças, ora o olhar da autora e das crianças em diálogo –, busca-se apontar caminhos para a construção de uma educação infantil de qualidade, que respeite os direitos das crianças.', 'Sob o olhar das crianças', NULL, NULL, '239', 'pt-BR', NULL, 'Education');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1210', '1', '1', 'Inês Amaral, Ana Marta Flores', '2025-07-08 02:24:32.594157', '2025-07-13 02:24:32.594157', '0', 'OTIMO', '["https://books.google.com/books/content?id=zvzyEAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9789899074255', '80.11', NULL, NULL, 'Apps e Jovens Adultos: Contributos para um Mapeamento de Práticas Mediadas explora teorias, práticas, críticas e perspetivas no uso de aplicações móveis por pessoas de 18 a 30 anos. Estruturado em três partes, o livro inicia-se com uma base teórica sobre práticas digitalmente mediadas em jovens adultos/as. O primeiro capítulo critica os média digitais, analisando a natureza simbólica das aplicações móveis. A exploração abrange jogos, dating, saúde e fitness, destacando o compromisso analítico necessário. Os capítulos seguintes abordam género, examinando como jovens adultos/as se envolvem em aplicações de automonitorização e saúde, explorando diferenças de género na adoção tecnológica e questionando construções de género e sexualidade nas práticas de consumo de média. A segunda parte concentra-se em tendências contemporâneas entre jovens adultos globalmente. Trend studies, um campo transdisciplinar, analisa a digitalização da vida quotidiana e plataformas, explorando conceitos como “zei', 'Apps e Jovens Adultos: Contributos para um Mapeamento de Práticas Mediadas', NULL, NULL, '313', 'pt-BR', NULL, 'Social Science');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1211', '1', '1', 'Heidi R. Riggio', '2026-02-24 02:24:32.594157', '2026-02-25 02:24:32.594157', '0', 'DESGASTADO', '["https://books.google.com/books/content?id=S8mDEQAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9781040418420', '213.4', NULL, NULL, 'The second edition of this popular textbook provides a current and comprehensive understanding of sex and gender that incorporates biological, psychological, and social approaches. Using both scientific and feminist approaches in its analysis, this book shows how sex and gender can only be properly understood when taking into account biopsychological approaches and the interactions between these processes. The first section discusses a biological analysis that includes evolutionary, cellular, and genetic processes. The second section considers a psychological and sociological analysis that discusses stereotypes, sexism, and theories of gender. The third section discusses current global challenges surrounding sex and gender, such as discrimination and religious and social oppression of various groups. The new edition has been thoroughly updated to include more discussion of gender identities such as nonbinary and gender fluid, as well as more coverages of global LGBTQIA+ rights and more', 'Sex and Gender', NULL, NULL, '344', 'en', NULL, 'Psychology');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1212', '1', '1', 'Silvia Gomes, Maria João Leote de Carvalho', '2025-11-02 02:24:32.594157', '2025-11-05 02:24:32.594157', '0', 'RUIM', '["https://books.google.com/books/content?id=RSdHEAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9783030822651', '134.28', NULL, NULL, 'This two-volume, edited collection lays the groundwork for an international exploration of incarceration and generation, cover a range of geographic, judicial and administrative contexts of incarceration from contributors across a range of subjects. Volume I explores an array of experiences, dynamics, cultures, interventions and impacts of incarceration in specific generations: childhood, youth and emerging adulthood, adulthood and older age. It covers topics such as: the expansion of the penal landscape; deprivation of liberty regarding children, the problem of unaccompanied migrant children; the incarceration of young adults and adults, exploring its impacts within and beyond incarceration and the consequences of imprisoning older populations. Volume II examines intergenerational relations issues within different contexts of incarceration. This collection discusses public policies and the role of the state and the citizen deprived of liberty. It speaks to academics in criminology, so', 'Incarceration and Generation, Volume I', NULL, NULL, '409', 'en', NULL, 'Social Science');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1213', '1', '1', 'Robert T. Francoeur, Raymond J. Noonan', '2025-10-25 02:24:32.594157', '2025-10-26 02:24:32.594157', '0', 'OTIMO', '["https://books.google.com/books/content?id=dciuj1-F3fYC&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9780826414885', '261.85', NULL, NULL, '--A completely updated one-volume edition of the 4-volume International Encyclopedia of Sexuality--Includes nearly 60 countries and places--12 not previously covered--by more than 200 authorities--It is the only reference work of its kind in any language', 'The Continuum Complete International Encyclopedia of Sexuality', NULL, NULL, '190', 'en', NULL, 'Reference');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1214', '1', '1', 'Sine Nazlı, Rengim, Sari, Gülşah', '2025-11-06 02:24:32.594157', '2025-11-10 02:24:32.594157', '0', 'BOM', '["https://books.google.com/books/content?id=iLbHEAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9781668483992', '226.89', NULL, NULL, 'Internet-based technologies prevail in most of the world. Along with the positive features of digital technologies that permeate our lives in almost every area, including lifestyles and daily practices, the traces of negative aspects have also become evident. Digital addiction is among the most important of these aspects. It is obvious that communication, which has been maintained in various forms since the beginning of humanity, has been shaped by the period in which it is lived. The technology-based transformation has transformed communication, which has been adopted to the "internet" in the world, into a completely different form. Communication, which has become sustainable at any time and anywhere, regardless of location, led by the never-ending elements of "continuity" and "interaction," has turned into an indispensable form. Perspectives on Society and Technology Addiction examines every subject of digital addiction in an interdisciplinary way. It discusses the issues about what ', 'Handbook of Research on Perspectives on Society and Technology Addiction', NULL, NULL, '484', 'en', NULL, 'Psychology');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1215', '1', '1', 'Charles L. Harper, Kevin T. Leicht', '2025-10-03 02:24:32.594157', '2025-10-05 02:24:32.594157', '0', 'NOVO', '["https://books.google.com/books/content?id=bwxHAAAAMAAJ&printsec=frontcover&img=1&zoom=1&source=gbs_api"]', '9780131884984', '156.59', NULL, NULL, 'For one semester junior/senior and beginning-level graduate courses in Social Change. This introduction to social change focuses on theories that explain social change, innovation, social movements, and revolutions. The last part of the book shifts explicitly to the global level to analyze population and environmental issues and globalization. Within this framework, the book discusses topics about change and its problems familiar in sociology and social science.', 'Exploring Social Change', NULL, NULL, '332', 'en', NULL, 'History');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1216', '1', '1', 'Robert Stevenson', '2026-01-15 02:24:32.594157', '2026-01-16 02:24:32.594157', '0', 'BOM', '["https://books.google.com/books/content?id=cQx_zQEACAAJ&printsec=frontcover&img=1&zoom=1&source=gbs_api"]', '9798644088751', '289.97', NULL, NULL, '"For sheer storytelling delight and pure adventure, Treasure Island has never been surpassed. From the moment young Jim Hawkins first encounters the sinister Blind Pew at the Admiral Benbow Inn until the climactic battle for treasure on a tropic isle, the novel creates scenes and characters that have fired the imaginations of generations of readers. Written by a superb prose stylist, a master of both action and atmosphere, the story centers upon the conflict between good and evil - but in this case a particularly engaging form of evil. It is the villainy of that most ambiguous rogue Long John Silver that sets the tempo of this tale of treachery, greed, and daring. Designed to forever kindle a dream of high romance and distant horizons, Treasure Island is, in the words of G. K. Chesterton, ''the realization of an ideal, that which is promised in its provocative and beckoning map; a vision not only of white skeletons but also green palm trees and sapphire seas.'' G. S. Fraser terms it ''an ', 'Treasure Island By Robert Louis Stevenson (Young Adult Fiction & Adventure Fiction) "Annotated Edition"', NULL, NULL, '282', 'en', NULL, 'Geral');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1217', '1', '1', 'Random House', '2025-09-25 02:24:32.594157', '2025-09-27 02:24:32.594157', '0', 'RUIM', '[]', '9780099800927', '327.9', NULL, NULL, '', 'Someone Like You', NULL, NULL, '492', 'en', NULL, 'Geral');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1218', '1', '1', 'Robert Stevenson', '2025-10-19 02:24:32.594157', '2025-10-21 02:24:32.594157', '0', 'OTIMO', '["https://books.google.com/books/content?id=OdCNzQEACAAJ&printsec=frontcover&img=1&zoom=1&source=gbs_api"]', '9798644088782', '152.72', NULL, NULL, '"For sheer storytelling delight and pure adventure, Treasure Island has never been surpassed. From the moment young Jim Hawkins first encounters the sinister Blind Pew at the Admiral Benbow Inn until the climactic battle for treasure on a tropic isle, the novel creates scenes and characters that have fired the imaginations of generations of readers. Written by a superb prose stylist, a master of both action and atmosphere, the story centers upon the conflict between good and evil - but in this case a particularly engaging form of evil. It is the villainy of that most ambiguous rogue Long John Silver that sets the tempo of this tale of treachery, greed, and daring. Designed to forever kindle a dream of high romance and distant horizons, Treasure Island is, in the words of G. K. Chesterton, ''the realization of an ideal, that which is promised in its provocative and beckoning map; a vision not only of white skeletons but also green palm trees and sapphire seas.'' G. S. Fraser terms it ''an ', 'Treasure Island By Robert Louis Stevenson (Young Adult Fiction & Adventure Fiction) "The Annotated Classic Version"', NULL, NULL, '205', 'en', NULL, 'Geral');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1219', '1', '1', 'James C. Dodson', '2025-09-06 02:24:32.594157', '2025-09-09 02:24:32.594157', '0', 'BOM', '[]', '9780849938689', '209.06', NULL, NULL, 'America''s most respected Christian counselor candidly addresses the defining issues that young adults will face in the "critical decade" (ages 16-26).', 'Life on the Edge', NULL, NULL, '381', 'en', NULL, 'Life change events');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1220', '1', '1', 'Lynne Reid Banks', '2026-05-30 02:24:32.594157', '2026-06-02 02:24:32.594157', '0', 'OTIMO', '["https://books.google.com/books/content?id=yu4LAAAACAAJ&printsec=frontcover&img=1&zoom=1&source=gbs_api"]', '9780613083409', '175.24', NULL, NULL, 'From the moment Roger and his family arrive at the French chateau for a holiday, everything seems strange. The place is unkempt, the owner is ill-tempered, and his daughter seems deeply troubled. Roger feels he must help her, and that means getting to the bottom of the dark mystery of the chateau. Previously out of print.', 'Melusine', NULL, NULL, '460', 'en', NULL, 'Juvenile Fiction');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1221', '1', '1', 'Ouida Sebestyen', '2025-06-16 02:24:32.594157', '2025-06-18 02:24:32.594157', '0', 'BOM', '[]', '9780812479829', '268.71', NULL, NULL, 'Kidnapped and left in an underground room, Jackie explores her psychological strengths and limitations as she tries to make contact with the outside world by writing messages and sending them through a slit in the door.', 'The Girl in the Box', NULL, NULL, '125', 'en', NULL, 'Geral');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1222', '1', '1', 'Margaret Mahy', '2026-04-04 02:24:32.594157', '2026-04-09 02:24:32.594157', '0', 'OTIMO', '["https://books.google.com/books/content?id=bK_ZDQAAQBAJ&printsec=frontcover&img=1&zoom=1&source=gbs_api"]', '9781869713577', '389.63', NULL, NULL, '''A clammy hand pressed Laura down to her knees beside Jacko''s bed. It was the hand of terror, nothing less.'' It was a warning. Laura felt it when she looked in the mirror that morning. There had been others: the day her father left home, the day she met Sorensen - the boy with the strange silver eyes. But nothing had prepared Laura for the horror of today. And now her little brother, Jacko, was fighting for his life after being sucked dry of his youth by the sinister Carmody Braque. Laura knows there is only one way to save Jacko; she must join Sorensen and use his supernatural powers to change over if there is to be any hope for her little brother. ''It is rare to find a novel which captures so well the changeover from child to adult, and from what is real in the mind to what is real outside.'' The Times Literary Supplement ''The best supernatural young adult fiction around. With Stephen King power and Mahy''s own class and polish.'' Kirkus Review ''Original and unforgettable - a seamless c', 'The Changeover', NULL, NULL, '286', 'en', NULL, 'Young Adult Fiction');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1223', '1', '1', 'Robert Cormier', '2025-06-27 02:24:32.594157', '2025-07-01 02:24:32.594157', '0', 'NOVO', '["https://books.google.com/books/content?id=OuJ9oAEACAAJ&printsec=frontcover&img=1&zoom=1&source=gbs_api"]', '9780606366953', '246.01', NULL, NULL, 'A high-school freshman who refuses to participate in the annual fund-raising chocolate sale is forced to defend his convictions', 'The Chocolate War', NULL, NULL, '472', 'en', NULL, 'Adolescence');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1224', '1', '1', 'Angela Johnson', '2025-06-20 02:24:32.594157', '2025-06-24 02:24:32.594157', '0', 'DESGASTADO', '[]', '9781451707205', '195.04', NULL, NULL, '', 'The First Part Last', NULL, NULL, '493', 'en', NULL, 'African Americans');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1225', '1', '1', 'Nancy Werlin', '2026-04-23 02:24:32.594157', '2026-04-26 02:24:32.594157', '0', 'NOVO', '["https://books.google.com/books/content?id=t6Rthj37Lz4C&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9781101576267', '230.91', NULL, NULL, 'This National Book Award Finalist is a thought-provoking exploration of emotional abuse, self-reliance and the nature of evil. A heart-wrenching portrait of family crisis, this is perfect for fans of Laurie Halse Anderson’s Speak and Jay Asher’s Thirteen Reasons Why. For Matt and his sisters, life with their cruel, physically abusive mother is a day-to-day struggle for survival. But then Matt witnesses a man named Murdoch coming to a child’s rescue in a convenience store; and for the first time, he feels a glimmer of hope. Then, amazingly, Murdoch begins dating Matt’s mother. Life is suddenly almost good. But the relief lasts only a short time. When Murdoch inevitable breaks up with their mother, Matt knows that he’ll need to take some action. Can he call upon Murdoch to be his hero? Or will Matt have to take measures into his own hands? A gripping, powerful novel that will stay with you long after you’ve read it. Nancy Werlin, the New York Times Bestselling author of Impossible, shows', 'The Rules of Survival', NULL, NULL, '76', 'en', NULL, 'Young Adult Fiction');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1226', '1', '1', 'Sarah Dessen', '2026-02-28 02:24:32.594157', '2026-03-01 02:24:32.594157', '0', 'OTIMO', '[]', '9781101040188', '233.38', NULL, NULL, 'During the summer of her divorced father''s remarriage and her sister''s wedding, fifteen-year-old Haven comes into her own by letting go of the myths of the past.', 'That Summer', NULL, NULL, '291', 'en', NULL, 'Downloadable e-Books');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1227', '1', '1', 'Caroline B. Cooney', '2025-10-14 02:24:32.594157', '2025-10-15 02:24:32.594157', '0', 'RUIM', '["https://books.google.com/books/content?id=oQQIAAAACAAJ&printsec=frontcover&img=1&zoom=1&source=gbs_api"]', '9780833525147', '333.65', NULL, NULL, 'Six high school juniors discover surprising, often painful, things about themselves and their relationships with the people around them in the diaries they are asked to keep as a three-month English assignment', 'Among Friends', NULL, NULL, '250', 'en', NULL, 'Geral');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1228', '1', '1', 'William Sleator', '2025-08-02 02:24:32.594157', '2025-08-05 02:24:32.594157', '0', 'DESGASTADO', '[]', '9780606126021', '95.86', NULL, NULL, 'Sixteen-year-old twins Harry and Barry stumble across a gateway to another universe, where a distortion in time and space causes a dramatic change in their competitive relationship.', 'Singularity', NULL, NULL, '471', 'en', NULL, 'Science fiction.');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1229', '1', '1', 'Jeffrey Andrew Weinstock', '2026-02-24 02:24:32.594157', '2026-02-28 02:24:32.594157', '0', 'NOVO', '["https://books.google.com/books/content?id=yPRaEQAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9781452974774', '257.35', NULL, NULL, 'A comprehensive guide to the timeless, paradoxical appeal of horror Why do we enjoy horror? The emotional responses the genre provokes—fear, dread, and disgust—are ones we typically seek to avoid, so what is the appeal of narratives and artistic representations that seek to scare, startle, shock, and repulse? In The Horror Theory Reader, Jeffrey Andrew Weinstock assembles theorizations of the genre’s appeal from antiquity to the present day to explore the “paradox of horror” that has for millennia preoccupied theorists and consumers alike. Beginning with an introduction situating the history of horror in the context of moral panics, this carefully curated volume then is organized into three sections that introduce early attempts to explain horror’s fascination; present perspectives from horror writers, filmmakers, and scholars; and offer nuanced considerations of horror’s intersections with disability, queerness, race, and gender. Featuring classic commentaries on the genre by H. P. Lo', 'The Horror Theory Reader', NULL, NULL, '48', 'en', NULL, 'Literary Criticism');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1230', '1', '1', 'Antonio Lazaro-Reboll', '2025-06-18 02:24:32.594157', '2025-06-20 02:24:32.594157', '0', 'DESGASTADO', '["https://books.google.com/books/content?id=NwirBgAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9780748636402', '325.95', NULL, NULL, 'Spanish Horror Film is the first in-depth exploration of the genre in Spain from the ''horror boom'' of the late 1960s and early 1970s to the most recent production in the current renaissance of Spanish genre cinema, through a study of its production, circulation, regulation and consumption. The examination of this rich cinematic tradition is firmly located in relation to broader historical and cultural shifts in recent Spanish history and as an important part of the European horror film tradition and the global culture of psychotronia.', 'Spanish Horror Film', NULL, NULL, '407', 'en', NULL, 'Performing Arts');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1231', '1', '1', 'Alan Hewetson', '2025-09-12 02:24:32.594157', '2025-09-15 02:24:32.594157', '0', 'RUIM', '["https://books.google.com/books/content?id=u3GGf2N1f7IC&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9781900486378', '281.45', NULL, NULL, 'The inside story of a uniquely influential horror comic publisher from the 1970s.', 'The Complete Illustrated History of the Skywald Horror-mood', NULL, NULL, '73', 'en', NULL, 'Art');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1232', '1', '1', 'Jonina Anderson-Lopez', '2025-06-21 02:24:32.594157', '2025-06-26 02:24:32.594157', '0', 'DESGASTADO', '["https://books.google.com/books/content?id=_xTYEAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9781476649115', '162.26', NULL, NULL, 'Horror fiction--in literature, film and television--display a wealth of potential, and appeal to diverse audiences. The trope of "the black man always dies first" still, however, haunts the genre. This book focuses on the latest cycle of diversity in horror fiction, starting with the release of Get Out in 2017, which inspired a new speculative turn for the genre. Using various critical frameworks like feminism and colonialism, the book also assesses diversity gaps in horror fictions, with an emphasis on marketing and storytelling methodology. Reviewing the canon and definitions of horror may point to influences for future implications of diversity, which has cyclically manifested in horror fictions throughout history. This book studies works from literature, film and television while acknowledging that each of the formats are distinct artforms that complement each other. The author compares diverse representation in novels like The Castle of Otranto, Frankenstein, Fledgling, Broken Mon', 'All Kinds of Scary', NULL, NULL, '480', 'en', NULL, 'Performing Arts');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1233', '1', '1', 'Samuel Munz', '2026-05-04 02:24:32.594157', '2026-05-05 02:24:32.594157', '0', 'DESGASTADO', '["https://books.google.com/books/content?id=9MNfEAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9783346593351', '279.31', NULL, NULL, 'Seminar paper from the year 2019 in the subject English Language and Literature Studies - Other, grade: 1,7, University of Tubingen, language: English, abstract: "The Birds", by ‘the master of suspense’ Alfred Hitchcock, was a technical marvel for its time. Made in the 1960''s when there were no computers to help making films, Hitchcock pushed the limits of film production, and it was superbly directed. Unsure of whether he would be able to finish shooting the film and later admitting if he had known how difficult it would be to produce, he would not have shot it. The technique behind the production of the film, the well-performing cast and the suspense in this film made it brilliant for the time and still is nowadays. Yet, the film is different than a lot of other productions by Hitchcock. Especially when comparing it to "Psycho", which was released three years prior to "The Birds", there are a lot of differences and some similarities, but in the end, both are iconic thrillers and two ', 'Creating Horror and Suspense in Hitchcock''s Film "The Birds"', NULL, NULL, '392', 'en', NULL, 'Literary Collections');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1234', '1', '1', 'Wheeler Winston Dixon', '2026-05-27 02:24:32.594157', '2026-05-28 02:24:32.594157', '0', 'OTIMO', '["https://books.google.com/books/content?id=w6SLIi8OvTYC&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9780813550398', '159.55', NULL, NULL, 'Ever since horror leapt from popular fiction to the silver screen in the late 1890s, viewers have experienced fear and pleasure in exquisite combination. Wheeler Winston Dixon''s A History of Horror is the only book to offer a comprehensive survey of this ever-popular film genre. Arranged by decades, with outliers and franchise films overlapping some years, this one-stop sourcebook unearths the historical origins of characters such as Dracula, Frankenstein, and the Wolfman and their various incarnations in film from the silent era to comedic sequels. A History of Horror explores how the horror film fits into the Hollywood studio system and how its enormous success in American and European culture expanded globally over time. Dixon examines key periods in the horror film-in which the basic precepts of the genre were established, then banished into conveniently reliable and malleable forms, and then, after collapsing into parody, rose again and again to create new levels of intensity and ', 'A History of Horror', NULL, NULL, '369', 'en', NULL, 'Performing Arts');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1235', '1', '1', 'Charles L. Grant', '2025-09-08 02:24:32.594157', '2025-09-09 02:24:32.594157', '0', 'RUIM', '["https://books.google.com/books/content?id=UJIAZzEOCkUC&printsec=frontcover&img=1&zoom=1&source=gbs_api"]', '9780451455154', '240.84', NULL, NULL, 'A collection of twenty short horror stories includes "Nona" by Stephen King, "In Darkness, Angels" by Eric Van Lustbader, "Nunc Dimittis" by Tanith Lee, and "Aim for the Heart" by Craig Shaw Gardner', 'Gallery of Horror', NULL, NULL, '348', 'en', NULL, 'Fiction');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1236', '1', '1', 'Judith Miller, Mark Miller', '2025-08-13 02:24:32.594157', '2025-08-15 02:24:32.594157', '0', 'BOM', '["https://books.google.com/books/content?id=-E0YZTexUakC&printsec=frontcover&img=1&zoom=1&source=gbs_api"]', '9780756613396', '283.89', NULL, NULL, 'Provides up-to-date values for a wide range of collectibles from Barbie dolls to textiles, and features more than five thousand color photographs for easy identification.', 'Collectibles Price Guide 2006', NULL, NULL, '286', 'en', NULL, 'Antiques & Collectibles');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1237', '1', '1', 'Judith Miller, Mark Hill', '2025-09-23 02:24:32.594157', '2025-09-26 02:24:32.594157', '0', 'RUIM', '["https://books.google.com/books/content?id=UCNOTr-wTx8C&printsec=frontcover&img=1&zoom=1&source=gbs_api"]', '9780756622978', '180.68', NULL, NULL, 'From late 20th-century Studio glass to vintage clothing, this is the perfect shopping companion for bargain-hunters and collectors. Full color.', 'Collectibles Price Guide 2007', NULL, NULL, '397', 'en', NULL, 'Antiques & Collectibles');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1238', '1', '1', 'David K. Henkel', '2026-02-04 02:24:32.594157', '2026-02-08 02:24:32.594157', '0', 'OTIMO', '["https://books.google.com/books/content?id=ShvC5K5eu9AC&printsec=frontcover&img=1&zoom=1&source=gbs_api"]', '9780380769261', '308.88', NULL, NULL, 'The Essential Guide to American Magazines Here is the only guide on the market to all major categories of general circulation American magazines from 1880 to 1999. With up- to values on thousands of magazines, plus more than 550 new photos of collectible magazine covers, this book is a must for every collector. It includes: Current values for popular magazines, from National Geographic to Life, Rolling Stone, a and Tiger Beat Coverage of all movie, TV, and entertainment magazines, with extensive listings for TV/Guide and People Complete listings for every monster, science fiction, and horror magazine, from Famous Monsters of Filmland and Horror Tales to Starlog Values for adult magazines, including Playboy, High Society, and Penthouse, along with Sports Illustrated Swimsuit Special Editions, plus a list of the most collectible females, such as Samantha Fox and Cindy Crawford A new chapter on Karate and Wrestling magazines Dozens of recent magazines with collectible celebrity covers, in', 'Collectible Magazines', NULL, NULL, '452', 'en', NULL, 'Antiques & Collectibles');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1239', '1', '1', 'Jessica Bomarito', '2026-02-24 02:24:32.594157', '2026-02-27 02:24:32.594157', '0', 'OTIMO', '["https://books.google.com/books/content?id=tij8PWH4bgYC&printsec=frontcover&img=1&zoom=1&source=gbs_api"]', '9780787688905', '259.8', NULL, NULL, 'Presents literary criticism on the works of short-story writers of all nations, cultures, and time periods. Critical essays are selected from leading sources, including published journals, magazines, books, reviews, diaries, newspapers, pamphlets, and scholarly papers.', 'Short Story Criticism', NULL, NULL, '56', 'en', NULL, 'Literary Criticism');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1240', '1', '1', 'Steven H. Scheuer', '2025-06-22 02:24:32.594157', '2025-06-27 02:24:32.594157', '0', 'RUIM', '["https://books.google.com/books/content?id=EoCqO6zw_twC&printsec=frontcover&img=1&zoom=1&source=gbs_api"]', '9780553277074', '87.48', NULL, NULL, 'With over 14,000 listings, from the latest box-office smashes, this updated, 30th Anniversary edition of the definitive movie guide packs more information than any weekly guide in one volume. Includes concise plot summaries, a four-star ratings system, reviews, and more. And, as a bonus, order the 12-copy prepack and pay for only 11 books! A $71.40 retail value.', 'Movies on TV and Videocassette', NULL, NULL, '389', 'en', NULL, 'Performing Arts');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1241', '1', '1', 'Leonard Maltin', '2025-10-08 02:24:32.594157', '2025-10-13 02:24:32.594157', '0', 'BOM', '["https://books.google.com/books/content?id=VNjdS6EXxZ0C&printsec=frontcover&img=1&zoom=1&source=gbs_api"]', '9780452268579', '108.77', NULL, NULL, 'Widely acclaimed as the biggest, best, most authoritative book in its field, this guide has been updated for 1993 and now includes a new feature--a symbol to designate movies available on increasingly popular laser discs. Features 300 new movie summaries, plus expanded coverage of films available on video for home viewing.', 'Leonard Maltin''s Movie and Video Guide 1993', NULL, NULL, '57', 'en', NULL, 'Performing Arts');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1242', '1', '1', 'Steven H. Scheuer, Robert J. Pardi', '2025-06-13 02:24:32.594157', '2025-06-17 02:24:32.594157', '0', 'BOM', '["https://books.google.com/books/content?id=saISAwOb9yIC&printsec=frontcover&img=1&zoom=1&source=gbs_api"]', '9780553268515', '106.38', NULL, NULL, 'Alphabetical listings and a 4-star rating system make for quick and easy decision-making, while thoughtful, professional reviews guide consumers to optimal viewing pleasure. Expanded and updated with over 14,000 listings.', 'Movies on TV, 1988-1989', NULL, NULL, '490', 'en', NULL, 'Performing Arts');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1243', '1', '1', 'Mick Martin, Marsha Porter', '2026-05-20 02:24:32.594157', '2026-05-21 02:24:32.594157', '0', 'NOVO', '["https://books.google.com/books/content?id=89RwLoiAcOYC&printsec=frontcover&img=1&zoom=1&source=gbs_api"]', '9780345449931', '172.46', NULL, NULL, 'Featuring more than 400 new entries among reviews and ratings of 18,000 movies, this guide to films that are available on video and DVD includes brand-new DVD listings, director and star indexes, and much more. Original.', 'DVD & Video Guide 2004', NULL, NULL, '357', 'en', NULL, 'Performing Arts');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1244', '1', '1', 'Alex G. Malloy', '2025-10-26 02:24:32.594157', '2025-10-30 02:24:32.594157', '0', 'BOM', '["https://books.google.com/books/content?id=gspijKUZ_d8C&printsec=frontcover&img=1&zoom=1&source=gbs_api"]', '9780873493932', '155.73', NULL, NULL, 'Attract comic book collectors like a magnet Packed with nearly 100,000 classic and contemporary comics and more than 1,000 illustrations, collectors will find updated listings and prices for Acclaim, Classics Illustrated, Dark Horse, D.C., Marvel and much more. Special sections are devoted to the highly collectible Golden Age, Color Comics, Black & White Comics, and Underground Comics. Each listing is cross-referenced and includes issue number, title, date, artist and current collector value in US dollars. Collectors can accurately evaluate and value their collections with the grading guide, current market report and tips for buying, selling, and preserving comic books.', 'Comics Values Annual 2002', NULL, NULL, '111', 'en', NULL, 'Antiques & Collectibles');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1245', '1', '1', 'Pedro Cagna', '2025-09-27 02:24:32.594157', '2025-10-01 02:24:32.594157', '0', 'RUIM', '["https://books.google.com/books/content?id=6Me8EQAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9786586317183', '280.92', NULL, NULL, 'DETETIVE PARTICULAR: UM ALIADO DA SOCIEDADE A demanda por investigadores particulares está crescendo globalmente, impulsionada pelo reconhecimento de que as forças policiais muitas vezes têm recursos, tempo e jurisdição limitados para lidar com toda a gama de necessidades investigativas. Essa lacuna é preenchida pelos investigadores particulares. Também, a percepção global sobre investigadores particulares mudou, deixando para trás a imagem tradicional e frequentemente estigmatizada de detetive amador e passando a ser vista como profissionais com conhecimento tecnológico, capazes de resolver problemas e representando ativos estratégicos para empresas e indivíduos. A profissão é cada vez mais vista como uma necessidade, expandindo-se em escopo e demanda devido aos avanços tecnológicos e às limitações e restrições de recursos das agências policiais regulares em todo o mundo. A imagem dos detetives particulares foi amplamente atualizada, deixando para trás o detetive de sobretudo dos roma', 'Manual Técnico Detetive Privado', NULL, NULL, '257', 'pt-BR', NULL, 'Biography & Autobiography');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1246', '1', '1', 'Don Winslow', '2025-12-18 02:24:32.594157', '2025-12-20 02:24:32.594157', '0', 'BOM', '["https://books.google.com/books/content?id=T5lNDwAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788595083011', '115.26', NULL, NULL, '"Imagine o poderoso chefão com policiais. É bom mesmo." Stephen King "Provavelmente, o melhor romance policial já escrito." Lee Child Denny Malone só queria ser um bom policial. Ele é o "rei do norte de Manhattan", detetive-sargento condecorado e o líder da força policial de Nova York. Malone tem a melhor equipe: a mais forte, a mais rápida, a mais corajosa e a mais destemida. Sua unidade de elite tem autoridade irrestrita para liderar a guerra às drogas, às gangues e ao tráfico de armas. O que a maioria não sabe é que o próprio Denny Malone é corrupto. Agora, investigado pelo FBI, ele deve andar na corda bamba para evitar trair seus parceiros, sua família e a mulher que ama, enquanto a cidade está prestes a entrar em um conflito que pode pôr tudo a perder. A força é uma história de ganância e violência, desigualdade e raça, crime e injustiça, vingança e redenção que revela as tensões aparentemente insuperáveis entre a polícia e os cidadãos a quem eles servem.', 'A força', NULL, NULL, '347', 'pt-BR', NULL, 'Fiction');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1247', '1', '1', 'Tito Prates', '2026-04-19 02:24:32.594157', '2026-04-24 02:24:32.594157', '0', 'BOM', '["https://books.google.com/books/content?id=YrGqEAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788554471514', '754.95', NULL, NULL, 'Primeira biografia da Rainha do Crime escrita originalmente em português, com autorizações do Agatha Christie Trust, Agatha Christie Ltd. e Mathew Prichard, neto da escritora. Agatha Christie é a maior escritora de best-sellers de todos os tempo, chegando ao incrível número de 4 bilhões de cópias vendidas. Esta biografia não contém spoillers de suas obras, mas tem um breve relato sobre cada uma, além de mostrar toda sua trajetória de vida.', 'Agatha Christie', NULL, NULL, '161', 'pt-BR', NULL, 'Biography & Autobiography');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1248', '1', '1', 'Don Winslow', '2025-09-26 02:24:32.594157', '2025-10-01 02:24:32.594157', '0', 'DESGASTADO', '["https://books.google.com/books/content?id=MiBoEQAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9786555117028', '381.23', NULL, NULL, 'Em seus enredos, Don Winslow percorre as linhas embaçadas separam a lei e seu cumprimento, contando histórias de policiais e bandidos incrivelmente reais, que mostram que a divisão entre o bem e o mau pode não ser tão clara. No kit "Especial Don Winslow" você encontra as obras: A Queda Em seis contos inéditos, Don Winslow lança o olhar para todas as almas perdidas que dirigem sem farol pela estrada do crime nos Estados Unidos, Winslow traz histórias de personagens sombrios, em conflito com suas próprias identidades nesse intricado jogo que é o mundo do crime. A Fronteira Uma impactante história de vingança, violência, corrupção e justiça, A Fronteira é repleto de cenas inesquecíveis que parecem ter saído das páginas de jornais. Chocante em sua brutalidade, cru em sua humanidade, este é um retrato inabalável dos Estados Unidos de hoje, uma história do — e para — os nossos tempos. A Força A Força é uma história de ganância e violência, desigualdade e raça, crime e injustiça, vingança e r', 'Especial Don Winslow', NULL, NULL, '461', 'pt-BR', NULL, 'Fiction');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1249', '1', '1', 'Leonardo Maugeri', '2026-05-20 02:24:32.594157', '2026-05-23 02:24:32.594157', '0', 'DESGASTADO', '["https://books.google.com/books/content?id=rUW8DwAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788542816136', '318.67', NULL, NULL, 'Richard Jay conseguiu se livrar um pouco mais cedo do escritório naquela sexta-feira e foi buscar seu filho, Peter, na escola da pequena Portsun, uma pacata cidade localizada ao sul da Inglaterra. Quando tudo caminhava para mais um final de semana agradável de primavera junto à sua família, na casa em frente ao mar, um acontecimento brutal mudou para sempre a vida de todos. Doze anos se passaram e um novo crime volta a abalar as estruturas da pequena cidade. Aparentemente um assassinato com contornos simples e previsíveis, o caso ganha outras proporções quando novas evidências vêm à tona. Auxiliado por um policial recém-formado na prestigiada Escola de Polícia de Londres, a New Scotland Yard, o detetive Hilton embarcará em uma corrida contra ameaças sombrias e suspeitos furtivos para desvendar os mistérios que permeiam o crime.', 'Aprisionado à própria sombra', NULL, NULL, '3', 'pt-BR', NULL, 'Fiction');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1250', '1', '1', 'Bruno Moraes Alves', '2025-11-09 02:24:32.594157', '2025-11-13 02:24:32.594157', '0', 'RUIM', '["https://books.google.com/books/content?id=lmpkEAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9786500411355', '203.25', NULL, NULL, 'Você tem em suas mãos o material perfeito para permitir as mais ricas e emocionantes aventuras que for capaz de imaginar. O Sistema Dharma é um sistema de RPG brasileiro de licença aberta, criado com o objetivo de fornecer parâmetros divertidos, simples e realistas para absolutamente qualquer cenário de roleplaying, como fantasia medieval, horror gótico, steampunk e pós-apocalíptico, anime, mangá e overpower. Este material é o Livro Básico, a porção central daquilo que você precisa para usufruir ao máximo de todos os outros materiais já criados para o Sistema Dharma, e agora está em sua versão revisada e ampliada. Com este livro, você pode criar absolutamente qualquer tipo de personagem com parâmetros de jogo equilibrados dentro do Sistema Dharma. E com ele você terá todas as ferramentas para turbinar os seus jogos de RPG com todos os materiais do Sistema Dharma já publicados, incluindo os diversos livros distribuídos gratuitamente pela internet.', 'Sistema Dharma: Livro Básico - Edição Revisada E Ampliada', NULL, NULL, '455', 'pt-BR', NULL, 'Games & Activities');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1251', '1', '1', 'Válter Kenji Ishida', '2025-11-04 02:24:32.594157', '2025-11-05 02:24:32.594157', '0', 'RUIM', '["https://books.google.com/books/content?id=uoq1EAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9786559594290', '202.99', NULL, NULL, 'A obra faz um estudo de doutrinário da matéria Processual Penal. Traz o conteúdo completo do código de Processo Penal e da Lei de Execução Penal.', 'Processo Penal - 10ª edição', NULL, NULL, '141', 'pt-BR', NULL, 'Antiques & Collectibles');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1252', '1', '1', 'Válter Kenji Ishida', '2025-12-20 02:24:32.594157', '2025-12-25 02:24:32.594157', '0', 'OTIMO', '["https://books.google.com/books/content?id=Dlj8EAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9786559597468', '175.87', NULL, NULL, 'A obra faz um estudo doutrinário e jurisprudencial completo. Realiza profundo estudo sobre o juiz de garantias de acordo com a decisão do STF. Também existe atualização dos entendimentos recentes do STJ e do STF sobre as demais matérias processuais penais.', 'Processo Penal 11 ª EDIÇÃO', NULL, NULL, '47', 'pt-BR', NULL, 'Antiques & Collectibles');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1253', '1', '1', 'Flávio Carneiro', '2025-08-24 02:24:32.594157', '2025-08-27 02:24:32.594157', '0', 'BOM', '["https://books.google.com/books/content?id=AjA2EQplrzkC&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788581222103', '118.65', NULL, NULL, 'Como definir a ficção brasileira produzida no início do século XXI? Quer chamemos a este novo momento de pós-moderno ou pós-utópico (como quis Haroldo de Campos), quer passemos ao largo da controversa tentativa de nomear com segurança uma contemporaneidade essencialmente múltipla e fugidia, é possível notar algumas de suas máscaras. Flávio Carneiro analisa, com rara lucidez, esta fecunda diversidade, num livro que passa a ser uma obra de referência. Do lugar privilegiado que ocupa, sendo ele próprio ficcionista e ao mesmo tempo crítico e professor de literatura, o autor não apenas elabora um mapeamento de nossa ficção atual como também um balanço do que foi a ficção brasileira no século XX – no ensaio introdutório, intitulado "Das vanguardas ao pós-utópico". Desdobramento de uma pesquisa de pós-doutorado e de sua atividade crítica regular em alguns dos principais suplementos literários do país, este novo livro de Flávio Carneiro traz uma coletânea de resenhas de obras de ficção brasile', 'No país do presente', NULL, NULL, '329', 'pt-BR', NULL, 'Literary Criticism');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1254', '1', '1', 'Jeffery Deaver', '2025-09-28 02:24:32.594157', '2025-09-29 02:24:32.594157', '0', 'BOM', '["https://books.google.com/books/content?id=lzrFiFmJP1gC&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9781844568888', '146.25', NULL, NULL, 'From the Sunday Times bestselling author of The Goodbye Man, discover Jeffery Deaver''s chilling thriller that inspired the film starring Angelina Jolie and Denzel Washington and is now a major NBC TV series. Their first case, their worst killer . . . New York City has been thrown into chaos by the assaults of the Bone Collector, a serial kidnapper and killer who gives the police a chance to save his victims from death by leaving obscure clues. Baffled, the cops turn to the one man with a chance of solving them - Lincoln Rhyme. Left paralysed by a debilitating accident, ex NYPD cop Rhyme has to dig deep into the only world he has left - his astonishing mind - to have any hope of solving the case. With the help of a young police officer, Amelia Sachs, he starts to close in on the killer. But as he edges closer to the truth, the Bone Collector is closing in on Lincoln Rhyme himself. ''This is a novel that will chill your blood on the warmest day of any summer holiday. Keep looking over you', 'The Bone Collector', NULL, NULL, '380', 'en', NULL, 'Fiction');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1255', '1', '1', 'Robert Galbraith', '2025-07-09 02:24:32.594157', '2025-07-12 02:24:32.594157', '0', 'RUIM', '["https://books.google.com/books/content?id=tonAEAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9786555951950', '260.15', NULL, NULL, 'Quando a frenética e desgrenhada Edie Ledwell aparece no escritório implorando por ajuda, a detetive particular Robin Ellacott não sabe muito bem como lidar com a situação. Cocriadora de um popular desenho animado — O coração de nanquim —, Edie está sendo perseguida virtualmente por uma misteriosa figura que atende pelo pseudônimo Anomia e, em desespero, pede que a detetive descubra a verdadeira identidade de seu stalker. Robin encerra o encontro informando que sua agência não está habilitada a resolver casos desse tipo. Após indicar alguns concorrentes à mulher, Robin não pensa mais no assunto... Isso até, dias depois, ela ler a notícia chocante de que Edie foi assassinada a facadas no cemitério de Highgate, o cenário onde se passa a animação. A partir daí, Robin e seu sócio, Cormoran Strike, sentem-se instigados e aceitam sair em busca da identidade de Anomia. Porém, confrontados com uma rede complexa de usuários virtuais anônimos, interesses contraditórios e conflitos familiares que', 'O coração de nanquim', NULL, NULL, '266', 'pt-BR', NULL, 'Fiction');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1256', '1', '1', 'H. R. F. Keating', '2026-05-03 02:24:32.594157', '2026-05-07 02:24:32.594157', '0', 'BOM', '["https://books.google.com/books/content?id=W9nUHAAACAAJ&printsec=frontcover&img=1&zoom=1&source=gbs_api"]', '9780330354028', '350.27', NULL, NULL, 'DCI Phil Benholme has the reputation for being a little soft - but only because he tries to see both sides of every story. And now he is faced with the murder of Professor Unwala, winner of the Nobel Prize in 1945. What does a soft cop do when his teenage son is also his prime suspect?', 'The Soft Detective', NULL, NULL, '244', 'en', NULL, 'Detective and mystery stories');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1257', '1', '1', 'Lisa Gardner', '2025-11-01 02:24:32.594157', '2025-11-05 02:24:32.594157', '0', 'BOM', '["https://books.google.com/books/content?id=cPmUirC5AuMC&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9780553903409', '286.82', NULL, NULL, 'The second installment of the award-winning Detective D. D. Warren series from #1 New York Times bestselling author Lisa Gardner. There''s no use locking the doors. . . . It was the case that nearly killed him. Now a gruesome discovery in an underground chamber is about to resurrect his worst nightmare. And Massachusetts State Police detective Bobby Dodge has only one lead: a young girl who''s been in hiding for as long as she can remember. There''s no use turning on the light. . . . Her childhood was a blur of new cities and assumed identities. But from whom—or what—was Annabelle Granger''s family hiding? To find out, Dodge must team up with former lover and partner D. D. Warren from the Boston P.D. to track a woman from Bobby''s past who''s every bit as dangerous as the new killer. The trail will lead them to a chilling place where there''s no one to trust . . . and no place left to hide. The killer knows where to find you.', 'Hide', NULL, NULL, '337', 'en', NULL, 'Fiction');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1258', '1', '1', 'Bruno Ribeiro de Lima', '2025-07-15 02:24:32.594157', '2025-07-16 02:24:32.594157', '0', 'DESGASTADO', '["https://books.google.com/books/content?id=UKDCoAEACAAJ&printsec=frontcover&img=1&zoom=1&source=gbs_api"]', '9781499611304', '79.27', NULL, NULL, 'Uma família conhecida. Uma reunião inesperada. Um assassinato, vários segredos. É no seio de Little Houston e da família Neves que começa a história escrita com maestria por Bruno Ribeiro, tando como mote a introdução do detetive Michael Davids, o primeiro detetive cego dos livros de romance policial. Uma história imperdível para os bons amantes dos livros de mistério.', 'Misterio Em Little Houston', NULL, NULL, '276', 'pt-BR', NULL, 'Fiction');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1259', '1', '1', 'Christopher Fowler', '2025-10-07 02:24:32.594157', '2025-10-12 02:24:32.594157', '0', 'RUIM', '["https://books.google.com/books/content?id=AY5-WygctpYC&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9780553900415', '98.7', NULL, NULL, 'Edgy, suspenseful, and darkly comic, here is the first novel in a riveting mystery series starring two cranky but brilliant old detectives whose lifelong friendship was forged solving crimes for the London Police Department''s Peculiar Crimes Unit. In Full Dark House, Christopher Fowler tells the story of both their first and last case—and how along the way the unlikely pair of crime fighters changed the face of detection. A present-day bombing rips through London and claims the life of eighty-year-old detective Arthur Bryant. For his partner John May, it means the end of a partnership that lasted over half-a-century and an eerie echo back to the Blitz of World War II when they first met. Desperately searching for clues to the killer’s identity, May finds his old friend’s notes of their very first case and becomes convinced that the past has returned . . . with a killing vengeance. It begins when a dancer in a risque new production of Orpheus in Hell is found without her feet. Suddenly,', 'Full Dark House', NULL, NULL, '396', 'en', NULL, 'Fiction');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1260', '1', '1', 'Ericson', '2025-08-07 02:24:32.594157', '2025-08-09 02:24:32.594157', '0', 'NOVO', '[]', '9780409829259', '267.98', NULL, NULL, '', 'Making Crime Soft Oto', NULL, NULL, '430', 'en', NULL, 'Geral');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1261', '1', '1', 'Jack Probyn', '2025-12-25 02:24:32.594157', '2025-12-28 02:24:32.594157', '0', 'DESGASTADO', '["https://books.google.com/books/content?id=iGKvEQAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9781805204022', '63.03', NULL, NULL, 'Quando o nevoeiro se dissipa numa fria manhã de dezembro em Essex, emerge um pesadelo. O corpo de Lily Monteith, de 17 anos, é encontrado num campo, o seu homicídio assustadoramente único—planeado apenas para ela. O Sargento-Detetive Tomek Bowen, a conciliar uma investigação exigente com a vida de pai solteiro, descobre uma ligação perturbadora entre a morte de Lily e uma série de homicídios por resolver de anos atrás. Os homicídios cessaram de repente—mas agora, ao que tudo indica, o predador está de volta. Com o tempo a esgotar-se, Tomek tem de desvendar o passado para travar um assassino que está a aperfeiçoar a sua arte. Porque desta vez, não está apenas a caçar—está a preparar-se para algo muito pior. O CENÁRIO Southend-on-Sea, uma cidade costeira em Essex, esconde um lado mais negro por baixo da sua alegre fachada de estância balnear. O mais longo cais de recreio do mundo estende-se como uma mão esquelética sobre águas turvas, onde a névoa se agarra a séculos de segredos esquecid', 'O Toque do Mal', NULL, NULL, '148', 'pt-BR', NULL, 'Fiction');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1262', '1', '1', 'Margery Allingham', '2026-01-07 02:24:32.594157', '2026-01-08 02:24:32.594157', '0', 'RUIM', '["https://books.google.com/books/content?id=oJHOEQAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9786555118469', '125.54', NULL, NULL, 'A obra-prima de uma das Rainhas do Crime da Era de Ouro da ficção policial em uma edição inédita do Clube do Crime. Em uma Londres pós-Segunda Guerra, onde a neblina encobre segredos e traumas, Meg Elginbrodde, prestes a se casar, vê seu futuro ameaçado quando passa a receber fotografias perturbadoras de seu ex-marido, dado como morto durante a guerra. Ao buscar ajuda do detetive Albert Campion, ela e seu noivo se veem cada vez mais envolvidos em uma teia de mistérios e perigos, enquanto um psicopata conhecido como "Tigre" espalha terror pelas ruas londrinas. Em meio a sequestros, perseguições e assassinatos, Campion mergulha em uma investigação que expõe não apenas a verdade por trás dos eventos, mas também as feridas morais de uma sociedade marcada pela guerra. Um dos maiores clássicos da literatura de mistério, O tigre na neblina é um retrato psicológico brilhante de uma cidade fragilizada, onde o mal pode assumir formas inesperadas e se esconder onde menos se espera.', 'O tigre na neblina (Clube do Crime) – Um clássico da literatura policial para leitores de mistério e thriller', NULL, NULL, '336', 'pt-BR', NULL, 'Fiction');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1263', '1', '1', 'Ian Rankin', '2025-09-13 02:24:32.594157', '2025-09-18 02:24:32.594157', '0', 'RUIM', '["https://books.google.com/books/content?id=0Yx-BAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9781466883635', '100.83', NULL, NULL, 'Knots and Crosses introduces gifted mystery novelist Ian Rankin, a fascinating locale and the most compellingly complex detective hero at work today. Inspector John Rebus: His city is being terrorized by a baffling series of murders...and he''s tied to a maniac by an invisible knot of blood. Once John Rebus served in Britain''s elite SAS. Now he''s an Edinburgh cop who hides from his memories, misses promotions and ignores a series of crank letters. But as the ghoulish killings mount and the tabloid headlines scream, Inspector Rebus cannot stop the feverish shrieks from within his own mind. Because he isn''t just one cop trying to catch a killer, he''s the man who''s got all the pieces to the puzzle....', 'Knots and Crosses', NULL, NULL, '386', 'en', NULL, 'Fiction');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1264', '1', '1', 'Marcelo Felix', '2025-11-15 02:24:32.594157', '2025-11-18 02:24:32.594157', '0', 'OTIMO', '["https://books.google.com/books/content?id=xnlTEAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9786584547001', '240.64', NULL, NULL, 'Uma antologia repleta de crimes, enigmas e desordem, tudo isso banhado pela atmosfera de investigações e mistérios que são características marcantes dos bons e velhos romances policiais. BOA parte da solução desses casos pode vir de detetives renomados, simples curiosos, ou apenas pessoas que estão dispostas a viver uma aventura à la Sherlock Holmes. Os leitores podem esperar ficar com a mente enevoada pelos mistérios que estão nestas páginas, e por fim, se encantar com a magia dos finais bem elaborados e geniais desta LEITURA. Nesta antologia da Lura Editorial, organizada por Marcelo Felix, somos presenteados por autores de todo o Brasil que foram minuciosamente selecionados para a publicação de suas histórias e fizeram um ótimo trabalho no gênero policia', 'O misterioso caso da Royal Street', NULL, NULL, '437', 'pt-BR', NULL, 'Fiction');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1265', '1', '1', 'James Lee Burke', '2025-06-27 02:24:32.594157', '2025-07-02 02:24:32.594157', '0', 'NOVO', '["https://books.google.com/books/content?id=sXkYk_G-aJEC&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9781409124009', '317.61', NULL, NULL, 'The outstanding first book in the ever-popular Dave Robicheaux series. Introducing the New Orleans detective Dave Robicheaux. Johnny Massina, a convicted murderer bound for the electric chair, has warned Dave Robicheaux that he''s on somebody''s hit list, and now the homicide detective is trying to discover just who that is before he ends up dead. Meanwhile he has taken on the murder investigation of a young black girl found dead in the Bayou Swamp - a case no one seems keen for him to investigate. But Robicheaux persists and uncovers a web of corruption that some would kill to protect, leading him to a terrifying confrontation with the one horror he fears most of all. Praise for one of the great American crime writers, James Lee Burke: ''James Lee Burke is the heavyweight champ, a great American novelist whose work, taken individually or as a whole, is unsurpassed.'' Michael Connelly ''A gorgeous prose stylist.'' Stephen King ''Richly deserves to be described now as one of the finest crime w', 'The Neon Rain', NULL, NULL, '70', 'en', NULL, 'Fiction');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1266', '1', '1', 'Edgar Allan Poe', '2025-06-10 02:24:32.594157', '2025-06-13 02:24:32.594157', '0', 'DESGASTADO', '["https://books.google.com/books/content?id=5Tl_EAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9786558940289', '344.78', NULL, NULL, 'Edgar Allan Poe (1809-1849) foi um poeta, escritor, crítico literário e editor norte-americano. Poe foi um extraordinário contista e escreveu memoráveis contos de mistério, terror e policiais, sempre com seu estilo único e pioneiro. Como parte da Coleção Melhores Contos, nesta edição o leitor encontrará Os Crimes na Rua Morgue, conto seminal que inspirou várias sagas de personagens detetives como "Sherlock Holmes" de Arthur Conan Doyle e "Hercule Poirot" de Agatha Cristie. Além deste clássico policial, o leitor encontrará mais dois preciosos contos: O Retrato Oval, um conto curto e instigante e O Caso do Sr. Valdemar, este último, um dos melhores de Allan Poe, que costuma causar profundas sensações de medo e terror nos leitores.', 'OS CRIMES NA RUA MORGUE', NULL, NULL, '416', 'pt-BR', NULL, 'Fiction');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1267', '1', '1', 'Robert Louis Stevenson', '2026-01-05 02:24:32.594157', '2026-01-07 02:24:32.594157', '0', 'DESGASTADO', '["https://books.google.com/books/content?id=imIizgEACAAJ&printsec=frontcover&img=1&zoom=1&source=gbs_api"]', '9798589723052', '288.71', NULL, NULL, 'Adventures of a Corpse é um romance de ação no qual Stevenson usa seus grandes talentos como um contador de histórias de aventura em um tema de detetive que ele lida com os efeitos usuais de clareza e suspense. Trata-se de tema policial porque não se torna romance policial, pois carece de elementos básicos como o crime e o detetive, mas não deixa de ter um cadáver indo de um lugar para outro e um motivo econômico decisivo ligado à morte que forma a base do trabalho. As constantes alusões irônicas a métodos policiais, policiais famosos, detetives imaginários como Robert Skill, nos fariam pensar em uma sátira desse gênero de romance.', 'Aventuras de Um Corpse', NULL, NULL, '317', 'pt-BR', NULL, 'Geral');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1268', '1', '1', 'Rachel Amphlett', '2025-09-21 02:24:32.594157', '2025-09-23 02:24:32.594157', '0', 'DESGASTADO', '["https://books.google.com/books/content?id=MVLv0QEACAAJ&printsec=frontcover&img=1&zoom=1&source=gbs_api"]', '9781917771962', '347.95', NULL, NULL, '"Se você quiser ver sua filha viva novamente, ouça com atenção." Quando o corpo de uma estudante sequestrada é encontrado em um prédio abandonado, o caso é inicialmente tratado como um sequestro que deu errado. Mas a detetive Kay Hunter não está convencida - sobretudo quando um homem é encontrado morto ainda com o dinheiro do resgate em sua posse. Quando uma segunda estudante é sequestrada, os piores temores de Kay se confirmam. Com sua carreira em risco e desesperada para esconder um segredo perturbador, a caçada de Kay ao assassino transforma-se em uma corrida contra o tempo antes que ele faça mais uma vítima. Para o assassino, o jogo está apenas começando... O Medo que Mata é o primeiro livro de uma eletrizante série policial protagonizada pela detetive Kay Hunter, da autora best-seller do USA Today, Rachel Amphlett.', 'O Medo que Mata', NULL, NULL, '331', 'pt-BR', NULL, 'Fiction');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1269', '1', '1', 'Edgar Allan Poe, Nathaniel Hawthorne', '2026-02-01 02:24:32.594157', '2026-02-03 02:24:32.594157', '0', 'NOVO', '["https://books.google.com/books/content?id=v59-EAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9786558940319', '89.04', NULL, NULL, 'Assim em outros volumes da Coleção Melhores Contos, esta antologia reúne histórias dos mais expressivos mestres contistas. Desta vez, abordando O Melhor do Conto Policial. No século XIX, o escritor Edgar Allan Poe criou o personagem August Dupin, um detetive que protagonizava parte de seus contos de mistério, como é o caso de "Os Crimes da Rua Morgue" que está inserido nesta edição. Essas histórias de detetive foram precursoras do que chamamos hoje de Romances ou Contos Policiais. Posteriormente surgiram outros grandes autores como: Conan Doyle, Agatha Christie, Allan Poe Hawthorne... para citar apenas alguns, que, com seu talento e peculiar estilo, diversificaram e tornaram famosos os Conto Policiais que tanto envolvem e agradam os leitores. Neste ebook, o leitor encontrará uma primorosa e inesquecível seleção de contos policiais criados por grandes e renomados escritores.', 'O Melhor do Conto Policial', NULL, NULL, '452', 'pt-BR', NULL, 'Fiction');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1270', '1', '1', 'Hennes Anderson', '2025-10-18 02:24:32.594157', '2025-10-21 02:24:32.594157', '0', 'NOVO', '["https://books.google.com/books/content?id=Ht3G0QEACAAJ&printsec=frontcover&img=1&zoom=1&source=gbs_api"]', '9798275418958', '104.67', NULL, NULL, 'Você já sentiu que estava sendo enganado, mas não conseguia provar? O mundo está cheio de pistas, mas a maioria de nós vive no piloto automático, cega para os detalhes que revelam a verdade. "Guia Definitivo do Detetive Amador" não é um livro sobre ficção policial; é um manual prático de sobrevivência para o mundo real. Escrito com uma linguagem leve, direta e bem-humorada (como uma conversa entre amigos), este livro vai transformar seu cérebro em uma máquina de detectar mentiras, anomalias e perigos. Nestas páginas, você vai aprender a dominar a arte da observação ativa, ler a linguagem corporal que as pessoas tentam esconder e usar a lógica dedutiva para resolver os mistérios do dia a dia - desde descobrir quem riscou seu carro até verificar se aquele negócio "imperdível" é golpe. Com técnicas de investigação digital (OSINT), protocolos de segurança urbana e um guia completo de equipamentos baratos e eficazes, você deixará de ser uma vítima desatenta para se tornar um Cidadão Alerta.', 'Guia Definitivo do Detetive Amador', NULL, NULL, '79', 'pt-BR', NULL, 'Language Arts & Disciplines');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1271', '1', '1', 'Robert Galbraith', '2026-03-25 02:24:32.594157', '2026-03-27 02:24:32.594157', '0', 'BOM', '["https://books.google.com/books/content?id=MH0vEQAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9786555953107', '265.11', NULL, NULL, 'A agência do detetive Cormoran Strike é contratada por um angustiado pai cujo filho, Will, se tornou membro de um culto religioso na zona rural de Norfolk. A Igreja Humanitária Universal é, aparentemente, uma organização pacífica que faz campanha por um mundo melhor. Apesar disso, o detetive descobre que sob tal fachada de humanidade existem camadas profundamente sinistras e mortes inexplicáveis. Na tentativa de resgatar Will, Robin Ellacott, sócia de Strike, decide se infiltrar na seita. Ela viaja sozinha para a Fazenda Chapman, uma das sedes da igreja, com a intenção de viver incógnita entre seus membros. Ao fazer isso, porém, ela se dá conta de que não está preparada para os perigos que a cercam, muito menos para o preço que tal permanência vai cobrar de sua vida. Impossível de largar, O túmulo veloz é o retorno dos detetives Strike e Robin, no épico e inesquecível sétimo volume da série. "Uma ficção policial insuperável." — Sunday Times "Strike e Robin têm o magnetismo de sempre." ', 'O túmulo veloz', NULL, NULL, '339', 'pt-BR', NULL, 'Fiction');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1272', '1', '1', 'Elizabeth George', '2026-04-02 02:24:32.594157', '2026-04-06 02:24:32.594157', '0', 'RUIM', '["https://books.google.com/books/content?id=qSm5AAAACAAJ&printsec=frontcover&img=1&zoom=1&source=gbs_api"]', '9783442054947', '93.77', NULL, NULL, '', 'Undank ist der Väter Lohn', NULL, NULL, '81', 'de', NULL, 'Geral');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1273', '1', '1', 'Marcio Feitosa', '2026-04-19 02:24:32.594157', '2026-04-20 02:24:32.594157', '0', 'RUIM', '["https://books.google.com/books/content?id=GD0uswEACAAJ&printsec=frontcover&img=1&zoom=1&source=gbs_api"]', '9781549787133', '130.98', NULL, NULL, 'Um faxineiro, funcionário de uma empresa, é encontrado morto em uma viela da periferia. Um detetive de um distrito policial sem relevância, é designado para investigar. Nos pertences do faxineiro, uma estranha mensagem codificada leva a investigação a um vultuoso esquema de fraude, envolvendo diversas pessoas dos mais variados escalões, inclusive políticos.', 'O Detetive Zé Maria e o Assassinato Do Faxineiro', NULL, NULL, '92', 'pt-BR', NULL, 'Geral');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1274', '1', '1', 'Agatha Christie', '2025-10-10 02:24:32.594157', '2025-10-12 02:24:32.594157', '0', 'RUIM', '["https://books.google.com/books/content?id=Aix-BwAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788525432438', '889.82', NULL, NULL, 'É por mera educação que o policial aposentado Luke Fitzwilliam dá atenção à simpática e tagarela srta. Pinkerton, que está sentada ao seu lado no trem para Londres. Ela lhe confidencia que está indo à Scotland Yard para denunciar uma série de assassinatos, e ele tem certeza de que ela perdeu o juízo. Mas quando a srta. Pinkerton morre de forma suspeita, Luke decide ir até o vilarejo onde ela residia a fim de investigar – e se depara com algo muito mais assustador do que poderia imaginar. É fácil matar, publicado pela primeira vez em 1939, combina romance e suspense numa trama que é considerada uma das mais surpreendentes já escritas pela Rainha do Crime.', 'É fácil matar', NULL, NULL, '367', 'pt-BR', NULL, 'Fiction');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1275', '1', '1', 'Klaus Hartmann', '2026-01-31 02:24:32.594157', '2026-02-04 02:24:32.594157', '0', 'DESGASTADO', '["https://books.google.com/books/content?id=IlGv0AEACAAJ&printsec=frontcover&img=1&zoom=1&source=gbs_api"]', '9783384172518', '189.61', NULL, NULL, 'Alex Turner e o Black Sun se destacam por vários recursos exclusivos que agregam valor aos leitores: 1. Fusão de Noir e Sobrenatural: Combinar a estética noir clássica com elementos sobrenaturais cria uma atmosfera única que mostra o lado negro de Chicago sob uma luz cativante e misteriosa. O leitor não apenas vivencia os aspectos típicos de um romance policial noir, mas também mergulha em um mundo em que as fronteiras entre a realidade e o sobrenatural são confusas. 2. Personagens complexos: Os personagens principais, especialmente o endurecido detetive particular Alex Turner, a enigmática Jessy e o perspicaz Quantum, são mais do que apenas estereótipos. Sua profundidade, seus pontos fracos e seus pontos fortes dão à história um toque humano que envolve emocionalmente o leitor na trama. 3. Intrigas e conspirações misteriosas: A trama é repleta de intrigas sofisticadas e conspirações misteriosas que levam o leitor a uma emocionante jornada de detetive. Cada reviravolta e revelação ajud', 'Alex Turner e o "Sol Negro"', NULL, NULL, '351', 'pt-BR', NULL, 'Fiction');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1276', '1', '1', 'Rachel Amphlett', '2025-10-31 02:24:32.594157', '2025-11-03 02:24:32.594157', '0', 'NOVO', '["https://books.google.com/books/content?id=CAnu0QEACAAJ&printsec=frontcover&img=1&zoom=1&source=gbs_api"]', '9781917771979', '65.29', NULL, NULL, 'Sua próxima viagem pode ser a última... Quando um trem suburbano lotado atropela um corpo em um trecho da linha conhecido pelos moradores como "Suicide Mile", logo fica claro que o homem foi vítima de um assassinato calculado. À medida que a investigação evolui e um padrão de assassinatos é descoberto, a sargento-detetive Kay Hunter percebe que a recente reputação da ferrovia pode ser obra de um serial killer brutal. Com uma pilha de casos arquivados para investigar e tentando descobrir quem está por trás de uma vingança profissional contra ela, Kay precisa se manter um passo à frente tanto do assassino, quanto de seus próprios adversários. Quando um segundo assassinato ocorre dentro de uma semana após o primeiro, ela percebe que o cronograma do assassino mudou - e que o tempo está se esgotando... Vontade de Viver é o segundo livro de uma empolgante série policial protagonizada pela detetive Kay Hunter, da autora best-seller do USA Today, Rachel Amphlett.', 'Vontade de Viver', NULL, NULL, '99', 'pt-BR', NULL, 'Fiction');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1277', '1', '1', 'N. Sabino', '2026-01-09 02:24:32.594157', '2026-01-13 02:24:32.594157', '0', 'RUIM', '["https://books.google.com/books/content?id=TpKivAEACAAJ&printsec=frontcover&img=1&zoom=1&source=gbs_api"]', '9781723763205', '82.44', NULL, NULL, 'O detetive Turíbio Veiga é investigador policial na cidade de Mira Vento. Enquanto trabalha na delegacia para solucionar crimes acaba se envolvendo em muitos casos sobrenaturais, e crimes inexplicáveis. Teria o detetive Turíbio Veiga conexão com forças ocultas e almas do além? Leia para descobrir!', 'OS Casos Do Detetive Tur', NULL, NULL, '251', 'pt-BR', NULL, 'Fiction');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1278', '1', '1', 'Wolney Hosken', '2026-02-03 02:24:32.594157', '2026-02-04 02:24:32.594157', '0', 'BOM', '["https://books.google.com/books/content?id=ObWm0QEACAAJ&printsec=frontcover&img=1&zoom=1&source=gbs_api"]', '9798270785406', '266.35', NULL, NULL, 'Um romance policial clássico que une mistério, memória e suspense. No auge dos anos 90, enquanto o Rio de Janeiro pulsa entre máscaras e silêncios, o detetive Rafael Montello é chamado para investigar o assassinato de uma rainha de bateria. O que parecia ser um crime passional revela uma teia de contrabando de diamantes, corrupção e segredos enterrados desde os tempos da ditadura. "Diamantes no Carnaval" conduz o leitor por becos históricos, entre a euforia do samba e o peso das verdades escondidas. Um romance policial clássico que une mistério, memória e suspense. Rafael Montello, o protagonista, um detetive das entrelinhas, alguém que não procura aplauso, mas sentido. A jornada dele não é apenas contra o crime, mas contra o esquecimento. Ele investiga um assassinato, sim - mas descobre que, no Brasil das máscaras e dos carnavais, a verdadeira tragédia está nos arquivos apagados, nos nomes trocados e nas promessas enterradas.', 'Diamantes no Carnaval', NULL, NULL, '151', 'pt-BR', NULL, 'Fiction');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1279', '1', '1', 'Tony Bellotto', '2025-09-07 02:24:32.594157', '2025-09-09 02:24:32.594157', '0', 'RUIM', '["https://books.google.com/books/content?id=TvSnBAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788543801261', '136.1', NULL, NULL, 'No aguardado retorno do detetive Remo Bellini, uma trama de sequestros, música sertaneja e césio-137 no coração de Goiânia. O detetive Remo Bellini ficou afastado das páginas, mas não das ruas. Depois de quase dez anos da publicação de Bellini e os espíritos, Tony Bellotto volta à sua criação máxima, o áspero (e ocasionalmente sensível) investigador que é fã de blues, de mulheres e de uma boa dose de ação. O tempo passou, mas Bellini ainda mora sozinho num apartamento na região da avenida Paulista, coração de São Paulo. Algumas manias também permanecem, como almoçar todos os dias no Luar de Agosto, boteco próximo à sua casa. O crime para o qual será atraído, no entanto, não tem nada de comum. Depois de receber um telefonema de Marlon, parte da famosíssima dupla sertaneja Marlon & Brandão, Bellini terá de sair da sua conhecida São Paulo e viajar ao coração de Goiânia, onde se verá embrenhado num universo de música sertaneja, césio-137, intriga e pelo menos uma dama fatal. Contratado par', 'Bellini e o labirinto', NULL, NULL, '310', 'pt-BR', NULL, 'Fiction');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1280', '1', '1', 'Brian Perry', '2026-01-27 02:24:32.594157', '2026-01-31 02:24:32.594157', '0', 'BOM', '["https://books.google.com/books/content?id=2NHS0AEACAAJ&printsec=frontcover&img=1&zoom=1&source=gbs_api"]', '9798332919619', '309.75', NULL, NULL, 'Quem disse que você precisa de um físico imponente e um rosnado feroz para combater o crime? Prepare-se para conhecer o herói mais improvável, mais baixo e mais adorável que a aplicação da lei já viu: o Policial Dachshund. Com seu nariz infalível, sua inteligência aguçada e uma coragem que compensa sua altura, este pequeno investigador de quatro patas embarca em aventuras que o levarão a frustrar conspirações, resolver mistérios e levar à justiça os criminosos mais empedernidos. Da investigação de roubos de salsichas à perseguição disfarçada em competições de cães, o Police Dachshund enfrenta todos os desafios com tenacidade e uma pitada de humor. Suas aventuras vão te fazer rir, te emocionar e prender a respiração até o último latido. Este livro é uma homenagem a todos os dachshunds do mundo, criaturas extraordinárias que demonstram que a grandeza não se mede em centímetros, mas sim no coração e na determinação. É um convite a olhar para além das aparências e descobrir o herói que se ', 'Salchicha detetive', NULL, NULL, '99', 'pt-BR', NULL, 'Young Adult Fiction');
INSERT OR IGNORE INTO livro (id, admin_aprovador_id, aprovado, autor, data_anuncio, data_aprovacao, em_promocao, estado_aprovado, fotos_urls, isbn, preco_aprovado, preco_original, promocao_expira, resumo_oficial, titulo, lote_id, obra_id, vendedor_id, idioma, motivo_rejeicao, genero) VALUES ('1281', '1', '1', 'P. D. James', '2025-11-12 02:24:32.594157', '2025-11-16 02:24:32.594157', '0', 'BOM', '["https://books.google.com/books/content?id=KdrcBAAAQBAJ&printsec=frontcover&img=1&zoom=1&edge=curl&source=gbs_api"]', '9788580865776', '341.76', NULL, NULL, 'Com apenas 22 anos, Cordelia Gray se vê obrigada a assumir sozinha o comando de uma agência de detetives quando seu sócio Bernie Pryde, ex-policial da Scotland Yard, comete suicídio. Cordelia ainda se recupera do impacto da morte do parceiro quando é contratada por um famoso ambientalista para desvendar as circunstâncias da morte de seu filho, enforcado num chalé de Summertrees, onde trabalhava como jardineiro depois de abandonar o curso de história na Universidade de Cambridge. O inquérito concluiu tratar-se de suicídio, mas o pai do rapaz queria saber a razão de gesto tão extremo. Cordelia instala-se em Summertrees, freqüenta o ambiente acadêmico de Cambridge, investiga a conturbada história da família do morto e encontra respostas que contestam as conclusões da polícia. Põe a própria vida em risco para desvendar esse mistério, sem se dar conta de que, ao final, terá de se confrontar com a experiência e a astúcia do inspetor Adam Dalgliesh, o famoso protagonista de outros romances de', 'Trabalho impróprio para uma mulher', NULL, NULL, '19', 'pt-BR', NULL, 'Fiction');

